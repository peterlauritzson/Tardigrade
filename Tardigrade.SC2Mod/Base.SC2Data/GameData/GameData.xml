            <Int Int="12"><Field Id="WorkerCount"/></Int>
            <Int Int="50"><Field Id="Minerals"/></Int>
            <Int Int="0"><Field Id="Vespene"/></Int>
        </Instances>
    </CUser>

    <!-- ════════════════════════════════════════════════════════════════════════  -->
    <!-- DRAFTABLE UNIT POOLS                                                        -->
    <!--   Every combat unit a race can field is here and is fully bannable and      -->
    <!--   pickable. There are no protected "core" units. Workers and supply         -->
    <!--   (SCV/Probe/Drone, Supply Depot/Pylon/Overlord) are never in the pool and  -->
    <!--   are always available.                                                     -->
    <!--   Ravager / Lurker / Brood Lord get a direct larva-build path (AbilData)    -->
    <!--   so they are buildable without their parent. Archon is NOT a pool pick;    -->
    <!--   it is unlocked by drafting either templar (see RosterEnforce.galaxy).     -->
    <!-- ════════════════════════════════════════════════════════════════════════  -->
