<Catalog>
    <CGame id="Dflt">
        <TriggerLibs Id="C9EAC993"/>
        <!-- Test Builds -->
        <!-- <AIBuilds index="213" Enabled="0"/>
             <AIBuilds index="214" Enabled="0"/>
             <AIBuilds index="215" Enabled="1"/> -->

        <!-- The default 180s stalemate test/warning window is measured from
             map init, not from when the game actually starts. Our draft
             (race + modifier + roster, all real time, game paused) plus the
             countdown regularly eats past 180s with zero units/structures on
             the map, which fires the native "this game will be a stalemate"
             warning before anyone has even finished drafting. Push both way
             out so it can never fire during setup. -->
        <StalemateTestTime value="5400"/>
        <StalemateWarningTime value="5400"/>
    </CGame>

    <CUser id="TardigradeRaceStartConfig">
        <Fields Id="TownHall" Type="GameLink" GameLinkType="Unit"/>
        <Fields Id="Worker" Type="GameLink" GameLinkType="Unit"/>
        <Fields Id="ExtraUnit" Type="GameLink" GameLinkType="Unit"/>
        <Fields Id="WorkerCount" Type="Int"/>
        <Fields Id="Minerals" Type="Int"/>
        <Fields Id="Vespene" Type="Int"/>
        
        <Instances Id="Terran">
            <GameLink GameLink="CommandCenter"><Field Id="TownHall"/></GameLink>
            <GameLink GameLink="SCV"><Field Id="Worker"/></GameLink>
            <Int Int="12"><Field Id="WorkerCount"/></Int>
            <Int Int="50"><Field Id="Minerals"/></Int>
            <Int Int="0"><Field Id="Vespene"/></Int>
        </Instances>
        <Instances Id="Protoss">
            <GameLink GameLink="Nexus"><Field Id="TownHall"/></GameLink>
            <GameLink GameLink="Probe"><Field Id="Worker"/></GameLink>
            <Int Int="12"><Field Id="WorkerCount"/></Int>
