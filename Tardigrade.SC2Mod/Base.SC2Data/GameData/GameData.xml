    <!-- Zerg Pool9 uses "SwarmHostMP" - the multiplayer unit id. "SwarmHost" is
         a different (campaign) unit id, so TechTreeUnitAllow(player,"SwarmHost",
         false) in RosterEnforce.galaxy was silently a no-op and the real unit
         stayed buildable even when banned/undrafted. Same fix pattern as
         LurkerMP above. -->

    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <!-- CYCLE CONFIG                                                                -->
    <!--   Timing + lighting for the Day / Dusk / Night phases. The three modifiers -->
    <!--   themselves are drafted at runtime (see CycleMod.galaxy + BehaviorData);   -->
    <!--   this block only controls how long each phase lasts and how it looks.      -->
    <!--   PhaseDuration is in seconds. Set to a small value for testing.            -->
    <!-- ════════════════════════════════════════════════════════════════════════ -->
    <CUser id="TardigradeCycleConfig">
        <Fields Id="PhaseDuration" Type="Fixed"/>
        <Fields Id="TransitionDuration" Type="Fixed"/>
        <Fields Id="LightDay" Type="GameLink" GameLinkType="Light"/>
        <Fields Id="LightDusk" Type="GameLink" GameLinkType="Light"/>
        <Fields Id="LightNight" Type="GameLink" GameLinkType="Light"/>
        <Fields Id="IconDay" Type="String"/>
        <Fields Id="IconDusk" Type="String"/>
        <Fields Id="IconNight" Type="String"/>

        <Instances Id="Default">
            <Fixed Fixed="45.0"><Field Id="PhaseDuration"/></Fixed>
            <Fixed Fixed="2.0"><Field Id="TransitionDuration"/></Fixed>
            <GameLink GameLink="MarSaraDayTest"><Field Id="LightDay"/></GameLink>
            <GameLink GameLink="BelShirSunset"><Field Id="LightDusk"/></GameLink>
            <GameLink GameLink="MarSaraNightTest"><Field Id="LightNight"/></GameLink>
            <String String="Assets\Textures\UI_Battlenet_Glue_MiniButton_Green_NormalPressed.dds"><Field Id="IconDay"/></String>
            <String String="Assets\Textures\UI_Battlenet_Glue_MiniButton_Orange_NormalPressed.dds"><Field Id="IconDusk"/></String>
            <String String="Assets\Textures\UI_Battlenet_Glue_MiniButton_Blue_NormalPressed.dds"><Field Id="IconNight"/></String>
        </Instances>
