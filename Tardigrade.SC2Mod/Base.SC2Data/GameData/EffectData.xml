<?xml version="1.0" encoding="utf-8"?>
<Catalog>
	<!-- Battle Blink: a short-range teleport, same parameters as the Stalker's
	     Blink (8 range), kept as a separate id so it doesn't share the
	     Stalker's own cooldown or its Blink-tech requirement.

	     No ability wraps it any more. CycleMod_TryBattleBlink creates this
	     effect directly with UnitCreateEffectPoint when a unit drops to 30%
	     life, aimed away from whatever last hit it, and the cooldown is the
	     TardigradeMod_BlinkCooldown behavior. TargetLocation is still
	     TargetPoint - the script supplies that point. -->
	<CEffectTeleport id="TardigradeAbil_Blink">
		<ClearQueuedOrders value="0"/>
		<PlacementAround Value="CasterUnit"/>
		<PlacementRange value="8"/>
		<Range value="8"/>
		<WhichUnit Value="Caster"/>
		<TargetLocation Value="TargetPoint"/>
		<TeleportFlags index="TestCliff" value="1"/>
	</CEffectTeleport>

	<!-- Overwatch's +50%, dealt by CycleMod_OnUnitDamaged via UnitDamage() with
	     the bonus passed as the amount. Amount is 0 so the whole payload comes
	     from that argument, and ArmorReduction is 0 because the trigger already
	     works from EventUnitDamageAmount() - the damage that actually landed,
	     after armor - so mitigating it a second time would undercount the bonus.
	     Kind Splash keeps it out of Ranged-only damage responses (Guardian
	     Shield and friends) that already took their cut out of the original hit.
	     Kill credit deliberately left on: the bonus is part of the attacker's
	     shot, so a kill it lands should read as the attacker's kill. -->
	<CEffectDamage id="TardigradeMod_OverwatchBonus">
		<Amount value="0"/>
		<Kind value="Splash"/>
		<KindSplash value="Splash"/>
		<ArmorReduction value="0"/>
		<Flags index="NoDamageTimerReset" value="1"/>
	</CEffectDamage>

	<!-- Shared Damage: one unit's share of a split hit, dealt by
	     CycleMod_OnSharedDamageAbsorbed to the victim and each partner in the
	     original attacker's name. Same shape as the Overwatch bonus: Amount 0
	     so the payload is UnitDamage's argument, ArmorReduction 0 because the
	     script already took the victim's armor off the whole hit. Kind Spell
	     keeps it out of weapon-kind responses (Guardian Shield) that already
	     had their chance at the original hit. TardigradeMod_SharedDamage lists
	     this effect in its ExcludeEffectArray - that exclusion is the only
	     thing stopping a share from being absorbed and split again.
	     The damage timer is left to reset, unlike the Overwatch bonus: every
	     partner really is taking damage, so its shields stop regenerating. -->
	<CEffectDamage id="TardigradeMod_SharedDamageHit">
		<Amount value="0"/>
		<Kind value="Spell"/>
		<ArmorReduction value="0"/>
	</CEffectDamage>

	<!-- Open Skies splash on the other plane, dealt by CycleMod_OnOpenSkiesSplash
	     for the Siege Tank, Ultralisk, Baneling, Planetary Fortress and
	     Liberator AA. The script passes the full amount (ring fraction and
	     cross-plane penalty already applied), so Amount stays 0. Splash kind
	     and normal armor, like the hit it stands in for. The VsAir / VsGround
	     penalty buffs exclude it: the script has already halved it. -->
	<CEffectDamage id="TardigradeMod_OpenSkiesSplash">
		<Amount value="0"/>
		<Kind value="Splash"/>
		<KindSplash value="Splash"/>
	</CEffectDamage>

	<!-- ==================================================================
	     OPEN SKIES, THE DATA HALF - see the header in ValidatorData.xml.
	     Searches lose their Ground token for everyone; the damage effect
	     each victim runs gets TardigradeVal_GroundOrOpenSkies, which puts
	     "ground only" back for any player without Open Skies. The
	     ValidatorArray entries are unindexed, so they are appended to
	     Blizzard's list rather than replacing any of it.
	=================================================================== -->
	<CEffectEnumArea id="LurkerMPSearch"> <!-- Lurker spines -->
		<SearchFilters value="-;Player,Ally,Missile,Stasis,Dead,Hidden,Invulnerable"/>
	</CEffectEnumArea>
	<CEffectEnumArea id="ThermalLancesE"> <!-- Colossus beam -->
		<SearchFilters value="-;Player,Ally,Missile,Stasis,Dead,Hidden,Invulnerable"/>
	</CEffectEnumArea>
	<CEffectEnumArea id="ThermalLancesEReverse"> <!-- Colossus beam -->
		<SearchFilters value="-;Player,Ally,Missile,Stasis,Dead,Hidden,Invulnerable"/>
	</CEffectEnumArea>
	<CEffectEnumArea id="InfernalFlameThrowerE"> <!-- Hellion flame line -->
		<SearchFilters value="-;Player,Ally,Missile,Stasis,Dead,Hidden,Invulnerable"/>
	</CEffectEnumArea>
	<CEffectEnumArea id="HellionTankSearch"> <!-- Hellbat flame cone -->
		<SearchFilters value="-;Self,Player,Ally,Missile,Dead,Hidden,Invulnerable"/>
	</CEffectEnumArea>
	<CEffectDamage id="LurkerMPDamage"> <!-- Lurker -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="ThermalLancesMU"> <!-- Colossus -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="ThermalLancesFriendlyDamage"> <!-- Colossus friendly fire -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="ThermalLancesFriendlyDamageAir"> <!-- Colossus friendly fire -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="PsiBlades"> <!-- Zealot -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="Talons"> <!-- Queen -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="TalonsMissileDamage"> <!-- Queen -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="P38ScytheGuassPistol"> <!-- Reaper -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="ThorsHammerDamage"> <!-- Thor -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="InfernalFlameThrower"> <!-- Hellion -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="HellionTankDamage"> <!-- Hellbat -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="BroodlingEscortDamageUnit"> <!-- Brood Lord -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="BroodlingEscortDamage"> <!-- Brood Lord -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="VolatileBurstDirectFallbackEnemyNeutralUnit"> <!-- Baneling direct hit -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>
	<CEffectDamage id="VolatileBurstDirectFallbackEnemyNeutralBuilding"> <!-- Baneling direct hit -->
		<ValidatorArray value="TardigradeVal_GroundOrOpenSkies"/>
	</CEffectDamage>

	<!-- ==================================================================
	     OPEN SKIES: THE BANELING'S AIR SPLASH, IN DATA.
	     The other AreaArray splashers get their other-plane splash from
	     CycleMod_OnOpenSkiesSplash, but that trigger runs after the effect
	     tree, and by then the Baneling has run Suicide: UnitDamage with a
	     dead (null) source deals nothing, so the Baneling never splashed air.
	     Instead the blast itself now searches air, per victim, while the
	     Baneling is still alive: VolatileBurst gets this search at index 5,
	     where voidmulti had Suicide, and Suicide is appended after it.
	     Gated once on the Baneling's owner holding Open Skies. The half-damage
	     cross-plane cut comes from TardigradeMod_OpenSkiesVsAir on the
	     Baneling, as for every other data-half weapon.
	=================================================================== -->
	<CEffectSet id="VolatileBurst">
		<EffectArray index="5" value="TardigradeOS_BanelingAirSearch"/>
		<EffectArray value="Suicide"/>
	</CEffectSet>
	<CEffectEnumArea id="TardigradeOS_BanelingAirSearch">
		<ValidatorArray value="TardigradeVal_OpenSkies"/>
		<ImpactLocation Value="CasterUnit"/>
		<SearchFilters value="Air;Self,Player,Ally,Missile,Stasis,Dead,Hidden,Invulnerable"/>
		<AreaArray Radius="2.2" Effect="TardigradeOS_BanelingAirSwitch"/>
	</CEffectEnumArea>
	<!-- Lifted Terran buildings take the structure payload, like VolatileBurstU2. -->
	<CEffectSwitch id="TardigradeOS_BanelingAirSwitch">
		<CaseArray Validator="IsStructure" Effect="TardigradeOS_BanelingAirBuildingDamage"/>
		<CaseDefault value="TardigradeOS_BanelingAirUnitDamage"/>
	</CEffectSwitch>
	<!-- Single-target copies of the two payloads, shaped like Blizzard's
	     VolatileBurstFriendly* children: area and search stripped, hit where
	     the victim stands. Melee upgrades are added in UpgradeData.xml. -->
	<CEffectDamage id="TardigradeOS_BanelingAirUnitDamage" parent="VolatileBurstU">
		<AreaArray index="0" removed="1"/>
		<ExcludeArray index="0" removed="1"/>
		<ImpactLocation Value="TargetUnit"/>
		<SearchFilters value="-;-"/>
		<SearchFlags index="OffsetByUnitRadius" value="0"/>
		<SearchFlags index="SameCliff" value="0"/>
	</CEffectDamage>
	<CEffectDamage id="TardigradeOS_BanelingAirBuildingDamage" parent="VolatileBurstU2">
		<AreaArray index="0" removed="1"/>
		<ExcludeArray index="0" removed="1"/>
		<ImpactLocation Value="TargetUnit"/>
		<SearchFilters value="-;-"/>
		<SearchFlags index="OffsetByUnitRadius" value="0"/>
		<SearchFlags index="SameCliff" value="0"/>
	</CEffectDamage>
</Catalog>
