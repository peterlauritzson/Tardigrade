<?xml version="1.0" encoding="utf-8"?>
<Catalog>

    <!-- =====================================================================
         TARDIGRADE: GLOBAL CYCLE MODIFIERS
         Ten global battlefield modifiers. Three are drafted before the match
         (Player A picks one, Player B picks one, the third is random) and then
         rotate as the Day / Dusk / Night phases.

         The active phase's buff is applied to EVERY unit on the map (both
         teams) by CycleMod.galaxy's scan loop, which re-applies every couple
         of seconds and removes the other two chosen buffs on phase change.

         Duration is long (8s) so the buff never lapses between scans; the
         scan actively swaps buffs the instant a phase changes.
    ===================================================================== -->

    <!-- 1: Fleet-Footed  -  +50% move speed -->
    <CBehaviorBuff id="TardigradeMod_FleetFooted">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <Modification MoveSpeedMultiplier="1.5"/>
    </CBehaviorBuff>

    <!-- 2: Adrenal Frenzy  -  +30% attack speed -->
    <CBehaviorBuff id="TardigradeMod_AdrenalFrenzy">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <Modification AttackSpeedMultiplier="1.3"/>
    </CBehaviorBuff>

    <!-- 3: Extended Optics  -  +2 weapon range -->
    <CBehaviorBuff id="TardigradeMod_ExtendedOptics">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <Modification WeaponRange="2" WeaponScanBonus="2"/>
    </CBehaviorBuff>

    <!-- 4: Ironhide  -  +3 life and shield armor -->
    <CBehaviorBuff id="TardigradeMod_Ironhide">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <Modification ShieldArmorBonus="3">
            <LifeArmorBonus value="3"/>
        </Modification>
    </CBehaviorBuff>

    <!-- 5: Juggernaut  -  +50 maximum life -->
    <CBehaviorBuff id="TardigradeMod_Juggernaut">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <Modification>
            <VitalMaxArray index="Life" value="50"/>
        </Modification>
    </CBehaviorBuff>

    <!-- 6: Rapid Regeneration  -  +5 life per second -->
    <CBehaviorBuff id="TardigradeMod_RapidRegen">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <Modification>
            <VitalRegenArray index="Life" value="5"/>
        </Modification>
    </CBehaviorBuff>

    <!-- 7: Overcharged Munitions  -  +20% weapon damage -->
    <CBehaviorBuff id="TardigradeMod_Overcharged">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <Modification>
            <DamageDealtFraction index="Melee" value="0.2"/>
            <DamageDealtFraction index="Ranged" value="0.2"/>
            <DamageDealtFraction index="Splash" value="0.2"/>
        </Modification>
    </CBehaviorBuff>

    <!-- 8: Blitz Doctrine  -  +25% move speed, +15% attack speed -->
    <CBehaviorBuff id="TardigradeMod_Blitz">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <Modification MoveSpeedMultiplier="1.25" AttackSpeedMultiplier="1.15"/>
    </CBehaviorBuff>

    <!-- 9: Siege Protocol  -  +1 weapon range, +15% weapon damage -->
    <CBehaviorBuff id="TardigradeMod_SiegeProtocol">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <Modification WeaponRange="1" WeaponScanBonus="1">
            <DamageDealtFraction index="Melee" value="0.15"/>
            <DamageDealtFraction index="Ranged" value="0.15"/>
            <DamageDealtFraction index="Splash" value="0.15"/>
        </Modification>
    </CBehaviorBuff>

    <!-- 10: Bulwark  -  +2 armor, +30 maximum life -->
    <CBehaviorBuff id="TardigradeMod_Bulwark">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <Modification ShieldArmorBonus="2">
            <LifeArmorBonus value="2"/>
            <VitalMaxArray index="Life" value="30"/>
        </Modification>
    </CBehaviorBuff>

    <!-- Active draft pool. Root behaviors are refreshed by CycleMod's scan loop. -->
    <CBehaviorBuff id="TardigradeMod_OpenSkies">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>

    <!-- Open Skies cross-plane penalty: a unit hits the plane it could never
         reach before at half damage (a Zealot vs air, a Phoenix vs ground).
         CycleMod_ApplyPickedBehavior gives an Open Skies side's units one of
         these, by what their weapons could originally reach: ground-only
         armed units get VsAir, air-only ones VsGround, and units that already
         covered both planes (or have no weapon) get neither.

         Location="Attacker" makes the response act on damage this unit DEALS,
         before it lands (Blizzard uses it for Charge and the Cloaking Drone),
         so it is exact even on a killing blow. TargetFilters is read against
         the other party - Blizzard's FlyerShield puts "Ground;-" on a buff for
         air units to cap damage from ground attackers - so here it names the
         victim's plane.

         Spell kind is left out: an ability is not the weapon Open Skies
         opened up, and Corrosive Bile or a Storm always could hit both
         planes. The Overwatch bonus is excluded because it is computed from
         the damage that already landed, i.e. already halved. -->
    <CBehaviorBuff id="TardigradeMod_OpenSkiesVsAir">
        <InfoFlags index="Hidden" value="1"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <DamageResponse Location="Attacker" ModifyFraction="0.5">
            <Chance value="1"/>
            <TargetFilters value="Air;-"/>
            <Kind index="Spell" value="0"/>
            <ExcludeEffectArray value="TardigradeMod_OverwatchBonus"/>
        </DamageResponse>
    </CBehaviorBuff>
    <CBehaviorBuff id="TardigradeMod_OpenSkiesVsGround">
        <InfoFlags index="Hidden" value="1"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <DamageResponse Location="Attacker" ModifyFraction="0.5">
            <Chance value="1"/>
            <TargetFilters value="Ground;-"/>
            <Kind index="Spell" value="0"/>
            <ExcludeEffectArray value="TardigradeMod_OverwatchBonus"/>
        </DamageResponse>
    </CBehaviorBuff>

    <!-- Forced March (modifier 2, was Medivac Boost). A flat passive now, not
         a clicked burst: the 0.5s scan keeps it on every unit the drafting
         side owns, and CycleMod_ApplyPickedBehavior withholds it while
         TardigradeMod_MarchBroken is up. Duration 8 is the usual
         "never lapse between scan ticks" figure, not a real lifetime.

         1.4: enough to close ground or break away decisively, and affordable
         because it is never on in a fight - the unit is out of contact,
         neither taking damage nor dealing it, whenever it applies. -->
    <CBehaviorBuff id="TardigradeMod_ForcedMarch">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <Modification MoveSpeedMultiplier="1.4"/>
    </CBehaviorBuff>

    <!-- The recovery window. CycleMod_BreakMarch re-adds this on every contact
         - damage taken from anyone, or damage dealt / an attack started - and
         that REFRESHES the duration, so it expires 14 game seconds after the
         LAST contact rather than the first. That expiry is what lets Forced
         March back on, so no timestamp is kept per unit. 14 game seconds is
         10 real seconds on Faster. -->
    <CBehaviorBuff id="TardigradeMod_MarchBroken">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Neutral"/>
        <Duration value="14"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>

    <!-- Marker only - the actual supply exemption is done in script via
         UnitSetState(u, c_unitStateUsingSupply, false) in CycleMod.galaxy.
         A CBehaviorBuff Modification Food=".." field does NOT work for this:
         it only changes the unit's own stat, and the player's supply-used
         total isn't re-derived from that live, only on spawn/death/morph, so
         a buff applied well after the worker already exists has no visible
         effect. UnitSetState's UsingSupply flag is the one thing the engine
         does re-check live. -->
    <CBehaviorBuff id="TardigradeMod_WorkersNoSupply">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>

    <CBehaviorBuff id="TardigradeMod_PredatorProtocol">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>

    <CBehaviorBuff id="TardigradeMod_EyesEverywhere">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <Modification Detect="500" Radar="500" DetectFilters="-;Neutral" RadarFilters="-;Neutral"/>
    </CBehaviorBuff>

    <CBehaviorBuff id="TardigradeMod_Entrenchment">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>
    <!-- Duration is the GRACE PERIOD on losing entrenchment, not how long it
         lasts: CycleMod_UpdateConditionalBehaviors re-adds this every 0.5s
         scan tick for as long as the unit is still holding position, so it
         only actually counts down once the unit has moved off its anchor.
         3s (up from 2) so a brief reposition doesn't strip 2 armor and 1
         range the instant it starts - re-earning it still takes the full
         c_cycleEntrenchDelay. -->
    <CBehaviorBuff id="TardigradeMod_Entrenched">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <!-- Global for the same reason as TardigradeMod_OverwatchFiring: this
             Duration is the grace period you keep the bonus for, so Veteran
             Forces' TimeScale must not shorten it. -->
        <TimeScaleSource Value="Global"/>
        <Duration value="3"/>
        <MaxStackCount value="1"/>
        <Modification WeaponRange="1" WeaponScanBonus="1" ShieldArmorBonus="2">
            <LifeArmorBonus value="2"/>
        </Modification>
    </CBehaviorBuff>

    <!-- Marker only, like TardigradeMod_WorkersNoSupply: the scan still applies
         it so the modifier is visible on the unit, but the mechanic is a per-
         player catalog change (CycleMod_ArcaneSurgeForPlayer doubles CUnit's
         EnergyRegenRate). It used to carry VitalRegenArray Energy="2", a flat
         +2/s - about 3.5x what a standard caster regenerates on its own, and
         the same absolute gift to an Orbital Command as to a Ghost. There is no
         per-vital regen multiplier in SModification to express "2x" here:
         VitalRegenArray is additive and VitalRegenMultiplier is not indexed by
         vital, so it would have doubled shield and life regen as well. -->
    <CBehaviorBuff id="TardigradeMod_ArcaneSurge">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>

    <CBehaviorBuff id="TardigradeMod_Overwatch">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>
    <!-- Damage only, no WeaponRange/WeaponScanBonus. Granting reach for a
         one-second window does not compose with a sustained engagement: the
         unit would acquire and fire at the extended range, then have the range
         stripped when the window closed and be left holding a target it could
         no longer reach - visibly starting attack cycles that abort before the
         weapon fires. Duration is long because the script owns removal (consumed in
         CycleMod_OnUnitDamaged); a short duration made the buff expire and
         instantly re-arm on the next scan tick.

         No Modification block: this is a pure "armed" marker. The +50% used to
         live here as DamageDealtFraction, which only reaches damage the engine
         routes through the source unit's weapon-damage modifiers - so splash,
         suicide (Baneling), and spell damage got nothing, and the Spell index
         was never even set. CycleMod_OnUnitDamaged now deals the bonus itself
         off EventUnitDamageAmount(), which covers every damage event the shot
         produces regardless of kind or effect type. -->
    <CBehaviorBuff id="TardigradeMod_OverwatchReady">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="300"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>
    <!-- The bonus WINDOW. Breaking idle consumes OverwatchReady and swaps in
         this marker; every damage event that lands while it is up gets the
         +50%, so the window - not a single shot - is what the modifier grants.

         Duration 1.4 game seconds = 1 real second on Faster. It was two game
         loops (0.125), just wide enough to hold one volley together, because
         one attack can produce many damage events (splash across N units, a
         Colossus' twin beams) and consuming on the first of them would have
         boosted one target and left the rest of the same blast unbuffed. That
         made the modifier read as a misfire on anything whose damage does not
         arrive in one instant: slow projectiles, multi-hit weapons, a volley
         whose second half lands a few loops late. A one-second window covers
         all of it and is something a player can aim - open on a full army and
         every unit that fires inside that second connects with the bonus.
         Still far shorter than the 14s idle it takes to re-arm. -->
    <CBehaviorBuff id="TardigradeMod_OverwatchFiring">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <!-- Global clock, not the unit's: this Duration is a bonus WINDOW, and
             Veteran Forces' TimeScale would otherwise shorten it - a veteran
             unit getting LESS Overwatch than a fresh one, which is backwards.
             Cooldowns and penalty timers stay on the unit's clock, where running
             down faster is the point; a window you benefit from is not. -->
        <TimeScaleSource Value="Global"/>
        <Duration value="1.4"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>

    <CBehaviorBuff id="TardigradeMod_VeteranForces">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>
    <!-- Veteran Forces, spawned units: the link from an Interceptor to its
         Carrier, a Locust to its Swarm Host, a Broodling to its Brood Lord, an
         Auto-Turret to its Raven. The buff itself does nothing; what matters is
         that CycleMod_OnUnitSpawned applies it with the SPAWNER as the caster,
         so CycleMod_VeteranRoot can read the spawner back out of it with
         UnitBehaviorEffectUnit(.., c_effectLocationCasterUnit, ..). Keeping the
         link on the unit means it is cleaned up with the unit, with no
         bookkeeping to maintain. Permanent (no Duration), one stack. -->
    <CBehaviorBuff id="TardigradeMod_VeteranLink">
        <InfoFlags index="Hidden" value="1"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>

    <!-- Visible on purpose (was Hidden): stacks are per unit and earned
         unevenly, and with no way to see them it was impossible to tell
         whether two units being compared - e.g. two Battlecruisers "attacking
         at different speeds" - even had the same count. The buff bar shows the
         icon with its stack count; name/tooltip are in GameStrings.txt. -->
    <CBehaviorBuff id="TardigradeMod_VeteranStack">
        <InfoIcon value="Assets\Textures\btn-upgrade-zerg-frenzy.dds"/>
        <Alignment value="Positive"/>
        <MaxStackCount value="15"/>
        <!-- "Everything a little faster" is meant literally, so it is TimeScale:
             one field that turns the unit's whole internal clock up. Movement,
             weapon periods, ability and weapon cooldowns, charges, morphs,
             build/queue progress, spawn rates, regen - all of it, including
             timers no individual Modification field reaches.

             DO NOT re-diagnose this from the unit panel. This was briefly spelled
             out stat by stat (MoveSpeedMultiplier / AttackSpeedMultiplier /
             RateMultiplierArray) because a playtest read Battlecruiser attack
             speed as scaling "sometimes, and less than movement". That was
             rounding, not behaviour. The panel prints weapon period in REAL
             seconds at two decimals, and a Battlecruiser's 0.225 game seconds
             shows as 0.16 - where one 3% stack moves the true value by 0.005,
             i.e. half of the last displayed digit:

               stacks  0     1     2     3     4     5     6
               true    .1607 .1560 .1515 .1471 .1428 .1386 .1346
               panel   0.16  0.16  0.15  0.15  0.14  0.14  0.13

             So a 1-stack Battlecruiser shows exactly the same number as a fresh
             one, and the digit only ticks over every second or third stack.
             Movement does not do this: the same unit's speed displays near 1.97,
             where a 3% step is 0.059 - twelve times the last digit, so every
             stack visibly moves it. The two stats were rounded differently, not
             applied differently. Verify by COUNTING SHOTS over ~15 seconds
             (15 stacks should be roughly 93 shots against a fresh one's 60),
             never by reading the panel.

             Two Battlecruiser dead ends, recorded so nobody re-walks them:
             CAbilAttack BattlecruiserAttack's Min/MaxAttackSpeedMultiplier are
             0.25/128 and never bind; and ATS/ATALaserBattery, which do carry a
             shared 0.225 Cost/Cooldown that no Modification field can reach, are
             NOT what the unit fires - in LotV they are EquipmentArray (display)
             entries and the CUnit's WeaponArray holds exactly one weapon, the
             Hidden BattlecruiserWeaponSwitch, Period 0.225 with no Cost at all.

             The one real cost of TimeScale is that it speeds up the unit's own
             buff DURATIONS, and a timed life is a buff. Handled by keeping this
             version off spawned units entirely - see
             TardigradeMod_VeteranStackChild - and by pinning the two of our own
             buffs whose Duration is a bonus window (TardigradeMod_OverwatchFiring,
             TardigradeMod_Entrenched) to the global clock. Cooldowns and penalty
             timers are deliberately left on the unit's clock, where running down
             faster is the whole point.

             Note that Entrenchment's hold clock and Overwatch's idle clock are
             script timestamps off GameGetMissionTime, not buffs, so a veteran
             does NOT entrench or re-arm faster. That is a limit of where those
             mechanics live, not a decision. -->
        <Modification TimeScale="1.03"/>
    </CBehaviorBuff>

    <!-- The spawned-unit version, applied by CycleMod_SyncVeteranStacks instead
         of the one above. Same +3% per stack, spelled out stat by stat so that
         it carries no TimeScale:
           - MoveSpeedMultiplier / AttackSpeedMultiplier: move and attack.
           - RateMultiplierArray: ability cooldowns, charges, morphs, build and
             queue progress, spawns. Exactly the set Blizzard's own Chrono Boost
             (voidmulti) uses at 1.5. Creep is left out.
           - VitalRegenMultiplier: energy regen. Not indexed by vital, so it
             scales life and shield regen too, which is intended.

         Locusts, Broodlings, Auto-Turrets, Infested Terrans and the Disruptor's
         nova all live on a timed-life buff, and the spawner's TimeScale version
         would run that buff down with everything else - cutting a full-stack
         veteran's children to ~64% of their lifespan. A Swarm Host would have
         earned its Locusts an early death and a Disruptor's nova would expire
         short of where it was aimed. A modifier that reads "your units get
         better" must never do that.

         Children lose nothing real by taking this version: TimeScale's unique
         reach is timers no Modification field covers, and nothing a spawned unit
         does depends on one. Interceptors have no timed life and would have been
         safe either way, but they take this version too - one rule for spawned
         units beats one saved edge case. -->
    <CBehaviorBuff id="TardigradeMod_VeteranStackChild">
        <InfoIcon value="Assets\Textures\btn-upgrade-zerg-frenzy.dds"/>
        <Alignment value="Positive"/>
        <MaxStackCount value="15"/>
        <Modification MoveSpeedMultiplier="1.03" AttackSpeedMultiplier="1.03" VitalRegenMultiplier="1.03">
            <RateMultiplierArray index="Cooldown" value="1.03"/>
            <RateMultiplierArray index="Charge" value="1.03"/>
            <RateMultiplierArray index="Morph" value="1.03"/>
            <RateMultiplierArray index="Progress" value="1.03"/>
            <RateMultiplierArray index="Queueable" value="1.03"/>
            <RateMultiplierArray index="Spawn" value="1.03"/>
        </Modification>
    </CBehaviorBuff>

    <!-- 11-13: markers only. Auto Refineries is run by CycleMod_UpdateAutoRefinery,
         Refund pays out from CycleMod_PayRefund on the unit-died event, and
         No Bans acts on the roster draft before any unit exists - none of them
         is a buff. The scan never applies these in draft mode; they exist so
         legacy phase mode, which adds every chosen behavior id blindly, adds a
         valid one. -->
    <CBehaviorBuff id="TardigradeMod_AutoRefinery">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>
    <CBehaviorBuff id="TardigradeMod_NoBans">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>
    <CBehaviorBuff id="TardigradeMod_Refund">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>
    <!-- 15-17: markers only, same reason as 11-13. Minerals Only and Long Reach
         are per-player catalog changes (CycleMod_CatalogModForPlayer); Yolo
         acts on the roster draft. -->
    <CBehaviorBuff id="TardigradeMod_MineralsOnly">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>
    <CBehaviorBuff id="TardigradeMod_Yolo">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>
    <CBehaviorBuff id="TardigradeMod_LongReach">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>

    <!-- Battle Blink's cooldown. CycleMod_TryBattleBlink adds this the moment
         it teleports a unit and refuses to fire again while it is up, so the
         engine expiring the buff IS the cooldown - there is no timer to keep
         per unit. Duration is in game seconds, so 17 is about 12 real seconds
         on Faster. -->
    <CBehaviorBuff id="TardigradeMod_BlinkCooldown">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Neutral"/>
        <Duration value="17"/>
        <MaxStackCount value="1"/>
    </CBehaviorBuff>


    <!-- 14: Shared Damage. Absorbs every hit whole - the same response as
         Blizzard's DamageTakenNone in core.sc2mod (ModifyFraction 0 multiplies
         the hit to nothing; ModifyMinimumDamage stops the 0.5 floor sneaking
         through) - and CycleMod_OnSharedDamageAbsorbed, fired by the absorb,
         deals the hit back out split across the unit and its neighbours.

         ExcludeEffectArray is what lets damage through:
           - TardigradeMod_SharedDamageHit: the redealt shares themselves. Without
             this every share would be absorbed and split again, forever.
           - TardigradeMod_OverwatchBonus: dealt per share by the damage handler,
             so it is already spread; splitting it again would shrink it.
           - Kill-flag effects: how temporary units expire and how several
             abilities remove units (a Baneling's own Suicide, KillHallucination,
             MULEFate, an Adept shade ending, Bile popping a Force Field,
             salvage). Absorbing one would leave its target alive - or share
             out a "kill" as damage. CycleMod_IsShareExemptType also keeps the
             temporary units from ever carrying this behavior, as a second line.
         Applied by the scan only to the drafting side's CycleMod_CanShareDamage
         units (no structures, hallucinations, summons, larva/eggs/cocoons). -->
    <CBehaviorBuff id="TardigradeMod_SharedDamage">
        <InfoFlags index="Hidden" value="1"/>
        <Alignment value="Positive"/>
        <Duration value="8"/>
        <MaxStackCount value="1"/>
        <DamageResponse ModifyFraction="0" ModifyMinimumDamage="1">
            <Chance value="1"/>
            <ExcludeEffectArray value="TardigradeMod_SharedDamageHit"/>
            <ExcludeEffectArray value="TardigradeMod_OverwatchBonus"/>
            <ExcludeEffectArray value="Suicide"/>
            <ExcludeEffectArray value="SuicideRemove"/>
            <ExcludeEffectArray value="Kill"/>
            <ExcludeEffectArray value="KillRemove"/>
            <ExcludeEffectArray value="KillCaster"/>
            <ExcludeEffectArray value="KillSource"/>
            <ExcludeEffectArray value="KillTargetDeathNormal"/>
            <ExcludeEffectArray value="Sacrifice"/>
            <ExcludeEffectArray value="KillHallucination"/>
            <ExcludeEffectArray value="MULEFate"/>
            <ExcludeEffectArray value="AdeptPhaseShiftKillDummy"/>
            <ExcludeEffectArray value="ParasiticBombKill"/>
            <ExcludeEffectArray value="SalvageDeath"/>
            <ExcludeEffectArray value="RemoveCommandCenterCargo"/>
            <ExcludeEffectArray value="VortexKillForceField"/>
            <ExcludeEffectArray value="RavagerCorrosiveBileForceFieldKill"/>
            <ExcludeEffectArray value="NexusDeathKillMothershipCore"/>
            <ExcludeEffectArray value="ReleaseInterceptorsRemoveBeacon"/>
            <ExcludeEffectArray value="QueenMPSpawnBroodlingsDamage"/>
        </DamageResponse>
    </CBehaviorBuff>

</Catalog>
