<?xml version="1.0" encoding="utf-8"?>
<Catalog>

    <!-- =====================================================================
         TARDIGRADE: DIRECT LARVA-BUILD FOR MORPH UNITS
         Ravager, Lurker, and Brood Lord normally morph from a base unit
         (Roach / Hydralisk / Corruptor). Because those parents are draftable
         (and bannable) in the Unit Draft, a player can end up with the morph
         unit in their roster but not its parent. To keep every drafted unit
         buildable, we add a direct "train from larva" path for each — using
         the standard Zerg Egg and the same tech requirement as the morph.

         These extend the inherited LarvaTrain ability (indices 6/9/14 are
         free in the LotV data). The normal morph-from-parent path still works
         when the parent IS available. Which units a player may actually build
         is gated per-player by RosterEnforce.galaxy (TechTreeUnitAllow).
    ===================================================================== -->
    <CAbilTrain id="LarvaTrain">
        <InfoArray index="Train6" Time="12">
            <Button DefaultButtonFace="Ravager" Requirements="HaveBanelingNest2"/>
            <Unit value="Ravager"/>
        </InfoArray>
        <InfoArray index="Train9" Time="18">
            <Button DefaultButtonFace="LurkerMP" Requirements="HaveLurkerDen"/>
            <Unit value="LurkerMP"/>
        </InfoArray>
        <InfoArray index="Train14" Time="24">
            <Button DefaultButtonFace="BroodLord" Requirements="HaveGreaterSpire"/>
            <Unit value="BroodLord"/>
        </InfoArray>
    </CAbilTrain>

</Catalog>
