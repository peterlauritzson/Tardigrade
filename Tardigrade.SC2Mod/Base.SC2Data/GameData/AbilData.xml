<?xml version="1.0" encoding="utf-8"?>
<Catalog>

    <!-- =====================================================================
         TARDIGRADE: DIRECT LARVA-BUILD FOR MORPH UNITS
         Ravager, Lurker, Brood Lord, and Baneling normally morph from a base
         unit (Roach / Hydralisk / Corruptor / Zergling). Because those parents
         are draftable (and bannable) in the Unit Draft, a player can end up
         with the morph unit in their roster but not its parent. To keep every
         drafted unit buildable, we add a direct "train from larva" path.

         These extend the inherited LarvaTrain ability (indices 6/9/14/16 are
         free in the LotV data). The normal morph-from-parent path still works
         when the parent IS available. Which units a player may actually build
         is gated per-player by RosterEnforce.galaxy (TechTreeUnitAllow).
         Command-card buttons for these live in UnitData.xml (on the Larva).

         NOTE: this file holds NO modifier abilities. Battle Blink, Salvage
         and Medivac Boost were all granted here once and shown per-unit at
         runtime; every one of them is a condition now (CycleMod_TryBattleBlink,
         CycleMod_PayRefund, and Forced March as a plain scan-applied buff), so
         no drafted modifier adds a button, a hotkey or a CardLayouts cell to
         any unit. That removed the whole class of problems this file used to
         carry: fighting vanilla buttons for cells across 52 unit types, Row 3
         not rendering, and a unit that already owned the ability ending up
         with two of them. The TardigradeAbil_Blink TELEPORT EFFECT in
         EffectData.xml is still there and still used - the script creates it
         directly; it was only the ability wrapper that went.

         Keep every comment in this file directly above an element. SC2's
         parser attaches a comment to the element that FOLLOWS it, so a
         trailing comment before </Catalog> warns "m_comment == nullptr".
    ===================================================================== -->
    <CAbilTrain id="LarvaTrain">
        <InfoArray index="Train6" Time="12">
            <Button DefaultButtonFace="Ravager" Requirements="HaveBanelingNest2"/>
            <Unit value="Ravager"/>
        </InfoArray>
        <InfoArray index="Train9" Time="18">
            <Button DefaultButtonFace="LurkerMP" Requirements="HaveLurkerDen"/>
            <Unit value="LurkerMP"/>
        </InfoArray>
        <InfoArray index="Train14" Time="24">
            <Button DefaultButtonFace="BroodLord" Requirements="HaveGreaterSpire"/>
            <Unit value="BroodLord"/>
        </InfoArray>
        <InfoArray index="Train16" Time="14">
            <Button DefaultButtonFace="Baneling" Requirements="HaveBanelingNest"/>
            <Unit value="Baneling"/>
        </InfoArray>
    </CAbilTrain>

    <!-- =====================================================================
         TARDIGRADE: DIRECT ARCHON BUILD
         Archon is its own roster pick. Normally it only exists as a merge of
         two templar, so a roster with Archon but neither templar needs another
         way to make one: Gateway and Warp Gate get it as a train option.
         RosterEnforce_GateArchonFallback disallows it whenever High or Dark
         Templar is drafted - then you merge as usual - so it never competes
         with the normal path, and TechTreeUnitAllow hides it when Archon
         itself is undrafted.

         Train8 is unused on both abilities in every data layer (they run
         Train1-7, with no Train3). Cost comes from the Archon's own
         CostResource, 100/300 - the same as two High Templar - and 4 supply.
         Times are the templar pair's route: a High Templar's build (55
         gateway / 45 warp charge) plus the 12s merge, since one gateway now
         does the work of two. Requires Templar Archives, like High Templar.
    ===================================================================== -->
    <CAbilTrain id="GatewayTrain">
        <InfoArray index="Train8" Time="67">
            <Button DefaultButtonFace="Archon" State="Restricted" Requirements="HaveTemplarArchives"/>
            <Unit value="Archon"/>
        </InfoArray>
    </CAbilTrain>
    <CAbilWarpTrain id="WarpGateTrain">
        <InfoArray index="Train8" Time="16" Unit="Archon">
            <Charge>
                <CountMax value="1"/>
                <CountStart value="1"/>
                <CountUse value="1"/>
                <Link value="WarpGateTrain"/>
                <TimeUse value="57"/>
                <Flags index="EnableChargeTimeQueuing" value="1"/>
            </Charge>
            <Cooldown Link="WarpGateTrain" TimeUse="0"/>
            <Button DefaultButtonFace="Archon" State="Restricted" Requirements="HaveTemplarArchives"/>
        </InfoArray>
    </CAbilWarpTrain>

</Catalog>
