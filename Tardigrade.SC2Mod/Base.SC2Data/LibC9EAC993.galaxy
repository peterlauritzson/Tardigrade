// Triggers
//--------------------------------------------------------------------------------------------------
// Trigger: TardigradeBoot
//--------------------------------------------------------------------------------------------------
bool libC9EAC993_gt_TardigradeBoot_Func (bool testConds, bool runActions) {
    // Automatic Variable Declarations
    // Actions
    if (!runActions) {
        return true;
    }

    Tardigrade_Init();
    return true;
}

//--------------------------------------------------------------------------------------------------
void libC9EAC993_gt_TardigradeBoot_Init () {
    libC9EAC993_gt_TardigradeBoot = TriggerCreate("libC9EAC993_gt_TardigradeBoot_Func");
    TriggerAddEventMapInit(libC9EAC993_gt_TardigradeBoot);
}

void libC9EAC993_InitTriggers () {
    libC9EAC993_gt_TardigradeBoot_Init();
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool libC9EAC993_InitLib_completed = false;

void libC9EAC993_InitLib () {
    if (libC9EAC993_InitLib_completed) {
        return;
    }

    libC9EAC993_InitLib_completed = true;

    libC9EAC993_InitLibraries();
    libC9EAC993_InitCustomScript();
    libC9EAC993_InitTriggers();
}

