//--------------------------------------------------------------------------------------------------
// Cycle Modifier System
//
// Phase 3 of the pre-game draft, plus the in-game Day / Dusk / Night cycle.
//
//   DRAFT: There are 10 global battlefield modifiers. Player A (the race
//   banner) picks one, Player B (the picker) picks a second, and the third is
//   chosen at random from the remaining eight.
//
//   CYCLE: In-game the three chosen modifiers rotate as the Day, Dusk, and
//   Night phases. The active phase's modifier is applied to EVERY unit on the
//   map (both teams). A top-center legend panel lists all three phases with
//   their effects, highlights the one that is active, and counts down to the
//   next phase.
//
// Requires: Debug.galaxy, TriggerLibs/NativeLib
//--------------------------------------------------------------------------------------------------

include "TriggerLibs/NativeLib"
include "scripts/Debug"

// Number of modifiers in the pool and how many are drafted (= number of phases).
const int c_cycleModCount   = 10;
const int c_cyclePhaseCount = 3;

// ── Draft state ──────────────────────────────────────────────────────────────
trigger g_cycle_callback = null;
int     g_cycle_p1;                 // Player A (picks first)
int     g_cycle_p2;                 // Player B (picks second)
int     g_cycle_pickIndex = 0;      // 0 = A picking, 1 = B picking
bool[11] g_cycle_taken;             // [1..10] which mods are already claimed
int[4]  g_cycle_chosen;             // [1..3] chosen mod indices (phase order)

// Draft UI
int    g_cycle_dialog   = c_invalidDialogId;
int    g_cycle_lblTitle = c_invalidDialogControlId;
int    g_cycle_lblSub   = c_invalidDialogControlId;
int[11] g_cycle_btnMod;             // [1..10] modifier buttons
trigger g_cycle_draftTrig = null;

// ── Cycle (in-game) state ───────────────────────────────────────────────────
fixed  g_cycle_phaseDuration;
fixed  g_cycle_transitionDuration;
string[4] g_cycle_lightPhase;       // [1..3] lighting per phase
string[4] g_cycle_iconPhase;        // [1..3] icon per phase
string g_cycle_activeBehavior = ""; // currently applied buff (read by scan loop)
int    g_cycle_curPhase = 0;

// Cycle HUD (top-center legend panel)
int    g_cycle_hud      = c_invalidDialogId;
int    g_cycle_hudTitle = c_invalidDialogControlId;
int[4] g_cycle_hudRow;   // [1..3] one row per phase (Day / Dusk / Night)
trigger g_cycle_damageTrig = null;
trigger g_cycle_deathTrig  = null;

const int c_cycleStateRegistered   = 0;
const int c_cycleStateLastX        = 1;
const int c_cycleStateLastY        = 2;
const int c_cycleStateStillTime    = 3;
const int c_cycleStateAdrenalReady = 4;
const int c_cycleStateWasLow       = 5;
const int c_cycleStateLastAttack   = 6;
const int c_cycleStateEconomicEgg  = 7;
const int c_cycleWeaponLimit       = 2048;
string[2048] g_cycle_weaponEntry;
string[2048] g_cycle_weaponFilter;
int          g_cycle_weaponCount = 0;
bool         g_cycle_openSkiesEnabled = false;
unit[2048]   g_cycle_lastAttacker;
int          g_cycle_registeredCount = 0;

//--------------------------------------------------------------------------------------------------
// Data: modifier behavior link, display name, and effect description.
//--------------------------------------------------------------------------------------------------
string CycleMod_Behavior(int idx) {
    if (idx == 1)  { return "TardigradeMod_OpenSkies"; }
    if (idx == 2)  { return "TardigradeMod_WarEconomy"; }
    if (idx == 3)  { return "TardigradeMod_MutualDestruction"; }
    if (idx == 4)  { return "TardigradeMod_PredatorProtocol"; }
    if (idx == 5)  { return "TardigradeMod_EyesEverywhere"; }
    if (idx == 6)  { return "TardigradeMod_Entrenchment"; }
    if (idx == 7)  { return "TardigradeMod_ArcaneSurge"; }
    if (idx == 8)  { return "TardigradeMod_Overwatch"; }
    if (idx == 9)  { return "TardigradeMod_AdrenalResponse"; }
    if (idx == 10) { return "TardigradeMod_VeteranForces"; }
    return "";
}

string CycleMod_HelperBehavior(int idx) {
    if (idx == 1) { return "TardigradeMod_WarEconomyGather"; }
    if (idx == 2) { return "TardigradeMod_WarEconomyLock"; }
    if (idx == 3) { return "TardigradeMod_Entrenched"; }
    if (idx == 4) { return "TardigradeMod_OverwatchReady"; }
    if (idx == 5) { return "TardigradeMod_AdrenalBoost"; }
    if (idx == 6) { return "TardigradeMod_VeteranStack"; }
    return "";
}

string CycleMod_Name(int idx) {
    if (idx == 1)  { return "Open Skies"; }
    if (idx == 2)  { return "War Economy"; }
    if (idx == 3)  { return "Mutual Destruction"; }
    if (idx == 4)  { return "Predator Protocol"; }
    if (idx == 5)  { return "Eyes Everywhere"; }
    if (idx == 6)  { return "Entrenchment"; }
    if (idx == 7)  { return "Arcane Surge"; }
    if (idx == 8)  { return "Overwatch"; }
    if (idx == 9)  { return "Adrenal Response"; }
    if (idx == 10) { return "Veteran Forces"; }
    return "";
}

string CycleMod_Desc(int idx) {
    if (idx == 1)  { return "all weapons target ground and air"; }
    if (idx == 2)  { return "double gathering; combat production is 95% slower"; }
    if (idx == 3)  { return "combat units explode when slain"; }
    if (idx == 4)  { return "attacks restore 30% of damage dealt"; }
    if (idx == 5)  { return "the battlefield and hidden units are revealed"; }
    if (idx == 6)  { return "stationary units gain +2 armor and +1 range"; }
    if (idx == 7)  { return "+3 energy/sec and +50 max energy"; }
    if (idx == 8)  { return "first attack after 5s gains range and damage"; }
    if (idx == 9)  { return "low life triggers a speed and attack-speed surge"; }
    if (idx == 10) { return "kills grant permanent damage and attack speed"; }
    return "";
}

//==================================================================================================
// DRAFT
//==================================================================================================

//--------------------------------------------------------------------------------------------------
// Read-only spectator view: referees and spectators see every modifier but the
// buttons are disabled, so they can watch the draft without interfering.
//--------------------------------------------------------------------------------------------------
void CycleMod_UpdateAudienceUI() {
    playergroup aud;
    string      btnTxt;
    int         i;
    aud = Tardigrade_Audience();

    DialogControlSetPropertyAsText(g_cycle_lblSub, c_triggerControlPropertyText,
        aud, StringToText("<c val=\"888888\">Spectating  -  a modifier is being chosen...</c>"));

    i = 1;
    while (i <= c_cycleModCount) {
        btnTxt = "<c val=\"FFFFFF\">" + CycleMod_Name(i) + "</c>"
            + "\n<c val=\"7FD0FF\">" + CycleMod_Desc(i) + "</c>";
        DialogControlSetPropertyAsText(g_cycle_btnMod[i], c_triggerControlPropertyText,
            aud, StringToText(btnTxt));
        DialogControlSetVisible(g_cycle_btnMod[i], aud, !g_cycle_taken[i]);
        DialogControlSetEnabled(g_cycle_btnMod[i], aud, false);
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Refresh the draft UI for the active picker and the waiting player.
//--------------------------------------------------------------------------------------------------
void CycleMod_UpdateUI() {
    int         picker;
    int         waiter;
    int         i;
    string      titleText;
    string      btnTxt;
    playergroup pickGroup;
    playergroup waitGroup;

    if (g_cycle_pickIndex == 0) { picker = g_cycle_p1; }
    else                        { picker = g_cycle_p2; }
    pickGroup = PlayerGroupSingle(picker);

    titleText = "<c val=\"FFD700\">CYCLE MODIFIER DRAFT</c>   -   Pick "
        + IntToString(g_cycle_pickIndex + 1) + " of 2";
    if (g_cycle_pickIndex == 0) { titleText = titleText + "      <c val=\"888888\">(the 3rd phase is random)</c>"; }

    DialogControlSetPropertyAsText(g_cycle_lblTitle, c_triggerControlPropertyText,
        Tardigrade_Viewers(), StringToText(titleText));
    DialogControlSetPropertyAsText(g_cycle_lblSub, c_triggerControlPropertyText,
        pickGroup, StringToText("<c val=\"00FF88\">YOUR TURN  -  Choose a battlefield modifier</c>"));

    // Buttons for the active picker: hide already-taken mods.
    i = 1;
    while (i <= c_cycleModCount) {
        btnTxt = "<c val=\"FFFFFF\">" + CycleMod_Name(i) + "</c>"
            + "\n<c val=\"7FD0FF\">" + CycleMod_Desc(i) + "</c>";
        DialogControlSetPropertyAsText(g_cycle_btnMod[i], c_triggerControlPropertyText,
            pickGroup, StringToText(btnTxt));
        DialogControlSetVisible(g_cycle_btnMod[i], pickGroup, !g_cycle_taken[i]);
        i = i + 1;
    }

    // Waiting player (if distinct): hide all buttons, show a wait message.
    if (g_cycle_p1 != g_cycle_p2) {
        if (picker == g_cycle_p1) { waiter = g_cycle_p2; }
        else                      { waiter = g_cycle_p1; }
        waitGroup = PlayerGroupSingle(waiter);

        i = 1;
        while (i <= c_cycleModCount) {
            DialogControlSetVisible(g_cycle_btnMod[i], waitGroup, false);
            i = i + 1;
        }
        DialogControlSetPropertyAsText(g_cycle_lblSub, c_triggerControlPropertyText,
            waitGroup, StringToText("<c val=\"888888\">Opponent is choosing a modifier...</c>"));
    }

    // Read-only spectator view for referees and spectators.
    if (Tardigrade_HasAudience()) {
        CycleMod_UpdateAudienceUI();
    }
}

//--------------------------------------------------------------------------------------------------
// Finish the draft: pick the random third phase, clean up, run the callback.
//--------------------------------------------------------------------------------------------------
void CycleMod_FinishDraft() {
    int remaining;
    int i;

    // Third phase: pick a random still-available modifier.
    remaining = RandomInt(1, c_cycleModCount - 2);
    i = 1;
    while (i <= c_cycleModCount) {
        if (!g_cycle_taken[i]) {
            remaining = remaining - 1;
            if (remaining == 0) {
                g_cycle_chosen[3] = i;
                g_cycle_taken[i]  = true;
                break;
            }
        }
        i = i + 1;
    }

    if (g_cycle_draftTrig != null) {
        TriggerDestroy(g_cycle_draftTrig);
        g_cycle_draftTrig = null;
    }
    if (g_cycle_dialog != c_invalidDialogId) {
        DialogDestroy(g_cycle_dialog);
        g_cycle_dialog = c_invalidDialogId;
    }

    Debug_Log("Cycle Draft: Day=" + CycleMod_Name(g_cycle_chosen[1])
        + " Dusk=" + CycleMod_Name(g_cycle_chosen[2])
        + " Night=" + CycleMod_Name(g_cycle_chosen[3]));

    // Announce the full cycle plan with effects so it stays in the chat log.
    UIDisplayMessage(Tardigrade_Viewers(), c_messageAreaChat, StringToText(
        "<c val=\"FFD54A\">BATTLE CYCLE</c>  <c val=\"AAAAAA\">- these three phases rotate all game:</c>"));
    UIDisplayMessage(Tardigrade_Viewers(), c_messageAreaChat, StringToText(
        "<c val=\"FFE24A\">  Day:</c>   " + CycleMod_Name(g_cycle_chosen[1])
        + "  <c val=\"AAAAAA\">-  " + CycleMod_Desc(g_cycle_chosen[1]) + "</c>"));
    UIDisplayMessage(Tardigrade_Viewers(), c_messageAreaChat, StringToText(
        "<c val=\"FFE24A\">  Dusk:</c>  " + CycleMod_Name(g_cycle_chosen[2])
        + "  <c val=\"AAAAAA\">-  " + CycleMod_Desc(g_cycle_chosen[2]) + "</c>"));
    UIDisplayMessage(Tardigrade_Viewers(), c_messageAreaChat, StringToText(
        "<c val=\"FFE24A\">  Night:</c> " + CycleMod_Name(g_cycle_chosen[3])
        + "  <c val=\"AAAAAA\">-  " + CycleMod_Desc(g_cycle_chosen[3]) + "</c>"));

    if (g_cycle_callback != null) {
        TriggerExecute(g_cycle_callback, false, false);
    }
}

//--------------------------------------------------------------------------------------------------
// Handler: modifier button clicked.
//--------------------------------------------------------------------------------------------------
bool CycleMod_OnClicked(bool testConds, bool runActions) {
    int control;
    int player;
    int picker;
    int idx;
    int i;

    control = EventDialogControl();
    player  = EventPlayer();

    if (g_cycle_pickIndex == 0) { picker = g_cycle_p1; }
    else                        { picker = g_cycle_p2; }
    if (player != picker) { return true; }

    // Which modifier button was clicked?
    idx = 0;
    i = 1;
    while (i <= c_cycleModCount) {
        if (control == g_cycle_btnMod[i]) { idx = i; break; }
        i = i + 1;
    }
    if (idx == 0 || g_cycle_taken[idx]) { return true; }

    g_cycle_taken[idx] = true;
    g_cycle_chosen[g_cycle_pickIndex + 1] = idx;

    UIDisplayMessage(Tardigrade_Viewers(), c_messageAreaChat, StringToText(
        "<c val=\"00FF88\">Picked:</c> " + CycleMod_Name(idx) + "  (" + CycleMod_Desc(idx) + ")"));

    g_cycle_pickIndex = g_cycle_pickIndex + 1;
    if (g_cycle_pickIndex >= 2) {
        CycleMod_FinishDraft();
    } else {
        CycleMod_UpdateUI();
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Public: start the cycle-modifier draft.
//   p1 = Player A (picks first), p2 = Player B (picks second).
//--------------------------------------------------------------------------------------------------
void CycleMod_StartDraft(trigger callback, int p1, int p2) {
    int i;
    int col;
    int row;

    g_cycle_callback  = callback;
    g_cycle_p1        = p1;
    g_cycle_p2        = p2;
    g_cycle_pickIndex = 0;

    i = 1;
    while (i <= c_cycleModCount) { g_cycle_taken[i] = false; i = i + 1; }

    // Dialog: 640 x 420, two columns of five buttons.
    g_cycle_dialog = DialogCreate(640, 420, c_anchorCenter, 0, 0, true);
    DialogSetVisible(g_cycle_dialog, Tardigrade_Viewers(), true);

    g_cycle_lblTitle = DialogControlCreate(g_cycle_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_cycle_lblTitle, Tardigrade_Viewers(), 600, 26);
    DialogControlSetPosition(g_cycle_lblTitle, Tardigrade_Viewers(), c_anchorTop, 0, 12);

    g_cycle_lblSub = DialogControlCreate(g_cycle_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_cycle_lblSub, Tardigrade_Viewers(), 600, 20);
    DialogControlSetPosition(g_cycle_lblSub, Tardigrade_Viewers(), c_anchorTop, 0, 42);

    i = 1;
    while (i <= c_cycleModCount) {
        g_cycle_btnMod[i] = DialogControlCreate(g_cycle_dialog, c_triggerControlTypeButton);
        DialogControlSetSize(g_cycle_btnMod[i], Tardigrade_Viewers(), 280, 56);
        if (i <= 5) { col = -150; row = i - 1; }
        else        { col =  150; row = i - 6; }
        DialogControlSetPosition(g_cycle_btnMod[i], Tardigrade_Viewers(),
            c_anchorTop, col, 80 + row * 64);
        DialogControlSetVisible(g_cycle_btnMod[i], Tardigrade_Viewers(), false);
        i = i + 1;
    }

    g_cycle_draftTrig = TriggerCreate("CycleMod_OnClicked");
    i = 1;
    while (i <= c_cycleModCount) {
        TriggerAddEventDialogControl(g_cycle_draftTrig, c_playerAny,
            g_cycle_btnMod[i], c_triggerControlEventTypeClick);
        i = i + 1;
    }

    CycleMod_UpdateUI();
}

//==================================================================================================
// IN-GAME CYCLE
//==================================================================================================

bool CycleMod_IsCombatUnit(unit candidate) {
    return !UnitTypeTestAttribute(UnitGetType(candidate), c_unitAttributeStructure);
}

bool CycleMod_IsTownHall(unit candidate) {
    string unitType;
    unitType = UnitGetType(candidate);
    return unitType == "CommandCenter" || unitType == "OrbitalCommand"
        || unitType == "PlanetaryFortress" || unitType == "Nexus"
        || unitType == "Hatchery" || unitType == "Lair" || unitType == "Hive";
}

bool CycleMod_IsWorker(unit candidate) {
    string unitType;
    unitType = UnitGetType(candidate);
    return unitType == "SCV" || unitType == "Probe" || unitType == "Drone";
}

bool CycleMod_IsParticipantUnit(unit candidate) {
    int owner;
    owner = UnitGetOwner(candidate);
    return PlayerGroupHasPlayer(g_draft_team1, owner)
        || PlayerGroupHasPlayer(g_draft_team2, owner);
}

bool CycleMod_IsEconomicEgg(unit candidate) {
    order currentOrder;
    if (UnitGetType(candidate) != "Egg") { return false; }
    if (FixedToInt(UnitGetCustomValue(candidate, c_cycleStateEconomicEgg)) != 0) { return true; }
    currentOrder = UnitOrder(candidate, 0);
    if (currentOrder == null) { return false; }
    return OrderGetAbilityCommand(currentOrder) == AbilityCommand("LarvaTrain", 1)
        || OrderGetAbilityCommand(currentOrder) == AbilityCommand("LarvaTrain", 3);
}

bool CycleMod_OnEconomicEggStarted(bool testConds, bool runActions) {
    UnitSetCustomValue(EventUnit(), c_cycleStateEconomicEgg, 1.0);
    return true;
}

void CycleMod_AddHelperBehavior(unit target, int helperIndex) {
    string behaviorId;
    behaviorId = CycleMod_HelperBehavior(helperIndex);
    UnitBehaviorAdd(target, behaviorId, target, 1);
}

// A weapon (or search) can hit both ground and air only when its required
// filter list contains NEITHER "Ground" NOR "Air". Requiring both is impossible
// (no unit is both planes), which silently disables the weapon. Open Skies must
// therefore STRIP the plane tokens from both the required and excluded lists.
string CycleMod_StripPlaneTokens(string list) {
    string result;
    string token;
    string ch;
    int len;
    int start;
    int i;

    result = "";
    len = StringLength(list);
    start = 1;
    i = 1;
    while (i <= len + 1) {
        if (i > len) {
            ch = ",";
        } else {
            ch = StringSub(list, i, i);
        }
        if (ch == ",") {
            token = StringSub(list, start, i - 1);
            if (token != "" && token != "Ground" && token != "Air") {
                if (result == "") {
                    result = token;
                } else {
                    result = result + "," + token;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return result;
}

string CycleMod_OpenSkiesFilters(string filters) {
    int separator;
    string required;
    string excluded;

    separator = StringFind(filters, ";", c_stringCase);
    if (separator < 0) {
        required = filters;
        excluded = "";
    } else {
        required = StringSub(filters, 1, separator - 1);
        excluded = StringSub(filters, separator + 1, StringLength(filters));
    }
    required = CycleMod_StripPlaneTokens(required);
    excluded = CycleMod_StripPlaneTokens(excluded);
    if (required == "") { required = "-"; }
    return required + ";" + excluded;
}

void CycleMod_SetOpenSkies(bool enabled) {
    int catalogCount;
    int i;
    int player;
    string weapon;
    string filters;

    if (enabled == g_cycle_openSkiesEnabled) { return; }
    if (g_cycle_weaponCount == 0) {
        catalogCount = CatalogEntryCount(c_gameCatalogWeapon);
        if (catalogCount > c_cycleWeaponLimit) { catalogCount = c_cycleWeaponLimit; }
        i = 0;
        while (i < catalogCount) {
            weapon = CatalogEntryGet(c_gameCatalogWeapon, i + 1);
            g_cycle_weaponEntry[i] = weapon;
            g_cycle_weaponFilter[i] = CatalogFieldValueGet(
                c_gameCatalogWeapon, weapon, "TargetFilters", 1);
            i = i + 1;
        }
        g_cycle_weaponCount = catalogCount;
    }

    i = 0;
    while (i < g_cycle_weaponCount) {
        weapon = g_cycle_weaponEntry[i];
        if (enabled) {
            filters = CycleMod_OpenSkiesFilters(g_cycle_weaponFilter[i]);
        } else {
            filters = g_cycle_weaponFilter[i];
        }
        player = 1;
        while (player <= 16) {
            CatalogFieldValueSet(c_gameCatalogWeapon, weapon, "TargetFilters", player, filters);
            player = player + 1;
        }
        i = i + 1;
    }
    g_cycle_openSkiesEnabled = enabled;
}

bool CycleMod_OnUnitDamaged(bool testConds, bool runActions) {
    unit  target;
    unit  source;
    int   targetIndex;
    fixed currentLife;
    fixed healing;

    target = EventUnit();
    source = EventUnitDamageSourceUnit();
    if (source == null || !CycleMod_IsCombatUnit(source)) { return true; }

    targetIndex = FixedToInt(UnitGetCustomValue(target, c_cycleStateRegistered));
    if (targetIndex > 0 && targetIndex < c_cycleWeaponLimit) {
        g_cycle_lastAttacker[targetIndex] = source;
    }

    UnitSetCustomValue(source, c_cycleStateLastAttack, GameGetMissionTime());

    if (g_cycle_activeBehavior == "TardigradeMod_PredatorProtocol") {
        currentLife = UnitGetPropertyFixed(source, c_unitPropLife, c_unitPropCurrent);
        healing     = EventUnitDamageAmount() * 0.30;
        UnitSetPropertyFixed(source, c_unitPropLife, currentLife + healing);
    }
    return true;
}

bool CycleMod_OnUnitDied(bool testConds, bool runActions) {
    unit dead;
    unit killer;
    int  deadIndex;

    dead   = EventUnit();
    deadIndex = FixedToInt(UnitGetCustomValue(dead, c_cycleStateRegistered));
    if (deadIndex > 0 && deadIndex < c_cycleWeaponLimit) {
        killer = g_cycle_lastAttacker[deadIndex];
    } else {
        killer = null;
    }
    if (!CycleMod_IsCombatUnit(dead)) { return true; }

    if (g_cycle_activeBehavior == "TardigradeMod_MutualDestruction") {
        UnitCreateEffectPoint(dead, "TardigradeMutualDestructionSearch", UnitGetPosition(dead));
    }
    if (g_cycle_activeBehavior == "TardigradeMod_VeteranForces"
        && killer != null && UnitGetOwner(killer) != UnitGetOwner(dead)) {
        CycleMod_AddHelperBehavior(killer, 6);
    }
    return true;
}

void CycleMod_RegisterUnit(unit u) {
    point pos;
    if (FixedToInt(UnitGetCustomValue(u, c_cycleStateRegistered)) != 0) { return; }
    if (g_cycle_registeredCount + 1 >= c_cycleWeaponLimit) { return; }
    g_cycle_registeredCount = g_cycle_registeredCount + 1;
    UnitSetCustomValue(u, c_cycleStateRegistered, IntToFixed(g_cycle_registeredCount));
    pos = UnitGetPosition(u);
    UnitSetCustomValue(u, c_cycleStateLastX, PointGetX(pos));
    UnitSetCustomValue(u, c_cycleStateLastY, PointGetY(pos));
    UnitSetCustomValue(u, c_cycleStateStillTime, GameGetMissionTime());
    UnitSetCustomValue(u, c_cycleStateAdrenalReady, 0.0);
    UnitSetCustomValue(u, c_cycleStateWasLow, 0.0);
    UnitSetCustomValue(u, c_cycleStateLastAttack, GameGetMissionTime());
}

void CycleMod_UpdateConditionalBehaviors(unit u) {
    point pos;
    fixed now;
    fixed x;
    fixed y;
    fixed currentLife;
    fixed lifeMaximum;
    bool lowLife;

    now = GameGetMissionTime();
    pos = UnitGetPosition(u);
    x = PointGetX(pos);
    y = PointGetY(pos);

    if (g_cycle_activeBehavior == "TardigradeMod_WarEconomy") {
        if (CycleMod_IsWorker(u)) {
            CycleMod_AddHelperBehavior(u, 1);
        } else if ((UnitTypeTestAttribute(UnitGetType(u), c_unitAttributeStructure)
                && !CycleMod_IsTownHall(u))
            || (UnitGetType(u) == "Egg" && !CycleMod_IsEconomicEgg(u))) {
            CycleMod_AddHelperBehavior(u, 2);
        }
    }

    if (g_cycle_activeBehavior == "TardigradeMod_Entrenchment") {
        if (FixedToInt(x * 100.0) != FixedToInt(UnitGetCustomValue(u, c_cycleStateLastX) * 100.0)
            || FixedToInt(y * 100.0) != FixedToInt(UnitGetCustomValue(u, c_cycleStateLastY) * 100.0)) {
            UnitSetCustomValue(u, c_cycleStateLastX, x);
            UnitSetCustomValue(u, c_cycleStateLastY, y);
            UnitSetCustomValue(u, c_cycleStateStillTime, now);
        } else if (FixedToInt(now - UnitGetCustomValue(u, c_cycleStateStillTime)) >= 3) {
            CycleMod_AddHelperBehavior(u, 3);
        }
    } else {
        UnitSetCustomValue(u, c_cycleStateStillTime, now);
    }

    if (g_cycle_activeBehavior == "TardigradeMod_Overwatch"
        && FixedToInt(now - UnitGetCustomValue(u, c_cycleStateLastAttack)) >= 5) {
        CycleMod_AddHelperBehavior(u, 4);
    }

    currentLife = UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent);
    lifeMaximum = UnitGetPropertyFixed(u, c_unitPropLifeMax, c_unitPropCurrent);
    lowLife = lifeMaximum > 0.0 && currentLife <= lifeMaximum * 0.35;
    if (g_cycle_activeBehavior == "TardigradeMod_AdrenalResponse") {
        if (lowLife && FixedToInt(UnitGetCustomValue(u, c_cycleStateWasLow)) == 0
            && now >= UnitGetCustomValue(u, c_cycleStateAdrenalReady)) {
            CycleMod_AddHelperBehavior(u, 5);
            UnitSetCustomValue(u, c_cycleStateAdrenalReady, now + 45.0);
        }
        if (lowLife) { UnitSetCustomValue(u, c_cycleStateWasLow, 1.0); }
        else         { UnitSetCustomValue(u, c_cycleStateWasLow, 0.0); }
    } else {
        UnitSetCustomValue(u, c_cycleStateWasLow, 0.0);
    }
}

//--------------------------------------------------------------------------------------------------
// Load timing / lighting / icons and map them to phases in draft order.
//--------------------------------------------------------------------------------------------------
void CycleMod_LoadConfig() {
    string cfg = "TardigradeCycleConfig";
    string inst = "Default";

    g_cycle_phaseDuration      = UserDataGetFixed(cfg, inst, "PhaseDuration", 1);
    g_cycle_transitionDuration = UserDataGetFixed(cfg, inst, "TransitionDuration", 1);

    g_cycle_lightPhase[1] = UserDataGetGameLink(cfg, inst, "LightDay", 1);
    g_cycle_lightPhase[2] = UserDataGetGameLink(cfg, inst, "LightDusk", 1);
    g_cycle_lightPhase[3] = UserDataGetGameLink(cfg, inst, "LightNight", 1);

    g_cycle_iconPhase[1] = UserDataGetString(cfg, inst, "IconDay", 1);
    g_cycle_iconPhase[2] = UserDataGetString(cfg, inst, "IconDusk", 1);
    g_cycle_iconPhase[3] = UserDataGetString(cfg, inst, "IconNight", 1);
}

//--------------------------------------------------------------------------------------------------
// Build the top-center legend panel: a title/countdown line plus one row per
// phase (Day/Dusk/Night). Placed at the top of the screen so it never overlaps
// the minimap or command card.
//--------------------------------------------------------------------------------------------------
void CycleMod_InitHUD() {
    int p;

    g_cycle_hud = DialogCreate(430, 116, c_anchorTop, 0, 24, false);
    DialogSetVisible(g_cycle_hud, Tardigrade_Viewers(), true);
    DialogSetImageVisible(g_cycle_hud, true);

    g_cycle_hudTitle = DialogControlCreate(g_cycle_hud, c_triggerControlTypeLabel);
    DialogControlSetSize(g_cycle_hudTitle, Tardigrade_Viewers(), 410, 22);
    DialogControlSetPosition(g_cycle_hudTitle, Tardigrade_Viewers(), c_anchorTop, 0, 6);

    p = 1;
    while (p <= c_cyclePhaseCount) {
        g_cycle_hudRow[p] = DialogControlCreate(g_cycle_hud, c_triggerControlTypeLabel);
        DialogControlSetSize(g_cycle_hudRow[p], Tardigrade_Viewers(), 406, 24);
        DialogControlSetPosition(g_cycle_hudRow[p], Tardigrade_Viewers(),
            c_anchorTop, 8, 32 + (p - 1) * 26);
        p = p + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Refresh the legend rows, highlighting the active phase.
//--------------------------------------------------------------------------------------------------
void CycleMod_RenderRows(int activePhase) {
    int    p;
    int    modIdx;
    string tag;
    string clr;
    string mrk;
    string line;

    p = 1;
    while (p <= c_cyclePhaseCount) {
        modIdx = g_cycle_chosen[p];
        if (p == 1)      { tag = "DAY  "; }
        else if (p == 2) { tag = "DUSK "; }
        else             { tag = "NIGHT"; }

        if (p == activePhase) { clr = "FFE24A"; mrk = "> "; }   // bright gold, active
        else                  { clr = "8A9099"; mrk = "  "; }   // muted grey, inactive

        line = "<c val=\"" + clr + "\">" + mrk + tag + "   "
            + CycleMod_Name(modIdx) + "   -   " + CycleMod_Desc(modIdx) + "</c>";
        DialogControlSetPropertyAsText(g_cycle_hudRow[p], c_triggerControlPropertyText,
            Tardigrade_Viewers(), StringToText(line));
        p = p + 1;
    }
}


//--------------------------------------------------------------------------------------------------
// Scan loop: apply the active modifier to every unit, remove the other two.
// Runs continuously; picks up newly created units within one interval.
//--------------------------------------------------------------------------------------------------
bool CycleMod_ScanTrigger(bool testConds, bool runActions) {
    unitgroup ug;
    unit      u;
    int       count;
    int       i;
    int       p;
    string    beh;

    while (true) {
        if (g_cycle_activeBehavior != "") {
            ug = UnitGroup(null, c_playerAny, RegionEntireMap(),
                UnitFilter(0, 0, (1 << c_targetFilterMissile),
                    (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
            count = UnitGroupCount(ug, c_unitCountAll);
            i = 1;
            while (i <= count) {
                u = UnitGroupUnit(ug, i);
                CycleMod_RegisterUnit(u);
                p = 1;
                while (p <= c_cyclePhaseCount) {
                    beh = CycleMod_Behavior(g_cycle_chosen[p]);
                    if (beh == g_cycle_activeBehavior
                        && (beh != "TardigradeMod_EyesEverywhere"
                            || CycleMod_IsParticipantUnit(u))) {
                        UnitBehaviorAdd(u, beh, u, 1);
                    } else {
                        libNtve_gf_SetBehaviorCount(u, beh, u, 0);
                    }
                    p = p + 1;
                }
                CycleMod_UpdateConditionalBehaviors(u);
                i = i + 1;
            }
        }
        Wait(0.5, c_timeGame);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Phase loop: rotate Day -> Dusk -> Night, updating lighting, HUD, and the
// active modifier that the scan loop applies.
//--------------------------------------------------------------------------------------------------
bool CycleMod_PhaseTrigger(bool testConds, bool runActions) {
    int phase;
    int nextPhase;
    int secs;
    int modIdx;

    phase = 1;
    while (true) {
        g_cycle_curPhase        = phase;
        modIdx                  = g_cycle_chosen[phase];
        g_cycle_activeBehavior  = CycleMod_Behavior(modIdx);
        CycleMod_SetOpenSkies(g_cycle_activeBehavior == "TardigradeMod_OpenSkies");

        if (phase >= c_cyclePhaseCount) { nextPhase = 1; }
        else                            { nextPhase = phase + 1; }

        // Lighting
        if (CatalogEntryIsValid(c_gameCatalogLight, g_cycle_lightPhase[phase])) {
            GameSetLighting(g_cycle_lightPhase[phase], g_cycle_transitionDuration);
        }

        // Legend rows (rebuilt once per phase, active phase highlighted)
        CycleMod_RenderRows(phase);

        // Title + countdown (updated every second)
        secs = FixedToInt(g_cycle_phaseDuration);
        while (secs > 0) {
            DialogControlSetPropertyAsText(g_cycle_hudTitle, c_triggerControlPropertyText,
                Tardigrade_Viewers(), StringToText(
                    "<c val=\"FFD54A\">BATTLE CYCLE</c>    <c val=\"AAAAAA\">next phase in</c> <c val=\"FFFFFF\">"
                    + IntToString(secs) + "s</c>"));
            Wait(1.0, c_timeGame);
            secs = secs - 1;
        }

        phase = nextPhase;
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Public: start the in-game cycle (called at game start, after the draft).
//--------------------------------------------------------------------------------------------------
void CycleMod_StartCycle() {
    trigger tScan;
    trigger tPhase;
    trigger tEconomicEgg;

    if (g_cycle_hud != c_invalidDialogId) { return; }

    CycleMod_LoadConfig();
    CycleMod_InitHUD();

    g_cycle_damageTrig = TriggerCreate("CycleMod_OnUnitDamaged");
    g_cycle_deathTrig  = TriggerCreate("CycleMod_OnUnitDied");
    TriggerAddEventUnitDamaged(g_cycle_damageTrig, null,
        c_unitDamageTypeAny, c_unitDamageEither, null);
    TriggerAddEventUnitDied(g_cycle_deathTrig, null);

    tEconomicEgg = TriggerCreate("CycleMod_OnEconomicEggStarted");
    TriggerAddEventUnitAbility(tEconomicEgg, null,
        AbilityCommand("LarvaTrain", 1), c_unitAbilStageExecute, false);
    TriggerAddEventUnitAbility(tEconomicEgg, null,
        AbilityCommand("LarvaTrain", 3), c_unitAbilStageExecute, false);

    tScan = TriggerCreate("CycleMod_ScanTrigger");
    TriggerExecute(tScan, false, false);

    tPhase = TriggerCreate("CycleMod_PhaseTrigger");
    TriggerExecute(tPhase, false, false);
}
