//--------------------------------------------------------------------------------------------------
// YOLO (modifier 16)
//--------------------------------------------------------------------------------------------------
bool RosterDraft_IsYolo(bool isP1) {
    return CycleMod_SideIsYolo(isP1);
}

// A YOLO side's roster size: 7, or 9 with No Bans (nobody bans from a YOLO
// pool, so No Bans pays out in units instead). The modifier draft is over
// before any roster is dealt.
int RosterDraft_YoloSize(bool isP1) {
    if (CycleMod_SideHasModIdx(isP1, c_cycleModNoBans)) {
        return c_rosterYoloSize + c_rosterYoloNoBansBonus;
    }
    return c_rosterYoloSize;
}

// Protect and Ban: the side's roster comes from the points stage
// (ProtectDraft.galaxy), which runs before the pick/ban draft.
bool RosterDraft_IsProtect(bool isP1) {
    return CycleMod_SideIsProtect(isP1);
}

// Exactly one side is YOLO and the other drafts normally: its roster is
// rolled pick by pick alongside the other side's draft. With both YOLO, or
// YOLO against Protect and Ban, there is no draft to pace it by, and it is
// dealt at the start.
bool RosterDraft_YoloGradual() {
    if (RosterDraft_IsYolo(true) && !RosterDraft_IsYolo(false)) {
        return !RosterDraft_IsProtect(false);
    }
    if (RosterDraft_IsYolo(false) && !RosterDraft_IsYolo(true)) {
        return !RosterDraft_IsProtect(true);
    }
    return false;
}

// Rows every roster list shows, so both columns line up: 6, a YOLO roster's
// size (7, or 9 with No Bans), or a Protect and Ban roster's size if larger. The
// Protect stage runs before any roster panel is built, and a YOLO reroll only
// shrinks a roster, so this never grows once a panel exists.
int RosterDraft_Rows() {
    int rows;
    rows = c_rosterRosterSize;
    if (RosterDraft_IsYolo(true)  && RosterDraft_YoloSize(true)  > rows) { rows = RosterDraft_YoloSize(true); }
    if (RosterDraft_IsYolo(false) && RosterDraft_YoloSize(false) > rows) { rows = RosterDraft_YoloSize(false); }
    if (RosterDraft_IsProtect(true)  && g_roster_p1PickCount > rows) { rows = g_roster_p1PickCount; }
    if (RosterDraft_IsProtect(false) && g_roster_p2PickCount > rows) { rows = g_roster_p2PickCount; }
    return rows;
}

// A random slot of this pool that is neither banned nor picked, or 0.
int RosterDraft_RandomOpenSlot(bool poolIsP1, int race) {
    int poolCount;
    int open;
    int n;
    int i;
    bool taken;

    poolCount = GetRosterPoolCount(race);
    open = 0;
    i = 1;
    while (i <= poolCount) {
        if (poolIsP1) { taken = g_roster_p1Banned[i] || g_roster_p1Picked[i]; }
        else          { taken = g_roster_p2Banned[i] || g_roster_p2Picked[i]; }
        if (!taken) { open = open + 1; }
        i = i + 1;
    }
    if (open == 0) { return 0; }

    n = RandomInt(1, open);
    i = 1;
    while (i <= poolCount) {
        if (poolIsP1) { taken = g_roster_p1Banned[i] || g_roster_p1Picked[i]; }
        else          { taken = g_roster_p2Banned[i] || g_roster_p2Picked[i]; }
        if (!taken) {
            n = n - 1;
            if (n == 0) { return i; }
        }
        i = i + 1;
    }
    return 0;
}

// Take pool slot `idx` into a side's roster (marks it picked, so the board
// shows it as that side's).
void RosterDraft_TakeSlot(bool isP1, int race, int idx) {
    string unitType;
    unitType = GetRosterPoolUnit(race, idx);
    if (isP1) {
        g_roster_p1Picked[idx] = true;
        g_roster_p1PickCount   = g_roster_p1PickCount + 1;
        g_roster_p1Units[g_roster_p1PickCount] = unitType;
    } else {
        g_roster_p2Picked[idx] = true;
        g_roster_p2PickCount   = g_roster_p2PickCount + 1;
        g_roster_p2Units[g_roster_p2PickCount] = unitType;
    }
}

// Deal a YOLO side its whole roster: 7 units at random from the race's pool,
// nothing guaranteed. Expects the side's picked flags and pick count to be
// freshly reset. Also used by the debug auto-run, which skips the draft screens.
void RosterDraft_DealRandom(bool isP1, int race, int size) {
    int    i;

    while ((isP1 && g_roster_p1PickCount < size)
        || (!isP1 && g_roster_p2PickCount < size)) {
        i = RosterDraft_RandomOpenSlot(isP1, race);
        if (i == 0) { break; }
        RosterDraft_TakeSlot(isP1, race, i);
    }
}

void RosterDraft_FillYolo(bool isP1, int race) {
    RosterDraft_DealRandom(isP1, race, RosterDraft_YoloSize(isP1));
}

// Units in a side's roster right now.
int RosterDraft_Count(bool isP1) {
    if (isP1) { return g_roster_p1PickCount; }
    return g_roster_p2PickCount;
}

// Summary screen: a YOLO side throws its roster away and is dealt a new one,
// one unit smaller, from its whole pool (the old units can come back). Never
// below one unit. Returns false when there was nothing to do.
bool RosterDraft_RerollYolo(bool isP1) {
    int race;
    int size;
    int i;

    if (!RosterDraft_IsYolo(isP1)) { return false; }
    size = RosterDraft_Count(isP1) - 1;
    if (size < 1) { return false; }

    if (isP1) { race = g_roster_p1Race; } else { race = g_roster_p2Race; }
    i = 1;
    while (i <= c_rosterPoolMax) {
        if (isP1) { g_roster_p1Picked[i] = false; } else { g_roster_p2Picked[i] = false; }
        i = i + 1;
    }
    i = 1;
    while (i <= c_rosterMaxSize) {
        if (isP1) { g_roster_p1Units[i] = ""; } else { g_roster_p2Units[i] = ""; }
        i = i + 1;
    }
    if (isP1) { g_roster_p1PickCount = 0; } else { g_roster_p2PickCount = 0; }

    RosterDraft_DealRandom(isP1, race, size);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Roster Draft: Roster Panel (right side)
// Shows BOTH your roster and the opponent's roster live, so players can
// counter-draft. Each player sees their own picks in green (top) and the
// opponent's picks in orange (below).
//--------------------------------------------------------------------------------------------------
string RosterDraft_SlotText(string unitType, int slotNum, bool isYours) {
    string clr;
    if (isYours) { clr = "00FF88"; } else { clr = "FF9955"; }
    if (unitType != "") {
        return "<c val=\"" + clr + "\">  " + IntToString(slotNum) + ".  "
            + RosterUnitDisplayName(unitType) + "</c>";
    }
    return "<c val=\"333333\">  " + IntToString(slotNum) + ".  —</c>";
}

// One line describing a drafted cycle phase (Day/Dusk/Night) with its effect.
// Uses CycleMod data - the cycle is drafted BEFORE the unit draft. When the
// per-player draft is active it instead lists each side's always-on picks.
string RosterDraft_CyclePhaseText(int phase) {
    string tag;
    int    modIdx;
    if (!c_cyclePhaseMode) {
        if (phase == 1) {
            return "<c val=\"FFE24A\">Always active - each side's picks:</c>";
        }
        if (phase == 2) {
            return "<c val=\"7FD0FF\">P1 (" + RaceName(g_draft_p1Race) + "):</c>   <c val=\"FFFFFF\">"
                + CycleMod_ModNamesJoined(true) + "</c>";
        }
        return "<c val=\"FF9F7F\">P2 (" + RaceName(g_draft_p2Race) + "):</c>   <c val=\"FFFFFF\">"
            + CycleMod_ModNamesJoined(false) + "</c>";
    }
    if (phase == 1)      { tag = "Day  "; }
    else if (phase == 2) { tag = "Dusk "; }
    else                 { tag = "Night"; }
    modIdx = g_cycle_chosen[phase];
    return "<c val=\"FFE24A\">" + tag + "</c>   <c val=\"FFFFFF\">" + CycleMod_Name(modIdx)
        + "</c>   <c val=\"888888\">- " + CycleMod_Desc(modIdx) + "</c>";
}

// One side's modifiers for the left-hand panel: a heading line, then each pick
// as its name over its one-line description. Fixed for the whole screen - the
// modifier draft is over before this one starts.
string RosterDraft_ModBlock(bool isP1, string heading, string clr) {
    string s;
    int    i;
    int    idx;
    int    shown;
    int    race;

    if (isP1) { race = g_roster_p1Race; } else { race = g_roster_p2Race; }
    s = "<c val=\"" + clr + "\">" + heading + "</c>  <c val=\"777777\">" + RaceName(race) + "</c>";
    if (CycleMod_SideIsYolo(isP1)) { s = s + "  <c val=\"FFD700\">YOLO</c>"; }
    if (CycleMod_SideIsProtect(isP1)) { s = s + "  <c val=\"FFD700\">PROTECT</c>"; }

    shown = 0;
    i = 1;
    while (i <= c_cycleModCount) {
        if (isP1) { idx = CycleMod_P1Mod(i); } else { idx = CycleMod_P2Mod(i); }
        if (idx > 0) {
            s = s + "\n\n<c val=\"FFFFFF\">" + CycleMod_Name(idx) + "</c>\n"
                + DraftStyle_Small("<c val=\"8A9AA6\">" + CycleMod_Desc(idx) + "</c>");
            shown = shown + 1;
        }
        i = i + 1;
    }
    if (shown == 0) { s = s + "\n\n<c val=\"555555\">no modifiers</c>"; }
    return s;
}

// The legacy rotating-phase cycle has no per-side picks: one shared list.
string RosterDraft_PhaseBlock() {
    return "<c val=\"555555\">BATTLE CYCLE  (rotates all game)</c>\n\n"
        + RosterDraft_CyclePhaseText(1) + "\n" + RosterDraft_CyclePhaseText(2)
        + "\n" + RosterDraft_CyclePhaseText(3);
}

// The line under a roster naming what was banned from that pool, so a ban
// doesn't vanish from view once the ban phase moves on. When a pool can't be
// banned from at all, it says why instead of showing an empty list.
string RosterDraft_BanText(bool poolIsP1) {
    string s;
    int    race;
    int    i;
    bool   banned;

    if (poolIsP1) { race = g_roster_p1Race; } else { race = g_roster_p2Race; }
    s = "";
    i = 1;
    while (i <= GetRosterPoolCount(race)) {
        if (poolIsP1) { banned = g_roster_p1Banned[i]; } else { banned = g_roster_p2Banned[i]; }
        if (banned) {
            if (s != "") { s = s + "  " + c_draftDot + "  "; }
            s = s + RosterUnitDisplayName(GetRosterPoolUnit(race, i));
        }
        i = i + 1;
    }
    if (s == "") {
        if (RosterDraft_IsYolo(poolIsP1)) {
            s = "none - YOLO";
        } else if (RosterDraft_IsProtect(poolIsP1)) {
            s = "none - Protect and Ban";
        } else if ((poolIsP1 && CycleMod_P1HasModIdx(c_cycleModNoBans))
            || (!poolIsP1 && CycleMod_P2HasModIdx(c_cycleModNoBans))) {
            s = "none - No Bans";
        } else {
            s = "—";
        }
    }
    return DraftStyle_Small("<c val=\"C08888\">" + c_draftGlyphBanned + " BANNED</c>   <c val=\"D9A0A0\">"
        + s + "</c>");
}

void RosterDraft_UpdateRosterPanel() {
    int         i;
    playergroup p1Group;
    playergroup p2Group;
    playergroup aud;
    bool        hasAud;

    p1Group = PlayerGroupSingle(g_roster_p1);
    p2Group = PlayerGroupSingle(g_roster_p2);
    hasAud  = Tardigrade_HasAudience();
    aud     = Tardigrade_Audience();

    i = 1;
    while (i <= RosterDraft_Rows()) {
        // P1's view: own = P1, opponent = P2
        DialogControlSetPropertyAsText(g_roster_lblSlot[i], c_triggerControlPropertyText,
            p1Group, StringToText(RosterDraft_SlotText(g_roster_p1Units[i], i, true)));
        DialogControlSetPropertyAsText(g_roster_lblOppSlot[i], c_triggerControlPropertyText,
            p1Group, StringToText(RosterDraft_SlotText(g_roster_p2Units[i], i, false)));

        // P2's view: own = P2, opponent = P1 (only if a separate player)
        if (g_roster_p1 != g_roster_p2) {
            DialogControlSetPropertyAsText(g_roster_lblSlot[i], c_triggerControlPropertyText,
                p2Group, StringToText(RosterDraft_SlotText(g_roster_p2Units[i], i, true)));
            DialogControlSetPropertyAsText(g_roster_lblOppSlot[i], c_triggerControlPropertyText,
                p2Group, StringToText(RosterDraft_SlotText(g_roster_p1Units[i], i, false)));
        }

        // Spectators / referees: P1 (green, top) + P2 (orange, below).
        if (hasAud) {
            DialogControlSetPropertyAsText(g_roster_lblSlot[i], c_triggerControlPropertyText,
                aud, StringToText(RosterDraft_SlotText(g_roster_p1Units[i], i, true)));
            DialogControlSetPropertyAsText(g_roster_lblOppSlot[i], c_triggerControlPropertyText,
                aud, StringToText(RosterDraft_SlotText(g_roster_p2Units[i], i, false)));
        }
        i = i + 1;
    }

    // Banned lines, same viewer split as the slots above.
    DialogControlSetPropertyAsText(g_roster_lblBan, c_triggerControlPropertyText,
        p1Group, StringToText(RosterDraft_BanText(true)));
    DialogControlSetPropertyAsText(g_roster_lblOppBan, c_triggerControlPropertyText,
        p1Group, StringToText(RosterDraft_BanText(false)));
    if (g_roster_p1 != g_roster_p2) {
        DialogControlSetPropertyAsText(g_roster_lblBan, c_triggerControlPropertyText,
            p2Group, StringToText(RosterDraft_BanText(false)));
        DialogControlSetPropertyAsText(g_roster_lblOppBan, c_triggerControlPropertyText,
            p2Group, StringToText(RosterDraft_BanText(true)));
    }
    if (hasAud) {
        DialogControlSetPropertyAsText(g_roster_lblBan, c_triggerControlPropertyText,
            aud, StringToText(RosterDraft_BanText(true)));
        DialogControlSetPropertyAsText(g_roster_lblOppBan, c_triggerControlPropertyText,
            aud, StringToText(RosterDraft_BanText(false)));
    }
}

//--------------------------------------------------------------------------------------------------
// Roster Draft: pool card states
//
// A pool slot belongs to exactly one player - the pool on screen is one race's,
// and only its owner can pick from it - so the slot's state is read from that
// owner's ban/pick arrays, and only the WORD on the card changes with who is
// looking at it.
//--------------------------------------------------------------------------------------------------
int RosterDraft_SlotState(bool poolIsP1, int idx, bool banPhase) {
    if (poolIsP1) {
        if (g_roster_p1Banned[idx]) { return c_draftStateBanned; }
        if (g_roster_p1Picked[idx]) { return c_draftStateMine; }
    } else {
        if (g_roster_p2Banned[idx]) { return c_draftStateBanned; }
        if (g_roster_p2Picked[idx]) { return c_draftStateMine; }
    }
    if (banPhase) { return c_draftStateBanTarget; }
    return c_draftStateOpen;
}

// RosterDraft_SlotState reports a taken slot as c_draftStateMine because it
// knows the pool, not the viewer. This turns it into the state this particular
// viewer sees, which is also what the view tints and gates the button on.
int RosterDraft_ShownState(int state, bool takenIsMine) {
    if (state == c_draftStateMine && !takenIsMine) { return c_draftStateTheirs; }
    return state;
}

// One pool card as one viewer sees it. tag overrides the word on the chip, for
// spectators, who are on neither side.
string RosterDraft_PoolCard(int state, string tag, string unitType) {
    return DraftStyle_Card(state, tag, RosterUnitDisplayName(unitType), RosterUnitRole(unitType));
}

// The header over the pool column: whose pool it is, which race, and what
// the markers on its dead cards mean.
string RosterDraft_PoolHeader(string whose, int race) {
    return DraftStyle_Small("<c val=\"999999\">" + whose + "</c>"
        + "  <c val=\"555555\">─  " + RaceName(race) + "  ───</c>   "
        + c_draftLegendShort);
}

//--------------------------------------------------------------------------------------------------
// Roster Draft: Update UI
//--------------------------------------------------------------------------------------------------
void RosterDraft_UpdateUI() {
    int         activePicker;
    int         activeRace;
    bool        activeIsP1;
    int         poolCount;
    int         i;
    string      unitType;
    bool        poolIsP1;        // the pool on screen belongs to P1
    bool        activeOwnsPool;  // the active player is picking from their own pool
    string      audienceTag;     // "P1" / "P2" - spectators are on neither side
    string      audienceName;    // the same, spelled out for the pool header
    int         slotState;      // as the pool's owner sees it
    int         shownState;     // the same, turned round for the current viewer
    string      titleText;
    playergroup activeGroup;
    playergroup waitGroup;
    int         waiter;
    bool        hasWaiter;
    int         stepNum;
    int         stepTotal;

    // ── Determine whose turn it is and which pool is shown ───────────────────
    if (g_roster_phase == 1) {
        // BAN PHASE: active player bans from opponent's pool
        stepNum      = g_roster_banIndex + 1;
        stepTotal    = g_roster_banCount;
        activePicker = g_roster_banOrder[stepNum];
        activeIsP1   = g_roster_banIsP1[stepNum];
        // The pool shown is the OPPONENT's pool
        poolIsP1       = !activeIsP1;
        activeOwnsPool = false;
        if (activeIsP1) { activeRace = g_roster_p2Race; }
        else            { activeRace = g_roster_p1Race; }

        titleText = "<c val=\"FF4444\">BAN PHASE</c>"
            + "   —   Ban  " + IntToString(stepNum) + "  of  " + IntToString(stepTotal)
            + "      <c val=\"888888\">(then: final picks)</c>";
    } else {
        // PICK PHASE: active player picks from their own pool (phase 0 = opening, 2 = final)
        stepNum      = g_roster_pickIndex + 1;
        stepTotal    = g_roster_pickCount;
        activePicker = g_roster_pickOrder[stepNum];
        activeIsP1   = g_roster_pickIsP1[stepNum];
        // Picking from your own pool.
        poolIsP1       = activeIsP1;
        activeOwnsPool = true;
        if (activeIsP1) { activeRace = g_roster_p1Race; }
        else            { activeRace = g_roster_p2Race; }

        if (g_roster_phase == 0) {
            titleText = "<c val=\"FFD700\">OPENING PICKS</c>"
                + "   —   Pick  " + IntToString(stepNum) + "  of  " + IntToString(stepTotal)
                + "      <c val=\"888888\">(secure your key units, then bans)</c>";
        } else {
            titleText = "<c val=\"FFD700\">FINAL PICKS</c>"
                + "   —   Pick  " + IntToString(stepNum) + "  of  " + IntToString(stepTotal);
        }
    }

    poolCount   = GetRosterPoolCount(activeRace);
    activeGroup = PlayerGroupSingle(activePicker);

    // ── Title ─────────────────────────────────────────────────────────────────
    DialogControlSetPropertyAsText(g_roster_lblTitle, c_triggerControlPropertyText,
        Tardigrade_Viewers(), StringToText(titleText));

    // ── Subtitle: active player ───────────────────────────────────────────────
    if (g_roster_phase == 1) {
        DialogControlSetPropertyAsText(g_roster_lblSubtitle, c_triggerControlPropertyText,
            activeGroup, StringToText(
                "<c val=\"FF6666\">YOUR TURN  —  Ban a unit from your opponent's roster</c>"));
    } else {
        DialogControlSetPropertyAsText(g_roster_lblSubtitle, c_triggerControlPropertyText,
            activeGroup, StringToText(
                "<c val=\"00FF88\">YOUR TURN  —  Select a unit to add to your roster</c>"));
    }

    // The waiting player sees the same pool the active player is acting on,
    // disabled - during bans that is their own pool, being banned from. It used
    // to be hidden, but a spectator only sees a dialog through the player they
    // are watching (Tardigrade_ObservableDialog), so a blank waiting screen
    // blanked the draft for anyone watching that player.
    hasWaiter = (g_roster_p1 != g_roster_p2);
    if (hasWaiter) {
        if (activeIsP1) { waiter = g_roster_p2; }
        else            { waiter = g_roster_p1; }
        waitGroup = PlayerGroupSingle(waiter);
    }

    // ── Whose pool is on the left ──────────────────────────────────────
    // Worth spelling out now that banned and picked units stay on the board:
    // during bans the pool shown is the OPPONENT's, and a board with units
    // marked THEIRS on it is only readable if you know whose board it is.
    if (poolIsP1) {
        audienceTag  = "P1";
        audienceName = "PLAYER 1 POOL";
    } else {
        audienceTag  = "P2";
        audienceName = "PLAYER 2 POOL";
    }

    if (activeOwnsPool) {
        DialogControlSetPropertyAsText(g_roster_lblPoolHdr, c_triggerControlPropertyText,
            activeGroup, StringToText(RosterDraft_PoolHeader("YOUR POOL", activeRace)));
        if (hasWaiter) {
            DialogControlSetPropertyAsText(g_roster_lblPoolHdr, c_triggerControlPropertyText,
                waitGroup, StringToText(RosterDraft_PoolHeader("OPPONENT'S POOL", activeRace)));
        }
    } else {
        DialogControlSetPropertyAsText(g_roster_lblPoolHdr, c_triggerControlPropertyText,
            activeGroup, StringToText(RosterDraft_PoolHeader("OPPONENT'S POOL", activeRace)));
        if (hasWaiter) {
            DialogControlSetPropertyAsText(g_roster_lblPoolHdr, c_triggerControlPropertyText,
                waitGroup, StringToText(RosterDraft_PoolHeader("YOUR POOL", activeRace)));
        }
    }
    if (Tardigrade_HasAudience()) {
        DialogControlSetPropertyAsText(g_roster_lblPoolHdr, c_triggerControlPropertyText,
            Tardigrade_Audience(),
            StringToText(RosterDraft_PoolHeader(audienceName, activeRace)));
    }

    // ── Pool buttons for the active (and, disabled, the waiting) player ──────
    // Banned and picked units keep their place on the board, marked and
    // switched off. They used to be hidden, which made the grid reflow after
    // every click - units moved under the cursor, and a player could not tell a
    // unit that had been banned from one that was never in the pool.
    i = 1;
    while (i <= c_rosterPoolMax) {
        if (i <= poolCount) {
            unitType = GetRosterPoolUnit(activeRace, i);
            slotState = RosterDraft_SlotState(poolIsP1, i, g_roster_phase == 1);

            shownState = RosterDraft_ShownState(slotState, activeOwnsPool);
            DraftStyle_ApplyCard(g_roster_btnPool[i], activeGroup, shownState,
                RosterDraft_PoolCard(shownState, "", unitType), true);

            if (hasWaiter) {
                // Same board from the other side, so YOURS and THEIRS swap.
                shownState = RosterDraft_ShownState(slotState, !activeOwnsPool);
                DraftStyle_ApplyCard(g_roster_btnPool[i], waitGroup, shownState,
                    RosterDraft_PoolCard(shownState, "", unitType), false);
            }
            // Spectators see the same board, labelled P1 / P2 since they are on
            // neither side, and never clickable.
            if (Tardigrade_HasAudience()) {
                shownState = RosterDraft_ShownState(slotState, poolIsP1);
                DraftStyle_ApplyCard(g_roster_btnPool[i], Tardigrade_Audience(), shownState,
                    RosterDraft_PoolCard(shownState, audienceTag, unitType), false);
            }
        } else {
            DialogControlSetVisible(g_roster_btnPool[i], activeGroup, false);
            if (hasWaiter) {
                DialogControlSetVisible(g_roster_btnPool[i], waitGroup, false);
            }
            if (Tardigrade_HasAudience()) {
                DialogControlSetVisible(g_roster_btnPool[i], Tardigrade_Audience(), false);
            }
        }
        i = i + 1;
    }

    // ── Waiting player: message (their buttons were set in the loop above) ───
    if (hasWaiter) {
        if (g_roster_phase == 1) {
            DialogControlSetPropertyAsText(g_roster_lblSubtitle, c_triggerControlPropertyText,
                waitGroup, StringToText(
                    "<c val=\"AA4444\">Opponent is banning a unit from your pool...</c>"));
        } else {
            DialogControlSetPropertyAsText(g_roster_lblSubtitle, c_triggerControlPropertyText,
                waitGroup, StringToText(
                    "<c val=\"888888\">Opponent is building their roster...</c>"));
        }
    }

    // ── Spectators / referees: read-only subtitle ────────────────────────────
    if (Tardigrade_HasAudience()) {
        if (g_roster_phase == 1) {
            DialogControlSetPropertyAsText(g_roster_lblSubtitle, c_triggerControlPropertyText,
                Tardigrade_Audience(), StringToText(
                    "<c val=\"888888\">Spectating  —  a unit is being banned...</c>"));
        } else {
            DialogControlSetPropertyAsText(g_roster_lblSubtitle, c_triggerControlPropertyText,
                Tardigrade_Audience(), StringToText(
                    "<c val=\"888888\">Spectating  —  a roster is being built...</c>"));
        }
    }

    // ── Refresh roster panel ─────────────────────────────────────────────────
    RosterDraft_UpdateRosterPanel();
}

//--------------------------------------------------------------------------------------------------
// Roster Draft: Finish
//--------------------------------------------------------------------------------------------------
void RosterDraft_Finish() {
    string logMsg;
    int i;

    DraftTimer_Disarm();

    // Cleanup
    if (g_roster_trigger != null) {
        TriggerDestroy(g_roster_trigger);
        g_roster_trigger = null;
    }
    // No dialog when nothing was left to draft (RosterDraft_Continue).
    if (g_roster_dialog != c_invalidDialogId) {
        DialogDestroy(g_roster_dialog);
        g_roster_dialog = c_invalidDialogId;
    }

    // NOTE: Do NOT unpause here. Tardigrade_StartGame() unpauses once the
    // final Cycle-modifier draft completes.

    // Debug log
    logMsg = "=== Roster Draft Complete ===\nP1 Roster:";
    i = 1;
    while (i <= c_rosterMaxSize) {
        if (g_roster_p1Units[i] != "") { logMsg = logMsg + " " + g_roster_p1Units[i]; }
        i = i + 1;
    }
    logMsg = logMsg + "\nP2 Roster:";
    i = 1;
    while (i <= c_rosterMaxSize) {
        if (g_roster_p2Units[i] != "") { logMsg = logMsg + " " + g_roster_p2Units[i]; }
        i = i + 1;
    }
    Debug_Log(logMsg);

    if (g_roster_callback != null) {
        TriggerExecute(g_roster_callback, false, false);
    }
}

//--------------------------------------------------------------------------------------------------
// Roster Draft: steps
//
// A step is one ban or one pick. RosterDraft_Choose applies one for whoever is
// up - the click handler, the Tournament auto-pick and a YOLO side's automatic
// bans all go through it - then RosterDraft_Advance moves the phase along and
// RosterDraft_BeginStep sets up the next one.
//--------------------------------------------------------------------------------------------------
void RosterDraft_BeginStep();

// Close any phase whose steps are all done. True if the whole draft is over
// (and has been finished).
bool RosterDraft_Advance() {
    if (g_roster_phase == 0 && g_roster_pickIndex >= g_roster_openCount) {
        // Opening picks done -> ban phase, unless No Bans / YOLO left nothing
        // to ban - an empty ban phase would wait on a click that can't come.
        if (g_roster_banCount > 0) {
            g_roster_phase = 1;
        } else {
            g_roster_phase = 2;
        }
    }
    if (g_roster_phase == 1 && g_roster_banIndex >= g_roster_banCount) {
        // Bans done -> resume picking (pickIndex continues from the opening picks)
        g_roster_phase = 2;
    }
    if (g_roster_phase == 2 && g_roster_pickIndex >= g_roster_pickCount) {
        RosterDraft_Finish();
        return true;
    }
    return false;
}

// Skip the current step outright - only when it has no legal option left
// (a pool with nothing open), which a normal pool size never produces.
void RosterDraft_SkipStep() {
    if (g_roster_phase == 1) { g_roster_banIndex = g_roster_banIndex + 1; }
    else                     { g_roster_pickIndex = g_roster_pickIndex + 1; }
    if (!RosterDraft_Advance()) { RosterDraft_BeginStep(); }
}

void RosterDraft_Choose(int poolIndex) {
    bool   activeIsP1;
    int    activeRace;
    string unitType;

    if (poolIndex <= 0 || poolIndex > c_rosterPoolMax) { return; }

    if (g_roster_phase == 1) {
        // ── BAN: the active banner bans from the OPPONENT's pool ─────────────
        activeIsP1 = g_roster_banIsP1[g_roster_banIndex + 1];
        if (activeIsP1) {
            // P1 banning from P2's pool (can't ban units P2 already banned or picked)
            if (g_roster_p2Banned[poolIndex] || g_roster_p2Picked[poolIndex]) { return; }
            unitType = GetRosterPoolUnit(g_roster_p2Race, poolIndex);
            if (unitType == "") { return; }
            g_roster_p2Banned[poolIndex] = true;
            Debug_Log("P1 banned from P2 pool: " + unitType);
        } else {
            // P2 banning from P1's pool (can't ban units P1 already banned or picked)
            if (g_roster_p1Banned[poolIndex] || g_roster_p1Picked[poolIndex]) { return; }
            unitType = GetRosterPoolUnit(g_roster_p1Race, poolIndex);
            if (unitType == "") { return; }
            g_roster_p1Banned[poolIndex] = true;
            Debug_Log("P2 banned from P1 pool: " + unitType);
        }
        g_roster_banIndex = g_roster_banIndex + 1;
    } else {
        // ── PICK: from your own pool ─────────────────────────────────────────
        activeIsP1 = g_roster_pickIsP1[g_roster_pickIndex + 1];
        if (activeIsP1) {
            activeRace = g_roster_p1Race;
            if (g_roster_p1Picked[poolIndex] || g_roster_p1Banned[poolIndex]) { return; }
        } else {
            activeRace = g_roster_p2Race;
            if (g_roster_p2Picked[poolIndex] || g_roster_p2Banned[poolIndex]) { return; }
        }
        unitType = GetRosterPoolUnit(activeRace, poolIndex);
        if (unitType == "") { return; }
        RosterDraft_TakeSlot(activeIsP1, activeRace, poolIndex);
        if (activeIsP1) { Debug_Log("P1 drafted: " + unitType); }
        else            { Debug_Log("P2 drafted: " + unitType); }
        g_roster_pickIndex = g_roster_pickIndex + 1;
    }

    if (!RosterDraft_Advance()) { RosterDraft_BeginStep(); }
}

// A random legal option for the step that is up: a ban from the opponent's
// pool, or a pick from your own. 0 if there is none.
int RosterDraft_RandomChoice() {
    bool isP1;
    if (g_roster_phase == 1) {
        isP1 = g_roster_banIsP1[g_roster_banIndex + 1];
        if (isP1) { return RosterDraft_RandomOpenSlot(false, g_roster_p2Race); }
        return RosterDraft_RandomOpenSlot(true, g_roster_p1Race);
    }
    isP1 = g_roster_pickIsP1[g_roster_pickIndex + 1];
    if (isP1) { return RosterDraft_RandomOpenSlot(true, g_roster_p1Race); }
    return RosterDraft_RandomOpenSlot(false, g_roster_p2Race);
}

void RosterDraft_ChooseRandom() {
    int slot;
    slot = RosterDraft_RandomChoice();
    if (slot == 0) { RosterDraft_SkipStep(); }
    else           { RosterDraft_Choose(slot); }
}

// Tournament: the clock ran out.
bool RosterDraft_AutoAct(bool testConds, bool runActions) {
    RosterDraft_ChooseRandom();
    return true;
}

// A YOLO side's pick turn: one random unit from its pool. Its 6th turn also
// deals the rest (the 7th, or 7th-9th with No Bans), so they come out together.
void RosterDraft_YoloPick(bool isP1) {
    int    race;
    int    slot;
    int    count;

    if (isP1) { race = g_roster_p1Race; } else { race = g_roster_p2Race; }

    slot = RosterDraft_RandomOpenSlot(isP1, race);
    if (slot == 0) { RosterDraft_SkipStep(); return; }
    RosterDraft_TakeSlot(isP1, race, slot);

    if (isP1) { count = g_roster_p1PickCount; } else { count = g_roster_p2PickCount; }
    if (count == c_rosterRosterSize) {
        RosterDraft_DealRandom(isP1, race, RosterDraft_YoloSize(isP1));
    }

    g_roster_pickIndex = g_roster_pickIndex + 1;
    if (!RosterDraft_Advance()) { RosterDraft_BeginStep(); }
}

void RosterDraft_BeginStep() {
    RosterDraft_UpdateUI();

    // A YOLO side's pick turns are rolled for it, on the spot.
    if (g_roster_phase != 1 && RosterDraft_IsYolo(g_roster_pickIsP1[g_roster_pickIndex + 1])) {
        DraftTimer_Disarm();
        RosterDraft_YoloPick(g_roster_pickIsP1[g_roster_pickIndex + 1]);
        return;
    }

    // A YOLO side's ban turns are taken for it, at random, on the spot.
    if (g_roster_phase == 1 && RosterDraft_IsYolo(g_roster_banIsP1[g_roster_banIndex + 1])) {
        DraftTimer_Disarm();
        RosterDraft_ChooseRandom();
        return;
    }

    // Tournament: this step is on the clock (no-op in other modes).
    DraftTimer_Arm(g_roster_autoTrig);
}

//--------------------------------------------------------------------------------------------------
// Roster Draft: Button Click Handler
//--------------------------------------------------------------------------------------------------
bool RosterDraft_OnClicked(bool testConds, bool runActions) {
    int control;
    int player;
    int poolIndex;
    int btnIdx;

    control = EventDialogControl();
    player  = EventPlayer();

    // Identify which pool button was clicked
    poolIndex = 0;
    btnIdx    = 1;
    while (btnIdx <= c_rosterPoolMax) {
        if (control == g_roster_btnPool[btnIdx]) {
            poolIndex = btnIdx;
            break;
        }
        btnIdx = btnIdx + 1;
    }
    if (poolIndex == 0) { return true; }

    // Only whoever is up may act.
    if (g_roster_phase == 1) {
        if (player != g_roster_banOrder[g_roster_banIndex + 1]) { return true; }
    } else {
        if (player != g_roster_pickOrder[g_roster_pickIndex + 1]) { return true; }
    }

    RosterDraft_Choose(poolIndex);
    return true;
}

//--------------------------------------------------------------------------------------------------
// No Bans (modifier draft pick): the drafter's pool can't be banned from. The
// modifier draft runs before this one, so both sides' picks are already known.
//--------------------------------------------------------------------------------------------------
// Append a ban step for this banner unless their target pool is protected.
// bannerIsP1 = true means P1 bans from P2's pool, so P2's No Bans cancels it.
// A YOLO pool is skipped too: its roster is chance, not the opponent's to shape.
// So is a Protect and Ban pool: the opponent already banned from it, with
// points, in the Protect stage.
void RosterDraft_ScheduleBan(int banner, bool bannerIsP1) {
    if (bannerIsP1 && CycleMod_P2HasModIdx(c_cycleModNoBans)) { return; }
    if (!bannerIsP1 && CycleMod_P1HasModIdx(c_cycleModNoBans)) { return; }
    if (RosterDraft_IsYolo(!bannerIsP1)) { return; }
    if (RosterDraft_IsProtect(!bannerIsP1)) { return; }
    g_roster_banCount = g_roster_banCount + 1;
    g_roster_banOrder[g_roster_banCount] = banner;
    g_roster_banIsP1[g_roster_banCount]  = bannerIsP1;
}

// Append a pick step, unless both sides are YOLO (both rosters are dealt at
// the start). A lone YOLO side keeps its steps; they are rolled for it
// (RosterDraft_YoloPick). A Protect and Ban side has its roster already.
// opening = before the bans.
void RosterDraft_SchedulePick(int picker, bool pickerIsP1, bool opening) {
    if (RosterDraft_IsYolo(pickerIsP1) && !RosterDraft_YoloGradual()) { return; }
    if (RosterDraft_IsProtect(pickerIsP1)) { return; }
    g_roster_pickCount = g_roster_pickCount + 1;
    g_roster_pickOrder[g_roster_pickCount] = picker;
    g_roster_pickIsP1[g_roster_pickCount]  = pickerIsP1;
    if (opening) { g_roster_openCount = g_roster_openCount + 1; }
}

//--------------------------------------------------------------------------------------------------
// Roster Draft: Start
//
//   p1       — the banning player's decider (g_draft_p1 from RaceDraft)
//   p2       — the picking player's decider (g_draft_p2 from RaceDraft)
//   p1Race   — race of p1 (g_draft_p1Race)
//   p2Race   — race of p2 (g_draft_p2Race)
//
// Dialog layout (1140 x 600):
//
//   +--------------+-------------------------------+-----------------+
//   |  title  /  YOUR TURN or waiting                                 |
//   +- MODIFIERS --+- UNIT POOL --------------------+- YOUR ROSTER ---+
//   | YOURS  race  | [pool 1]      [pool 10]       | 1..6 (or 7)     |
//   |  name        | [pool 2]      [pool 11]       | [X] BANNED ...  |
//   |  description | ...           ...             +- OPPONENT ------+
//   | OPPONENT     | [pool 9]      [pool 18]       | 1..6 (or 7)     |
//   |  ...         |                               | [X] BANNED ...  |
//   +--------------+-------------------------------+-----------------+
//
// Anchor math: see the offsets at the top of the body.
//
// A Protect and Ban side's roster comes first, from its own screen
// (ProtectDraft_Start); the pick/ban draft below then runs for whatever is
// left to draft (RosterDraft_Continue).
//--------------------------------------------------------------------------------------------------
void ProtectDraft_Start(trigger callback);   // ProtectDraft.galaxy, included after
void RosterDraft_Continue();

bool RosterDraft_OnProtectDone(bool testConds, bool runActions) {
    RosterDraft_Continue();
    return true;
}

void RosterDraft_Start(trigger callback, int p1, int p2, int p1Race, int p2Race) {
    int i;

    g_roster_callback  = callback;
    g_roster_p1        = p1;
    g_roster_p2        = p2;
    g_roster_p1Race    = p1Race;
    g_roster_p2Race    = p2Race;
    g_roster_autoTrig  = TriggerCreate("RosterDraft_AutoAct");

    // Reset state
    g_roster_phase       = 0;
    g_roster_banIndex    = 0;
    g_roster_pickIndex   = 0;
    g_roster_p1PickCount = 0;
    g_roster_p2PickCount = 0;
    i = 1;
    while (i <= c_rosterPoolMax) {
        g_roster_p1Picked[i] = false;
        g_roster_p2Picked[i] = false;
        g_roster_p1Banned[i] = false;
        g_roster_p2Banned[i] = false;
        i = i + 1;
    }

    // All roster slots start empty (no protected core units).
    i = 1;
    while (i <= c_rosterMaxSize) {
        g_roster_p1Units[i] = "";
        g_roster_p2Units[i] = "";
        i = i + 1;
    }
    g_roster_dialog  = c_invalidDialogId;
    g_roster_trigger = null;

    if (RosterDraft_IsProtect(true) || RosterDraft_IsProtect(false)) {
        ProtectDraft_Start(TriggerCreate("RosterDraft_OnProtectDone"));
        return;
    }
    RosterDraft_Continue();
}

// The pick/ban draft, for the sides that still need a roster. Everything it
// needs is in the g_roster_* globals RosterDraft_Start set.
void RosterDraft_Continue() {
    int i;
    int row;
    int lblSection;
    int rows;
    int pitch;
    int y;
    int modTop;
    int modBottom;
    int p1;
    int p2;
    int p1Race;
    int p2Race;
    playergroup p1Group;
    playergroup p2Group;

    p1     = g_roster_p1;
    p2     = g_roster_p2;
    p1Race = g_roster_p1Race;
    p2Race = g_roster_p2Race;

    // Ban order: P1 bans from P2's pool, P2 bans from P1's pool, repeat x2
    // (banIsP1 = true means P1 is the one banning, targeting P2's pool).
    // The No Bans modifier protects its drafter's pool: the opponent's ban steps
    // are dropped, not passed, so the other side's two bans run back to back.
    g_roster_banCount = 0;
    RosterDraft_ScheduleBan(p1, true);
    RosterDraft_ScheduleBan(p2, false);
    RosterDraft_ScheduleBan(p1, true);
    RosterDraft_ScheduleBan(p2, false);

    // Pick order: 2 OPENING picks each (P1 P2 P2 P1) happen BEFORE bans so
    // players can secure key units, then bans, then the remaining FINAL picks.
    // Both YOLO: every step is left out (RosterDraft_SchedulePick).
    g_roster_pickCount = 0;
    g_roster_openCount = 0;
    RosterDraft_SchedulePick(p1, true,  true);
    RosterDraft_SchedulePick(p2, false, true);
    RosterDraft_SchedulePick(p2, false, true);
    RosterDraft_SchedulePick(p1, true,  true);
    RosterDraft_SchedulePick(p2, false, false);
    RosterDraft_SchedulePick(p1, true,  false);
    RosterDraft_SchedulePick(p1, true,  false);
    RosterDraft_SchedulePick(p2, false, false);
    RosterDraft_SchedulePick(p2, false, false);
    RosterDraft_SchedulePick(p1, true,  false);
    RosterDraft_SchedulePick(p1, true,  false);
    RosterDraft_SchedulePick(p2, false, false);

    // Both YOLO, or YOLO against Protect and Ban: deal the YOLO roster now.
    // (A lone YOLO side against a normal drafter is rolled pick by pick.)
    if (!RosterDraft_YoloGradual()) {
        if (RosterDraft_IsYolo(true))  { RosterDraft_FillYolo(true,  p1Race); }
        if (RosterDraft_IsYolo(false)) { RosterDraft_FillYolo(false, p2Race); }
    }

    // Nothing left to draft (no side drafts normally): no screen at all.
    if (g_roster_pickCount == 0 && g_roster_banCount == 0) {
        RosterDraft_Finish();
        return;
    }

    Debug_Log("RosterDraft: P1=" + IntToString(p1) + " race=" + GetRaceConfigId(p1Race)
        + " poolCount=" + IntToString(GetRosterPoolCount(p1Race)));
    Debug_Log("RosterDraft: P2=" + IntToString(p2) + " race=" + GetRaceConfigId(p2Race)
        + " poolCount=" + IntToString(GetRosterPoolCount(p2Race)));

    // ── Build Dialog: 1140 × 600, three columns ──────────────────────
    // With c_anchorTop an x offset places a control's CENTRE relative to the
    // dialog's centre (570), so offset = left + width/2 - 570.
    //   modifiers  left  20, width 270  ->  -415
    //   pool A     left 305, width 238  ->  -146
    //   pool B     left 555, width 238  ->  +104
    //   rosters    left 815, width 290  ->  +390
    // The modifiers used to be a strip along the bottom, under the pool - where
    // the 17-unit Protoss pool's 9th row already sat, so the two overlapped.
    g_roster_dialog = DialogCreate(1140, 600, c_anchorCenter, 0, 0, true);
    Tardigrade_ObservableDialog(g_roster_dialog);
    DialogSetVisible(g_roster_dialog, Tardigrade_Viewers(), true);

    // Title label — centered, top
    g_roster_lblTitle = DialogControlCreate(g_roster_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_roster_lblTitle, Tardigrade_Viewers(), 1100, 28);
    DialogControlSetPosition(g_roster_lblTitle, Tardigrade_Viewers(), c_anchorTop, 0, 16);

    // Subtitle label — centered, below title (YOUR TURN / waiting)
    g_roster_lblSubtitle = DialogControlCreate(g_roster_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_roster_lblSubtitle, Tardigrade_Viewers(), 1100, 20);
    DialogControlSetPosition(g_roster_lblSubtitle, Tardigrade_Viewers(), c_anchorTop, 0, 46);

    // ── Left column: both sides' modifiers ───────────────────────────────────
    lblSection = DialogControlCreate(g_roster_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(lblSection, Tardigrade_Viewers(), 270, 14);
    DialogControlSetPosition(lblSection, Tardigrade_Viewers(), c_anchorTop, -415, 68);
    DialogControlSetPropertyAsText(lblSection, c_triggerControlPropertyText,
        Tardigrade_Viewers(),
        StringToText(DraftStyle_Small("<c val=\"555555\">MODIFIERS  (per player) ──────────</c>")));

    // Two blocks: yours on top, your opponent's below (P1 / P2 for spectators).
    modTop = DialogControlCreate(g_roster_dialog, c_triggerControlTypeLabel);
    modBottom = DialogControlCreate(g_roster_dialog, c_triggerControlTypeLabel);
    DialogControlSetPropertyAsString(modTop, c_triggerControlPropertyStyle,
        Tardigrade_Viewers(), c_rosterModPanelStyle);
    DialogControlSetPropertyAsString(modBottom, c_triggerControlPropertyStyle,
        Tardigrade_Viewers(), c_rosterModPanelStyle);
    DialogControlSetSize(modTop, Tardigrade_Viewers(), 270, 236);
    DialogControlSetPosition(modTop, Tardigrade_Viewers(), c_anchorTop, -415, 88);
    DialogControlSetSize(modBottom, Tardigrade_Viewers(), 270, 236);
    DialogControlSetPosition(modBottom, Tardigrade_Viewers(), c_anchorTop, -415, 336);

    p1Group = PlayerGroupSingle(p1);
    p2Group = PlayerGroupSingle(p2);
    if (c_cyclePhaseMode) {
        DialogControlSetPropertyAsText(modTop, c_triggerControlPropertyText,
            Tardigrade_Viewers(), StringToText(RosterDraft_PhaseBlock()));
    } else {
        DialogControlSetPropertyAsText(modTop, c_triggerControlPropertyText,
            p1Group, StringToText(RosterDraft_ModBlock(true, "YOURS", "4ADB92")));
        DialogControlSetPropertyAsText(modBottom, c_triggerControlPropertyText,
            p1Group, StringToText(RosterDraft_ModBlock(false, "OPPONENT", "E8913F")));
        if (p1 != p2) {
            DialogControlSetPropertyAsText(modTop, c_triggerControlPropertyText,
                p2Group, StringToText(RosterDraft_ModBlock(false, "YOURS", "4ADB92")));
            DialogControlSetPropertyAsText(modBottom, c_triggerControlPropertyText,
                p2Group, StringToText(RosterDraft_ModBlock(true, "OPPONENT", "E8913F")));
        }
        if (Tardigrade_HasAudience()) {
            DialogControlSetPropertyAsText(modTop, c_triggerControlPropertyText,
                Tardigrade_Audience(), StringToText(RosterDraft_ModBlock(true, "PLAYER 1", "4ADB92")));
            DialogControlSetPropertyAsText(modBottom, c_triggerControlPropertyText,
                Tardigrade_Audience(), StringToText(RosterDraft_ModBlock(false, "PLAYER 2", "E8913F")));
        }
    }

    // ── Middle column: the unit pool ─────────────────────────────────────────
    // Kept in a global: RosterDraft_UpdateUI rewrites it per viewer each turn to
    // say whose pool is on screen (during bans it is the opponent's).
    g_roster_lblPoolHdr = DialogControlCreate(g_roster_dialog, c_triggerControlTypeLabel);
    lblSection = g_roster_lblPoolHdr;
    DialogControlSetSize(lblSection, Tardigrade_Viewers(), 490, 14);
    DialogControlSetPosition(lblSection, Tardigrade_Viewers(), c_anchorTop, -21, 68);
    DialogControlSetPropertyAsText(lblSection, c_triggerControlPropertyText,
        Tardigrade_Viewers(),
        StringToText("<c val=\"555555\">UNIT POOL</c>"));

    // Two columns of up to 9 (c_rosterPoolMax = 18), 238 × 48 cards on a 54px
    // step from y=84, so the 9th row ends at 564.
    i = 1;
    while (i <= c_rosterPoolMax) {
        g_roster_btnPool[i] = DialogControlCreate(g_roster_dialog, c_triggerControlTypeButton);
        DraftStyle_InitButton(g_roster_btnPool[i], Tardigrade_Viewers());
        DialogControlSetSize(g_roster_btnPool[i], Tardigrade_Viewers(), 238, 48);
        if (i <= 9) {
            row = i - 1;
            DialogControlSetPosition(g_roster_btnPool[i], Tardigrade_Viewers(),
                c_anchorTop, -146, 84 + row * 54);
        } else {
            row = i - 10;
            DialogControlSetPosition(g_roster_btnPool[i], Tardigrade_Viewers(),
                c_anchorTop, 104, 84 + row * 54);
        }
        // Hidden initially; UpdateUI shows every slot the pool actually has
        DialogControlSetVisible(g_roster_btnPool[i], Tardigrade_Viewers(), false);
        i = i + 1;
    }

    // ── Right column: YOUR ROSTER + its bans, then OPPONENT + theirs ─────────
    // The opponent's live picks are shown so players can counter-draft, and
    // the bans stay listed after the ban phase so they remain in view.
    // 32px rows for a 6-unit roster, 28px when a YOLO roster makes it 7, and
    // whatever fits the 446px left for two lists when a Protect and Ban
    // roster is longer (22px at 10 rows).
    rows = RosterDraft_Rows();
    if (rows > c_rosterYoloSize)        { pitch = 446 / (2 * rows); }
    else if (rows > c_rosterRosterSize) { pitch = 28; }
    else                                { pitch = 32; }

    lblSection = DialogControlCreate(g_roster_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(lblSection, Tardigrade_Viewers(), 290, 14);
    DialogControlSetPosition(lblSection, Tardigrade_Viewers(), c_anchorTop, 390, 68);
    DialogControlSetPropertyAsText(lblSection, c_triggerControlPropertyText,
        Tardigrade_Viewers(),
        StringToText("<c val=\"555555\">YOUR ROSTER ─────────────────</c>"));
    if (Tardigrade_HasAudience()) {
        DialogControlSetPropertyAsText(lblSection, c_triggerControlPropertyText,
            Tardigrade_Audience(),
            StringToText("<c val=\"555555\">PLAYER 1 ROSTER ────────────</c>"));
    }

    y = 88;
    i = 1;
    while (i <= rows) {
        g_roster_lblSlot[i] = DialogControlCreate(g_roster_dialog, c_triggerControlTypeLabel);
        DialogControlSetSize(g_roster_lblSlot[i], Tardigrade_Viewers(), 290, pitch - 4);
        DialogControlSetPosition(g_roster_lblSlot[i], Tardigrade_Viewers(),
            c_anchorTop, 390, y);
        y = y + pitch;
        i = i + 1;
    }
    g_roster_lblBan = DialogControlCreate(g_roster_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_roster_lblBan, Tardigrade_Viewers(), 290, 18);
    DialogControlSetPosition(g_roster_lblBan, Tardigrade_Viewers(), c_anchorTop, 390, y);
    y = y + 28;

    lblSection = DialogControlCreate(g_roster_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(lblSection, Tardigrade_Viewers(), 290, 14);
    DialogControlSetPosition(lblSection, Tardigrade_Viewers(), c_anchorTop, 390, y);
    DialogControlSetPropertyAsText(lblSection, c_triggerControlPropertyText,
        Tardigrade_Viewers(),
        StringToText("<c val=\"555555\">OPPONENT ────────────────────</c>"));
    if (Tardigrade_HasAudience()) {
        DialogControlSetPropertyAsText(lblSection, c_triggerControlPropertyText,
            Tardigrade_Audience(),
            StringToText("<c val=\"555555\">PLAYER 2 ROSTER ────────────</c>"));
    }
    y = y + 20;

    i = 1;
    while (i <= rows) {
        g_roster_lblOppSlot[i] = DialogControlCreate(g_roster_dialog, c_triggerControlTypeLabel);
        DialogControlSetSize(g_roster_lblOppSlot[i], Tardigrade_Viewers(), 290, pitch - 4);
        DialogControlSetPosition(g_roster_lblOppSlot[i], Tardigrade_Viewers(),
            c_anchorTop, 390, y);
        y = y + pitch;
        i = i + 1;
    }
    g_roster_lblOppBan = DialogControlCreate(g_roster_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_roster_lblOppBan, Tardigrade_Viewers(), 290, 18);
    DialogControlSetPosition(g_roster_lblOppBan, Tardigrade_Viewers(), c_anchorTop, 390, y);

    // Register click trigger for all pool buttons
    g_roster_trigger = TriggerCreate("RosterDraft_OnClicked");
    i = 1;
    while (i <= c_rosterPoolMax) {
        TriggerAddEventDialogControl(g_roster_trigger, c_playerAny,
            g_roster_btnPool[i], c_triggerControlEventTypeClick);
        i = i + 1;
    }

    // Initial render
    if (!RosterDraft_Advance()) { RosterDraft_BeginStep(); }
}

//==================================================================================================
// IN-GAME ROSTER HUD
// A small top-left button that toggles a panel listing your 6 drafted units
// (left, green) and your opponent's 6 (right, orange), so players can
// remember what to build - and scout what they're up against - during the
// game. Each player gets their own dialog (see the g_rhud_* declarations
// above for why), so the toggle only ever affects the player who clicked it.
//==================================================================================================
void RosterHUD_SetForPlayer(int player, int whichRoster) {
    playergroup viewer;
    int         i;
    string      mineName;
    string      oppName;

    viewer = PlayerGroupSingle(player);
    i = 1;
    while (i <= RosterDraft_Rows()) {
        if (whichRoster == 1) {
            mineName = RosterUnitDisplayName(g_roster_p1Units[i]);
            oppName  = RosterUnitDisplayName(g_roster_p2Units[i]);
        } else {
            mineName = RosterUnitDisplayName(g_roster_p2Units[i]);
            oppName  = RosterUnitDisplayName(g_roster_p1Units[i]);
        }
        DialogControlSetPropertyAsText(g_rhud_lblMine[player][i], c_triggerControlPropertyText,
            viewer, StringToText("<c val=\"00FF88\">  " + IntToString(i) + ".  " + mineName + "</c>"));
        DialogControlSetPropertyAsText(g_rhud_lblOpp[player][i], c_triggerControlPropertyText,
            viewer, StringToText("<c val=\"FF9955\">  " + IntToString(i) + ".  " + oppName + "</c>"));
        i = i + 1;
    }
}

bool RosterHUD_OnToggle(bool testConds, bool runActions) {
    int         player;
    playergroup viewer;
    int         i;

    player = EventPlayer();
    viewer = PlayerGroupSingle(player);

    if (g_rhud_expanded[player]) {
        DialogSetSize(g_rhud_dialog[player], 390, 34);
        DialogControlSetVisible(g_rhud_hdrMine[player], viewer, false);
        DialogControlSetVisible(g_rhud_hdrOpp[player], viewer, false);
        i = 1;
        while (i <= RosterDraft_Rows()) {
            DialogControlSetVisible(g_rhud_lblMine[player][i], viewer, false);
            DialogControlSetVisible(g_rhud_lblOpp[player][i], viewer, false);
            i = i + 1;
        }
        DialogControlSetPropertyAsText(g_rhud_btn[player], c_triggerControlPropertyText,
            viewer, StringToText("My Drafted Units  [+]"));
        g_rhud_expanded[player] = false;
    } else {
        DialogSetSize(g_rhud_dialog[player], 390, 236 + (RosterDraft_Rows() - c_rosterRosterSize) * 30);
        DialogControlSetVisible(g_rhud_hdrMine[player], viewer, true);
        DialogControlSetVisible(g_rhud_hdrOpp[player], viewer, true);
        i = 1;
        while (i <= RosterDraft_Rows()) {
            DialogControlSetVisible(g_rhud_lblMine[player][i], viewer, true);
            DialogControlSetVisible(g_rhud_lblOpp[player][i], viewer, true);
            i = i + 1;
        }
        DialogControlSetPropertyAsText(g_rhud_btn[player], c_triggerControlPropertyText,
            viewer, StringToText("My Drafted Units  [-]"));
        g_rhud_expanded[player] = true;
    }
    return true;
}

// Always-open, read-only roster reference for referees and spectators.
void RosterHUD_InitAudience() {
    playergroup aud;
    string      p1Name;
    string      p2Name;
    int         i;

    if (!Tardigrade_HasAudience()) { return; }
    aud = Tardigrade_Audience();

    g_rhud_audDialog = DialogCreate(410, 226 + (RosterDraft_Rows() - c_rosterRosterSize) * 30, c_anchorTopLeft, 6, 28, false);
    Tardigrade_ObservableDialog(g_rhud_audDialog);
    DialogSetVisible(g_rhud_audDialog, aud, true);
    DialogSetImageVisible(g_rhud_audDialog, true);

    g_rhud_audTitle = DialogControlCreate(g_rhud_audDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_rhud_audTitle, aud, 398, 28);
    DialogControlSetPosition(g_rhud_audTitle, aud, c_anchorTop, 0, 6);
    DialogControlSetPropertyAsText(g_rhud_audTitle, c_triggerControlPropertyText,
        aud, StringToText("<c val=\"FFD54A\">DRAFTED ROSTERS</c>    "
            + "<c val=\"00FF88\">P1 " + RaceName(g_roster_p1Race) + "</c>"
            + "    <c val=\"FF9955\">P2 " + RaceName(g_roster_p2Race) + "</c>"));

    i = 1;
    while (i <= RosterDraft_Rows()) {
        p1Name = RosterUnitDisplayName(g_roster_p1Units[i]);
        p2Name = RosterUnitDisplayName(g_roster_p2Units[i]);
        g_rhud_audRow[i] = DialogControlCreate(g_rhud_audDialog, c_triggerControlTypeLabel);
        DialogControlSetSize(g_rhud_audRow[i], aud, 398, 28);
        DialogControlSetPosition(g_rhud_audRow[i], aud, c_anchorTop, 0, 38 + (i - 1) * 30);
        DialogControlSetPropertyAsText(g_rhud_audRow[i], c_triggerControlPropertyText,
            aud, StringToText(
                "<c val=\"00FF88\">" + IntToString(i) + ". " + p1Name + "</c>"
                + "    <c val=\"FF9955\">" + IntToString(i) + ". " + p2Name + "</c>"));
        i = i + 1;
    }
}

// Build one player's private HUD dialog (collapsed by default) and wire its
// toggle button to the shared trigger t.
void RosterHUD_InitForPlayer(int player, int whichRoster, trigger t) {
    playergroup viewer;
    int         i;

    viewer = PlayerGroupSingle(player);

    // Width stays constant (390) across collapsed/expanded - only height
    // changes in RosterHUD_OnToggle - so every control's anchor offset (which
    // is relative to the dialog's current center) stays correct in both
    // states instead of visibly shifting when the dialog resizes.
    g_rhud_dialog[player] = DialogCreate(390, 34, c_anchorTopLeft, 6, 28, false);
    Tardigrade_ObservableDialog(g_rhud_dialog[player]);
    DialogSetVisible(g_rhud_dialog[player], viewer, true);
    DialogSetImageVisible(g_rhud_dialog[player], true);

    g_rhud_btn[player] = DialogControlCreate(g_rhud_dialog[player], c_triggerControlTypeButton);
    DialogControlSetSize(g_rhud_btn[player], viewer, 180, 26);
    DialogControlSetPosition(g_rhud_btn[player], viewer, c_anchorTop, 0, 4);
    DialogControlSetPropertyAsText(g_rhud_btn[player], c_triggerControlPropertyText,
        viewer, StringToText("My Drafted Units  [+]"));

    // Column headers.
    g_rhud_hdrMine[player] = DialogControlCreate(g_rhud_dialog[player], c_triggerControlTypeLabel);
    DialogControlSetSize(g_rhud_hdrMine[player], viewer, 180, 14);
    DialogControlSetPosition(g_rhud_hdrMine[player], viewer, c_anchorTop, -95, 34);
    DialogControlSetPropertyAsText(g_rhud_hdrMine[player], c_triggerControlPropertyText,
        viewer, StringToText("<c val=\"00FF88\">MINE</c>"));
    DialogControlSetVisible(g_rhud_hdrMine[player], viewer, false);

    g_rhud_hdrOpp[player] = DialogControlCreate(g_rhud_dialog[player], c_triggerControlTypeLabel);
    DialogControlSetSize(g_rhud_hdrOpp[player], viewer, 180, 14);
    DialogControlSetPosition(g_rhud_hdrOpp[player], viewer, c_anchorTop, 95, 34);
    DialogControlSetPropertyAsText(g_rhud_hdrOpp[player], c_triggerControlPropertyText,
        viewer, StringToText("<c val=\"FF9955\">OPPONENT</c>"));
    DialogControlSetVisible(g_rhud_hdrOpp[player], viewer, false);

    // Two columns of 6 rows (7 with a YOLO roster): MINE (left) + OPPONENT (right).
    i = 1;
    while (i <= RosterDraft_Rows()) {
        g_rhud_lblMine[player][i] = DialogControlCreate(g_rhud_dialog[player], c_triggerControlTypeLabel);
        DialogControlSetSize(g_rhud_lblMine[player][i], viewer, 180, 28);
        DialogControlSetPosition(g_rhud_lblMine[player][i], viewer, c_anchorTop, -95, 50 + (i - 1) * 30);
        DialogControlSetVisible(g_rhud_lblMine[player][i], viewer, false);

        g_rhud_lblOpp[player][i] = DialogControlCreate(g_rhud_dialog[player], c_triggerControlTypeLabel);
        DialogControlSetSize(g_rhud_lblOpp[player][i], viewer, 180, 28);
        DialogControlSetPosition(g_rhud_lblOpp[player][i], viewer, c_anchorTop, 95, 50 + (i - 1) * 30);
        DialogControlSetVisible(g_rhud_lblOpp[player][i], viewer, false);
        i = i + 1;
    }

    RosterHUD_SetForPlayer(player, whichRoster);
    TriggerAddEventDialogControl(t, player, g_rhud_btn[player], c_triggerControlEventTypeClick);
}

void RosterHUD_Init() {
    int         i;
    int         count;
    int         p;
    trigger     t;
    playergroup p1Team;
    playergroup p2Team;

    if (g_draft_p1_is_team1) { p1Team = g_draft_team1; p2Team = g_draft_team2; }
    else                     { p1Team = g_draft_team2; p2Team = g_draft_team1; }

    t = TriggerCreate("RosterHUD_OnToggle");

    count = PlayerGroupCount(p1Team);
    i = 1;
    while (i <= count) {
        p = PlayerGroupPlayer(p1Team, i);
        RosterHUD_InitForPlayer(p, 1, t);
        i = i + 1;
    }

    count = PlayerGroupCount(p2Team);
    i = 1;
    while (i <= count) {
        p = PlayerGroupPlayer(p2Team, i);
        RosterHUD_InitForPlayer(p, 2, t);
        i = i + 1;
    }

    RosterHUD_InitAudience();
}
