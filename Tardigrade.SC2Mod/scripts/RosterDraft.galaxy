//--------------------------------------------------------------------------------------------------
// Roster Draft System
//
// Each player drafts 6 units from their own race's pool (no protected core):
//   opening picks  P1 P2 P2 P1          (2 each, before any bans)
//   cross-bans     P1 P2 P1 P2          (each bans from the OPPONENT's pool)
//   final picks    P2 P1 P1 P2 P2 P1 P1 P2
//
// The schedule is built per game in RosterDraft_Start, not fixed, because two
// modifiers drafted just before this remove steps from it:
//   No Bans (12) - the opponent's bans against that side are dropped. On a
//                  YOLO side it is +2 units instead (RosterDraft_YoloSize), on
//                  a Protect and Ban side +4 points (ProtectDraft_Points).
//   YOLO    (16) - that side does not draft at all: 7 units at random from
//                  its race's pool, nothing guaranteed. Against a normal
//                  drafter each of its pick turns is rolled on the spot, the
//                  7th together with the 6th, so the roster is revealed at the
//                  normal draft's pace (RosterDraft_YoloPick). When both sides
//                  are YOLO the pick steps are dropped and both rosters dealt
//                  at the start. Bans against a YOLO side are dropped (its
//                  roster is chance, not the opponent's to shape), and its own
//                  ban turns are taken at random, on the spot.
//
// Requires: RaceDraft.galaxy (for GetRaceConfigId, race constants)
//--------------------------------------------------------------------------------------------------

// Constants
const int c_rosterPoolMax    = 18; // max draftable units per race (2 columns of 9)
const int c_rosterBanTotal   = 4;  // total cross-bans (2 per player), before skips
const int c_rosterPickTotal  = 12; // total snake picks (6 per player), before skips
const int c_rosterPreBanPicks = 4; // opening picks made BEFORE bans (2 per player)
const int c_rosterRosterSize = 6;  // drafted units per player (no protected core)
const int c_rosterYoloSize   = 7;  // a YOLO roster: 7 random units
const int c_rosterYoloNoBansBonus = 2; // ...plus these with No Bans
// Largest roster any style can produce: a Protect and Ban side keeps every
// unit it put points on that wasn't banned, which can be most of its pool.
// Roster arrays are sized with the literal 19 - keep > c_rosterMaxSize.
const int c_rosterMaxSize    = 18;

// State
trigger g_roster_callback    = null;
int     g_roster_p1;
int     g_roster_p2;
int     g_roster_p1Race;
int     g_roster_p2Race;

// Roster results — index 1..6, 1..7 for a YOLO side, up to c_rosterMaxSize for
// a Protect and Ban side; unused slots are "". Filled densely from 1.
// Accessible globally for later systems (roster enforcement, etc.)
string[19] g_roster_p1Units;
string[19] g_roster_p2Units;

// Draft tracking
int       g_roster_phase       = 0;   // 0 = opening picks, 1 = bans, 2 = final picks
int       g_roster_banIndex    = 0;
int       g_roster_banCount    = 0;   // bans actually scheduled: c_rosterBanTotal minus skips
int[5]    g_roster_banOrder;          // [1..banCount] who is doing the banning
bool[5]   g_roster_banIsP1;           // [1..banCount] true = P1 is banning (from P2's pool)
bool[19]  g_roster_p1Banned;          // units banned FROM P1's pool (by P2)
bool[19]  g_roster_p2Banned;          // units banned FROM P2's pool (by P1)
int       g_roster_pickIndex   = 0;
int       g_roster_pickCount   = 0;   // picks actually scheduled: c_rosterPickTotal minus YOLO skips
int       g_roster_openCount   = 0;   // how many of them are opening picks (before bans)
int[13]   g_roster_pickOrder;
bool[13]  g_roster_pickIsP1;
trigger   g_roster_autoTrig    = null; // RosterDraft_AutoAct, run by the Tournament timer
bool[19]  g_roster_p1Picked;          // [1..18] which pool slots P1 has taken
bool[19]  g_roster_p2Picked;          // [1..18] which pool slots P2 has taken
int       g_roster_p1PickCount = 0;
int       g_roster_p2PickCount = 0;

// UI
int       g_roster_dialog      = c_invalidDialogId;
int       g_roster_lblTitle    = c_invalidDialogControlId;
int       g_roster_lblSubtitle = c_invalidDialogControlId; // "YOUR TURN" or "waiting..."
int       g_roster_lblPoolHdr = c_invalidDialogControlId;   // "YOUR POOL" / "THEIR POOL"
int[19]   g_roster_btnPool;                                // [1..18] unit pool buttons
int[19]   g_roster_lblSlot;                                // [1..rows] your roster slots
int[19]   g_roster_lblOppSlot;                             // [1..rows] opponent roster slots
int       g_roster_lblBan    = c_invalidDialogControlId;   // units banned from your pool
int       g_roster_lblOppBan = c_invalidDialogControlId;   // units banned from theirs
trigger   g_roster_trigger     = null;

// Left-hand panel: the style its two modifier blocks use. A stock core style
// (FontStyles.SC2Style) chosen because it is top- and left-justified - a
// plain label centres vertically, so a short list would float mid-panel.
const string c_rosterModPanelStyle = "HelpWelcomePanelSubText";

// In-game roster HUD (top-left toggle that expands to your 6 drafted units +
// your opponent's 6). One dialog PER PLAYER, not one shared dialog: neither
// DialogSetSize nor DialogSetImageVisible take a playergroup parameter (they
// resize/reskin the dialog object itself, for every current viewer at once),
// so a single shared dialog cannot be expanded/collapsed privately - whoever
// clicked toggled it for every viewer of that dialog. Giving each player
// their own dialog object (visible only to them) sidesteps that entirely.
int[16]    g_rhud_dialog;
int[16]    g_rhud_btn;
int[16]    g_rhud_hdrMine;
int[16]    g_rhud_hdrOpp;
int[16][19] g_rhud_lblMine;
int[16][19] g_rhud_lblOpp;
bool[16]   g_rhud_expanded;
int    g_rhud_audDialog = c_invalidDialogId;
int    g_rhud_audTitle  = c_invalidDialogControlId;
int[19] g_rhud_audRow;

//--------------------------------------------------------------------------------------------------
// Data Helpers
//--------------------------------------------------------------------------------------------------


// Pool fields are named Pool1..Pool8 (explicit, avoids CUser array-syntax uncertainty)
string GetRosterPoolUnit(int race, int index) {
    return UserDataGetGameLink("TardigradeRosterConfig", GetRaceConfigId(race),
        "Pool" + IntToString(index), 1);
}

int GetRosterPoolCount(int race) {
    return UserDataGetInt("TardigradeRosterConfig", GetRaceConfigId(race), "PoolCount", 1);
}

