//--------------------------------------------------------------------------------------------------
// Race Draft System
//--------------------------------------------------------------------------------------------------

// Constants
const int c_tardigrade_raceTerran = 1;
const int c_tardigrade_raceProtoss = 2;
const int c_tardigrade_raceZerg = 3;

// State
int g_draft_p1; // The banning player
int g_draft_p2; // The picking player
playergroup g_draft_team1; // Team 1 Players
playergroup g_draft_team2; // Team 2 Players
bool g_draft_p1_is_team1; // True if P1 (Banner) represents Team 1
int g_draft_bannedRace = 0;
int g_draft_phase = 0; // 0 = Ban, 1 = Pick
trigger g_draft_trigger;
trigger g_draft_callback = null;

// Base-game starting worker count per player, captured before we wipe the melee
// start (so post-draft spawns mirror whatever the current patch uses).
int[16] g_draft_startWorkers;

// Deferred worker spawn: SetPlayerRace spawns only the town hall immediately
// and records race/location/count here; Tardigrade_SpawnDeferredWorkers()
// (called once the pre-game countdown finishes) reads this to spawn the
// workers + extra unit for real and set them mining.
int[16]   g_start_race;
point[16] g_start_loc;
int[16]   g_start_workerCount;

// Exposed results ? set at finish, read by subsequent draft phases
int g_draft_p1Race = 0; // race of g_draft_p1 (the banning player)
int g_draft_p2Race = 0; // race of g_draft_p2 (the picking player)

// UI
int g_draft_dialog = c_invalidDialogId;
int g_draft_label = c_invalidDialogControlId;
int g_draft_btnTerran = c_invalidDialogControlId;
int g_draft_btnProtoss = c_invalidDialogControlId;
int g_draft_btnZerg = c_invalidDialogControlId;
int g_draft_btnAutoRun = c_invalidDialogControlId;
int g_draft_btnAutoTerran = c_invalidDialogControlId;
int g_draft_btnAutoProtoss = c_invalidDialogControlId;
int g_draft_btnAutoZerg = c_invalidDialogControlId;

//--------------------------------------------------------------------------------------------------
// Audience / Spectator helpers
//
// Referees and spectators (set via the lobby "Make Referee" / "Make Spectator")
// are active player slots that belong to neither playing team. They must SEE
// every draft screen and the in-game HUD to stay in the loop, but must never be
// able to click anything. PlayerGroupAll() does not reach them, so every custom
// dialog is broadcast to g_tard_viewers (all active slots) and the read-only
// spectator views are targeted at g_tard_audience.
//--------------------------------------------------------------------------------------------------
playergroup g_tard_viewers;           // all active slots (participants + spectators + AI)
playergroup g_tard_audience;          // referees + spectators only (no team)
bool        g_tard_groupsReady = false;

// Rebuild the viewer and audience groups from the current player slots.
// Call once the teams are known.
void Tardigrade_RefreshViewerGroups() {
    int i;
    int p;

    g_tard_viewers  = PlayerGroupActive();
    g_tard_audience = PlayerGroupCopy(g_tard_viewers);

    i = 1;
    while (i <= PlayerGroupCount(g_draft_team1)) {
        p = PlayerGroupPlayer(g_draft_team1, i);
        PlayerGroupRemove(g_tard_audience, p);
        i = i + 1;
    }

    i = 1;
    while (i <= PlayerGroupCount(g_draft_team2)) {
        p = PlayerGroupPlayer(g_draft_team2, i);
        PlayerGroupRemove(g_tard_audience, p);
        i = i + 1;
    }

    g_tard_groupsReady = true;
    Debug_Log("Viewer groups: active=" + IntToString(PlayerGroupCount(g_tard_viewers))
        + " team1=" + IntToString(PlayerGroupCount(g_draft_team1))
        + " team2=" + IntToString(PlayerGroupCount(g_draft_team2))
        + " audience=" + IntToString(PlayerGroupCount(g_tard_audience)));
}

// Broadcast group for dialogs and chat: all active slots, falling back to
// PlayerGroupAll() before the groups are built.
playergroup Tardigrade_Viewers() {
    if (!g_tard_groupsReady) { return PlayerGroupAll(); }
    return g_tard_viewers;
}

// Spectator-only group; empty until the groups are built.
playergroup Tardigrade_Audience() {
    if (!g_tard_groupsReady) { return PlayerGroupEmpty(); }
    return g_tard_audience;
}

// True if there is at least one spectator/referee to render read-only views for.
bool Tardigrade_HasAudience() {
    return g_tard_groupsReady && PlayerGroupCount(g_tard_audience) > 0;
}

//--------------------------------------------------------------------------------------------------
// Helper: Get Race Config ID
//--------------------------------------------------------------------------------------------------
string GetRaceConfigId(int race) {
    if (race == c_tardigrade_raceTerran) { return "Terran"; }
    if (race == c_tardigrade_raceProtoss) { return "Protoss"; }
    if (race == c_tardigrade_raceZerg) { return "Zerg"; }
    return "";
}

//--------------------------------------------------------------------------------------------------
// Helper: Get Race Name
//--------------------------------------------------------------------------------------------------
string RaceName(int race) {
    return GetRaceConfigId(race);
}

//--------------------------------------------------------------------------------------------------
// Helper: Get Race Unit Type
//--------------------------------------------------------------------------------------------------
string GetRaceUnitType(int race, string field) {
    string raceId = GetRaceConfigId(race);
    if (raceId == "") { return ""; }
    return UserDataGetGameLink("TardigradeRaceStartConfig", raceId, field, 1);
}

//--------------------------------------------------------------------------------------------------
// Helper: Get Race Start Config Int
//--------------------------------------------------------------------------------------------------
int GetRaceStartConfigInt(int race, string field) {
    string raceId = GetRaceConfigId(race);
    if (raceId == "") { return 0; }
    return UserDataGetInt("TardigradeRaceStartConfig", raceId, field, 1);
}

//--------------------------------------------------------------------------------------------------
// Debug: Dump Config
//--------------------------------------------------------------------------------------------------
void DumpDraftConfigToLog(int race) {
    string dump = "--- Draft Config Dump (" + RaceName(race) + ") ---\n";
    dump = dump + "WorkerCount: " + IntToString(GetRaceStartConfigInt(race, "WorkerCount")) + "\n";
    dump = dump + "Minerals:    " + IntToString(GetRaceStartConfigInt(race, "Minerals")) + "\n";
    dump = dump + "Vespene:     " + IntToString(GetRaceStartConfigInt(race, "Vespene")) + "\n";
    dump = dump + "-------------------------";
    
    Debug_Log(dump);
}

//--------------------------------------------------------------------------------------------------
// Auto-mine: order each freshly spawned worker to gather the nearest mineral.
//--------------------------------------------------------------------------------------------------
void Tardigrade_OrderMine(int race, point loc, unitgroup workers) {
    string    gatherAbil;
    region    r;
    unitgroup nearUnits;
    unitgroup minerals;
    unit      u;
    unit      w;
    unit      tgt;
    string    t;
    int       count;
    int       i;

    if (race == c_tardigrade_raceTerran)      { gatherAbil = "SCVHarvest"; }
    else if (race == c_tardigrade_raceProtoss) { gatherAbil = "ProbeHarvest"; }
    else                                       { gatherAbil = "DroneHarvest"; }

    // Collect mineral fields near the start location.
    r         = RegionCircle(loc, 12.0);
    nearUnits = UnitGroup(null, c_playerAny, r, UnitFilter(0, 0, 0, 0), 0);
    minerals  = UnitGroupEmpty();
    count = UnitGroupCount(nearUnits, c_unitCountAll);
    i = 1;
    while (i <= count) {
        u = UnitGroupUnit(nearUnits, i);
        t = UnitGetType(u);
        if (StringContains(t, "MineralField", c_stringAnywhere, false)) {
            UnitGroupAdd(minerals, u);
        }
        i = i + 1;
    }
    if (UnitGroupCount(minerals, c_unitCountAll) == 0) { return; }

    // Order each worker to the closest mineral patch.
    count = UnitGroupCount(workers, c_unitCountAll);
    i = 1;
    while (i <= count) {
        w   = UnitGroupUnit(workers, i);
        tgt = UnitGroupNearestUnit(minerals, UnitGetPosition(w));
        if (tgt != null) {
            UnitIssueOrder(w, OrderTargetingUnit(AbilityCommand(gatherAbil, 0), tgt),
                c_orderQueueReplace);
        }
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Helper: Replace Army
//--------------------------------------------------------------------------------------------------
void SetPlayerRace(int player, int race) {
    unitgroup existingUnits;
    unitgroup spawned;
    unit u;
    point startLoc;
    string townHallType;
    bool skipStartPack;
    int i;
    int workerCount = g_draft_startWorkers[player];
    int minerals = GetRaceStartConfigInt(race, "Minerals");
    int vespene = GetRaceStartConfigInt(race, "Vespene");

    DumpDraftConfigToLog(race);

    // Mirror the base-game melee worker count; fall back to config if we somehow
    // captured nothing for this player.
    if (workerCount <= 0) { workerCount = GetRaceStartConfigInt(race, "WorkerCount"); }

    // 1. Determine Unit Types
    townHallType = GetRaceUnitType(race, "TownHall");
    skipStartPack = false; // every race gets a normal melee opening

    // 2. Find Start Location (where the current Town Hall is)
    existingUnits = UnitGroup(null, player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    startLoc = PlayerStartLocation(player); // Default fallback

    // Try to find the actual town hall to get precise location
    i = 1;
    while (i <= UnitGroupCount(existingUnits, c_unitCountAll)) {
        u = UnitGroupUnit(existingUnits, i);
        if (UnitTypeTestAttribute(UnitGetType(u), c_unitAttributeStructure)) {
            startLoc = UnitGetPosition(u);
            break;
        }
        i = i + 1;
    }

    // 3. Destroy Old Units (the map's default-race starting pack)
    UnitGroupLoopBegin(existingUnits);
    while (!UnitGroupLoopDone()) {
        UnitRemove(UnitGroupLoopCurrent());
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();

    // 4. Spawn ONLY the drafted race's town hall immediately. A structure
    //    has to exist on the map the whole draft or the native "no
    //    units/structures left" defeat/stalemate tracking trips for every
    //    player at once and the game ties before it begins (see the History
    //    note below) - but workers + the extra unit (e.g. Overlord) do NOT
    //    need to exist yet, and leaving them out means there is nothing
    //    to mine or command while the draft UI is still up. They are
    //    spawned for real once the pre-game countdown finishes, by
    //    Tardigrade_SpawnDeferredWorkers() (called from Tardigrade_StartGame).
    //
    //    History: an earlier version deferred the town hall too, leaving
    //    every player with zero units/structures for the several real-time
    //    minutes the remaining drafts take - that's what tripped the tie.
    //    The fix after that, UnitPauseAll(true)/(false) bracketing the whole
    //    draft, was **confirmed wrong in a live playtest** - it didn't block
    //    commands at all. Making units unselectable
    //    (Tardigrade_DraftLock_Start()/_Stop()) does block commands, but
    //    applying it to real, already-mining workers for the whole draft
    //    just relocates the same complaint: units doing something (mining)
    //    behind the draft UI. Deferring the workers themselves removes that
    //    complaint at the source; the town hall alone still satisfies
    //    elimination tracking and still needs the unselectable lock so it
    //    can't be used to train from directly.
    libNtve_gf_CreateUnitsWithDefaultFacing(1, townHallType, 0, player, startLoc);

    // Lock the town hall unselectable immediately, rather than waiting up to
    // 0.5s for Tardigrade_DraftLockScan's next tick to reach it -
    // Tardigrade_DraftLock_Start() is already running by the time this
    // function is reached (see RaceDraft_Start).
    spawned = UnitGroup(null, player, RegionCircle(startLoc, 10.0), UnitFilter(0, 0, 0, 0), 0);
    i = 1;
    while (i <= UnitGroupCount(spawned, c_unitCountAll)) {
        UnitSetState(UnitGroupUnit(spawned, i), c_unitStateSelectable, false);
        i = i + 1;
    }

    // Remember race/location/count so Tardigrade_SpawnDeferredWorkers() can
    // spawn the rest once the countdown finishes.
    g_start_race[player]        = race;
    g_start_loc[player]         = startLoc;
    g_start_workerCount[player] = workerCount;

    // 5. Set Resources (Standard Melee Start)
    PlayerModifyPropertyInt(player, c_playerPropMinerals, c_playerPropOperSetTo, minerals);
    PlayerModifyPropertyInt(player, c_playerPropVespene, c_playerPropOperSetTo, vespene);
}

//--------------------------------------------------------------------------------------------------
// Public: spawn every player's deferred workers + extra unit (e.g. Overlord)
// and set the workers mining. Called once, right after the pre-game
// countdown finishes and right before the draft lock is released, so
// nothing sits mining or commandable while the draft UI is still up.
//--------------------------------------------------------------------------------------------------
void Tardigrade_SpawnDeferredWorkers() {
    int       player;
    int       race;
    string    workerType;
    string    extraUnitType;
    point     loc;
    int       count;
    unitgroup workers;

    player = 1;
    while (player <= 15) {
        race = g_start_race[player];
        if (race > 0) {
            loc           = g_start_loc[player];
            count         = g_start_workerCount[player];
            workerType    = GetRaceUnitType(race, "Worker");
            extraUnitType = GetRaceUnitType(race, "ExtraUnit");

            libNtve_gf_CreateUnitsWithDefaultFacing(count, workerType, 0, player, loc);
            workers = UnitGroup(workerType, player, RegionCircle(loc, 10.0), UnitFilter(0, 0, 0, 0), 0);

            if (extraUnitType != "") {
                libNtve_gf_CreateUnitsWithDefaultFacing(1, extraUnitType, 0, player, loc);
            }

            Tardigrade_OrderMine(race, loc, workers);
            g_start_race[player] = 0;
        }
        player = player + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Helper: Replace Army for Team
//--------------------------------------------------------------------------------------------------
void SetTeamRace(playergroup team, int race) {
    int i = 1;
    int count = PlayerGroupCount(team);
    int p;

    while (i <= count) {
        p = PlayerGroupPlayer(team, i);
        SetPlayerRace(p, race);
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Helper: Remove Workers
//--------------------------------------------------------------------------------------------------
void RemoveWorkers() {
    // UnitFilter(0, 0, 0, 0) selects everything.
    unitgroup g = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    unit u;
    string type;
    int owner;
    int i;

    // Reset captured counts.
    i = 0;
    while (i <= 15) { g_draft_startWorkers[i] = 0; i = i + 1; }

    UnitGroupLoopBegin(g);
    while (!UnitGroupLoopDone()) {
        u = UnitGroupLoopCurrent();
        owner = UnitGetOwner(u);
        
        // Only check units owned by actual players (1-15)
        if (owner != 0) {
            type = UnitGetType(u);
            if (type == "SCV" || type == "Probe" || type == "Drone") {
                // Capture the base-game count before removing, so post-draft
                // spawns mirror the current patch.
                g_draft_startWorkers[owner] = g_draft_startWorkers[owner] + 1;
                UnitRemove(u);
            }
        }
        UnitGroupLoopStep();
    }
    UnitGroupLoopEnd();
}

//--------------------------------------------------------------------------------------------------
// Logic: Finish Draft
//--------------------------------------------------------------------------------------------------
void RaceDraft_Finish(int pickedRace) {
    int p1Race;
    int t1Race;
    int t2Race;
    string msg;
    
    // Determine P1's race (The one that wasn't banned and wasn't picked)
    if (g_draft_bannedRace != c_tardigrade_raceTerran && pickedRace != c_tardigrade_raceTerran) { p1Race = c_tardigrade_raceTerran; }
    else if (g_draft_bannedRace != c_tardigrade_raceProtoss && pickedRace != c_tardigrade_raceProtoss) { p1Race = c_tardigrade_raceProtoss; }
    else { p1Race = c_tardigrade_raceZerg; }

    // Apply to Teams
    // P1 is the Banner. They get the "Remainder" race (p1Race).
    // P2 is the Picker. They get the "Picked" race (pickedRace).
    if (g_draft_p1_is_team1) {
        t1Race = p1Race;
        t2Race = pickedRace;
    } else {
        t1Race = pickedRace;
        t2Race = p1Race;
    }

    SetTeamRace(g_draft_team1, t1Race);
    SetTeamRace(g_draft_team2, t2Race);

    // Store race per decider (p1 = banner, p2 = picker)
    g_draft_p1Race = p1Race;
    g_draft_p2Race = pickedRace;

    // Cleanup UI
    DialogDestroy(g_draft_dialog);

    // NOTE: Do NOT unpause here. The chained draft phases manage pausing.
    // Tardigrade_StartGame() -- after the final Cycle draft -- unpauses the game.

    // Run Callback
    if (g_draft_callback != null) {
        TriggerExecute(g_draft_callback, false, false);
    }

    // Announce race outcome
    msg = "Draft Complete! Team 1: " + RaceName(t1Race) + ", Team 2: " + RaceName(t2Race);
    UIDisplayMessage(Tardigrade_Viewers(), c_messageAreaChat, StringToText(msg));
}

//--------------------------------------------------------------------------------------------------
// Logic: Update UI for spectators / referees (read-only mirror)
//--------------------------------------------------------------------------------------------------
void RaceDraft_UpdateAudienceUI() {
    playergroup aud;
    string      lbl;
    aud = Tardigrade_Audience();

    if (g_draft_phase == 0) {
        lbl = "Spectating  -  a race is being BANNED...";
        DialogControlSetVisible(g_draft_btnTerran,  aud, true);
        DialogControlSetVisible(g_draft_btnProtoss, aud, true);
        DialogControlSetVisible(g_draft_btnZerg,    aud, true);
    } else {
        lbl = "Spectating  -  a race is being PICKED...";
        DialogControlSetVisible(g_draft_btnTerran,  aud, (g_draft_bannedRace != c_tardigrade_raceTerran));
        DialogControlSetVisible(g_draft_btnProtoss, aud, (g_draft_bannedRace != c_tardigrade_raceProtoss));
        DialogControlSetVisible(g_draft_btnZerg,    aud, (g_draft_bannedRace != c_tardigrade_raceZerg));
    }

    DialogControlSetPropertyAsText(g_draft_label, c_triggerControlPropertyText, aud, StringToText(lbl));

    // Never clickable for spectators.
    DialogControlSetEnabled(g_draft_btnTerran,  aud, false);
    DialogControlSetEnabled(g_draft_btnProtoss, aud, false);
    DialogControlSetEnabled(g_draft_btnZerg,    aud, false);
}

//--------------------------------------------------------------------------------------------------
// Logic: Update UI
//--------------------------------------------------------------------------------------------------

void RaceDraft_UpdateUI() {
    if (g_draft_phase == 0) {
        // Ban Phase (P1)
        DialogControlSetPropertyAsText(g_draft_label, c_triggerControlPropertyText, PlayerGroupSingle(g_draft_p1), StringToText("BAN a Race"));
        
        // Show all buttons to P1
        DialogControlSetVisible(g_draft_btnTerran, PlayerGroupSingle(g_draft_p1), true);
        DialogControlSetVisible(g_draft_btnProtoss, PlayerGroupSingle(g_draft_p1), true);
        DialogControlSetVisible(g_draft_btnZerg, PlayerGroupSingle(g_draft_p1), true);
        
        // Only update P2 view if P2 is a different player (avoids overwriting P1 view in solo testing)
        if (g_draft_p1 != g_draft_p2) {
            DialogControlSetPropertyAsText(g_draft_label, c_triggerControlPropertyText, PlayerGroupSingle(g_draft_p2), StringToText("Opponent is Banning..."));
            
            // Hide buttons from P2
            DialogControlSetVisible(g_draft_btnTerran, PlayerGroupSingle(g_draft_p2), false);
            DialogControlSetVisible(g_draft_btnProtoss, PlayerGroupSingle(g_draft_p2), false);
            DialogControlSetVisible(g_draft_btnZerg, PlayerGroupSingle(g_draft_p2), false);
        }
    }
    else {
        // Pick Phase (P2)
        DialogControlSetPropertyAsText(g_draft_label, c_triggerControlPropertyText, PlayerGroupSingle(g_draft_p2), StringToText("PICK your Race"));

        // Show available buttons to P2
        DialogControlSetVisible(g_draft_btnTerran, PlayerGroupSingle(g_draft_p2), (g_draft_bannedRace != c_tardigrade_raceTerran));
        DialogControlSetVisible(g_draft_btnProtoss, PlayerGroupSingle(g_draft_p2), (g_draft_bannedRace != c_tardigrade_raceProtoss));
        DialogControlSetVisible(g_draft_btnZerg, PlayerGroupSingle(g_draft_p2), (g_draft_bannedRace != c_tardigrade_raceZerg));

        // Only update P1 view if P1 is a different player
        if (g_draft_p1 != g_draft_p2) {
            DialogControlSetPropertyAsText(g_draft_label, c_triggerControlPropertyText, PlayerGroupSingle(g_draft_p1), StringToText("Opponent is Picking..."));

            // Hide buttons from P1
            DialogControlSetVisible(g_draft_btnTerran, PlayerGroupSingle(g_draft_p1), false);
            DialogControlSetVisible(g_draft_btnProtoss, PlayerGroupSingle(g_draft_p1), false);
            DialogControlSetVisible(g_draft_btnZerg, PlayerGroupSingle(g_draft_p1), false);
        }
    }

    // Read-only spectator view: referees and spectators see the current state
    // but every race button is disabled so they can never influence the draft.
    if (Tardigrade_HasAudience()) {
        RaceDraft_UpdateAudienceUI();
    }
}

//--------------------------------------------------------------------------------------------------
// Handler: Button Click
//--------------------------------------------------------------------------------------------------
bool RaceDraft_OnClicked(bool testConds, bool runActions) {
    int control = EventDialogControl();
    int player = EventPlayer();
    int selectedRace = 0;

    if (Tardigrade_HasAudience() && PlayerGroupHasPlayer(Tardigrade_Audience(), player)) {
        return true;
    }

    if (control == g_draft_btnTerran) { selectedRace = c_tardigrade_raceTerran; }
    else if (control == g_draft_btnProtoss) { selectedRace = c_tardigrade_raceProtoss; }
    else if (control == g_draft_btnZerg) { selectedRace = c_tardigrade_raceZerg; }

    if (control == g_draft_btnAutoRun) {
        Debug_SetForcedRace(0);
        if (g_debug_autoRunTrigger != null) {
            TriggerExecute(g_debug_autoRunTrigger, false, false);
        }
        return true;
    }

    if (control == g_draft_btnAutoTerran || control == g_draft_btnAutoProtoss || control == g_draft_btnAutoZerg) {
        if (control == g_draft_btnAutoTerran) { Debug_SetForcedRace(c_tardigrade_raceTerran); }
        if (control == g_draft_btnAutoProtoss) { Debug_SetForcedRace(c_tardigrade_raceProtoss); }
        if (control == g_draft_btnAutoZerg) { Debug_SetForcedRace(c_tardigrade_raceZerg); }
        if (g_debug_autoRunTrigger != null) {
            TriggerExecute(g_debug_autoRunTrigger, false, false);
        }
        return true;
    }

    if (selectedRace == 0) { return true; }

    if (g_draft_phase == 0) {
        // Ban Phase
        if (player != g_draft_p1) { return true; }
        g_draft_bannedRace = selectedRace;
        g_draft_phase = 1;
        RaceDraft_UpdateUI();
    }
    else {
        // Pick Phase
        if (player != g_draft_p2) { return true; }
        RaceDraft_Finish(selectedRace);
    }

    return true;
}

//--------------------------------------------------------------------------------------------------
// Draft lock: unselectable, not paused.
//
// UnitPauseAll(true) was tried first and does NOT stop a player from
// selecting and commanding their Town Hall/workers - confirmed in a live
// playtest, orders still went through while "paused". Making every
// player-owned unit unselectable is airtight: no selection means no
// command card, no hotkey target, nothing to click or drag-box.
//
// Runs as a repeating 0.5s scan (mirrors CycleMod_ScanTrigger) rather than
// a one-shot pass, because Zerg's Hatchery keeps auto-spawning Larva up to
// its cap for a while after the town hall spawns - each new Larva has to be
// caught and locked too, or a player could morph units directly off it with
// zero workers, which is the original exploit this system exists to close.
//--------------------------------------------------------------------------------------------------
bool    g_draftLock_active = false;
trigger g_draftLock_trig = null;

bool Tardigrade_DraftLockScan(bool testConds, bool runActions) {
    unitgroup ug;
    unit      u;
    int       count;
    int       i;

    while (g_draftLock_active) {
        ug = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
        count = UnitGroupCount(ug, c_unitCountAll);
        i = 1;
        while (i <= count) {
            u = UnitGroupUnit(ug, i);
            if (UnitGetOwner(u) > 0) {
                UnitSetState(u, c_unitStateSelectable, false);
            }
            i = i + 1;
        }
        // c_timeGame, not c_timeReal, would stall this loop for the entire
        // draft: GameSetMissionTimePaused(true) is active the whole time,
        // and c_timeGame waits don't advance while mission time is paused
        // (see Tardigrade_Countdown's comment in TardigradeLogic.galaxy).
        Wait(0.5, c_timeReal);
    }
    return true;
}

// Public: start locking every player-owned unit unselectable. Call once,
// right before the draft can spawn anything.
void Tardigrade_DraftLock_Start() {
    if (g_draftLock_active) { return; }
    g_draftLock_active = true;
    g_draftLock_trig = TriggerCreate("Tardigrade_DraftLockScan");
    TriggerExecute(g_draftLock_trig, false, false);
}

// Public: stop the lock and make every player-owned unit selectable again.
void Tardigrade_DraftLock_Stop() {
    unitgroup ug;
    unit      u;
    int       count;
    int       i;

    g_draftLock_active = false;

    ug = UnitGroup(null, c_playerAny, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    count = UnitGroupCount(ug, c_unitCountAll);
    i = 1;
    while (i <= count) {
        u = UnitGroupUnit(ug, i);
        if (UnitGetOwner(u) > 0) {
            UnitSetState(u, c_unitStateSelectable, true);
        }
        i = i + 1;
    }
}

//--------------------------------------------------------------------------------------------------
// Main: Start Draft
//--------------------------------------------------------------------------------------------------
void RaceDraft_Start(trigger callback) {
    int i;
    int p;
    int decider1 = 0;
    int decider2 = 0;
    bool team1HasHuman = false;
    bool team2HasHuman = false;

    // Store Callback
    g_draft_callback = callback;

    // Wait for initialization to complete (units to spawn)
    Wait(0.1, c_timeGame);

    // 1. Read the actual lobby teams. Referees and spectators are active
    // slots, but GameAttributePlayersForTeam excludes them.
    g_draft_team1 = GameAttributePlayersForTeam(1);
    g_draft_team2 = GameAttributePlayersForTeam(2);

    // Find each team's human decider.
    i = 1;
    while (i <= PlayerGroupCount(g_draft_team1)) {
        p = PlayerGroupPlayer(g_draft_team1, i);
        if (PlayerStatus(p) == c_playerStatusActive && PlayerType(p) == c_playerTypeUser) {
            team1HasHuman = true;
            if (decider1 == 0) { decider1 = p; }
        }
        i = i + 1;
    }

    i = 1;
    while (i <= PlayerGroupCount(g_draft_team2)) {
        p = PlayerGroupPlayer(g_draft_team2, i);
        if (PlayerStatus(p) == c_playerStatusActive && PlayerType(p) == c_playerTypeUser) {
            team2HasHuman = true;
            if (decider2 == 0) { decider2 = p; }
        }
        i = i + 1;
    }

    // 2. Handle Solo / PvAI (One team has no humans)
    if (!team1HasHuman && !team2HasHuman) {
        // All AI? Just return.
        Debug_Log("Draft Skipped: No human players found.");
        if (g_draft_callback != null) {
            TriggerExecute(g_draft_callback, false, false);
        }
        return; 
    }
    
    if (team1HasHuman && !team2HasHuman) {
        // Team 1 is sole human team. Decider1 decides for both.
        decider2 = decider1;
        Debug_Log("Solo/PvAI Mode: Player " + IntToString(decider1) + " controls draft.");
    }
    else if (!team1HasHuman && team2HasHuman) {
        // Team 2 is sole human team. Decider2 decides for both.
        decider1 = decider2;
        Debug_Log("Solo/PvAI Mode: Player " + IntToString(decider2) + " controls draft.");
    }

    // 3. Assign Draft Roles (Randomize who bans/picks)
    if (RandomInt(0, 1) == 0) {
        g_draft_p1 = decider1; // Team 1 Bans
        g_draft_p2 = decider2; // Team 2 Picks
        g_draft_p1_is_team1 = true;
    } else {
        g_draft_p1 = decider2; // Team 2 Bans
        g_draft_p2 = decider1; // Team 1 Picks
        g_draft_p1_is_team1 = false;
    }

    // Pause Game. GameSetMissionTimePaused only stops the mission clock, not
    // player input - it does NOT stop a player from drag-selecting their
    // Town Hall and queuing production while the draft dialogs are up.
    // Tardigrade_DraftLock_Start() closes that off by making every
    // player-owned unit unselectable for the whole draft (see its own
    // comment above for why UnitPauseAll doesn't work for this).
    GameSetMissionTimePaused(true);
    Tardigrade_DraftLock_Start();
    RemoveWorkers();

    // Identify referees / spectators now that the two teams are known.
    Tardigrade_RefreshViewerGroups();

    // Create UI
    g_draft_dialog = DialogCreate(500, 500, c_anchorCenter, 0, 0, true);
    DialogSetTitle(g_draft_dialog, StringToText("Tardigrade  -  Race Draft"));
    DialogSetVisible(g_draft_dialog, Tardigrade_Viewers(), true);

    // Label
    g_draft_label = DialogControlCreate(g_draft_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_draft_label, Tardigrade_Viewers(), 400, 50);
    DialogControlSetPosition(g_draft_label, Tardigrade_Viewers(), c_anchorTop, 0, 80);
    DialogControlSetPropertyAsText(g_draft_label, c_triggerControlPropertyText, Tardigrade_Viewers(), StringToText("Initializing..."));

    // Buttons
    g_draft_btnTerran = DialogControlCreate(g_draft_dialog, c_triggerControlTypeButton);
    DialogControlSetSize(g_draft_btnTerran, Tardigrade_Viewers(), 200, 50);
    DialogControlSetPosition(g_draft_btnTerran, Tardigrade_Viewers(), c_anchorTop, 0, 150);
    DialogControlSetPropertyAsText(g_draft_btnTerran, c_triggerControlPropertyText, Tardigrade_Viewers(), StringToText("Terran"));

    g_draft_btnProtoss = DialogControlCreate(g_draft_dialog, c_triggerControlTypeButton);
    DialogControlSetSize(g_draft_btnProtoss, Tardigrade_Viewers(), 200, 50);
    DialogControlSetPosition(g_draft_btnProtoss, Tardigrade_Viewers(), c_anchorTop, 0, 210);
    DialogControlSetPropertyAsText(g_draft_btnProtoss, c_triggerControlPropertyText, Tardigrade_Viewers(), StringToText("Protoss"));

    g_draft_btnZerg = DialogControlCreate(g_draft_dialog, c_triggerControlTypeButton);
    DialogControlSetSize(g_draft_btnZerg, Tardigrade_Viewers(), 200, 50);
    DialogControlSetPosition(g_draft_btnZerg, Tardigrade_Viewers(), c_anchorTop, 0, 270);
    DialogControlSetPropertyAsText(g_draft_btnZerg, c_triggerControlPropertyText, Tardigrade_Viewers(), StringToText("Zerg"));

    // Debug skip button
    if (g_debugLevel > c_debug_None) {
        g_draft_btnAutoRun = DialogControlCreate(g_draft_dialog, c_triggerControlTypeButton);
        DialogControlSetSize(g_draft_btnAutoRun, PlayerGroupAll(), 200, 30);
        DialogControlSetPosition(g_draft_btnAutoRun, PlayerGroupAll(), c_anchorTop, 0, 340);
        DialogControlSetPropertyAsText(g_draft_btnAutoRun, c_triggerControlPropertyText, PlayerGroupAll(), StringToText("[ DEBUG: Random All ]"));

        g_draft_btnAutoTerran = DialogControlCreate(g_draft_dialog, c_triggerControlTypeButton);
        DialogControlSetSize(g_draft_btnAutoTerran, PlayerGroupAll(), 200, 28);
        DialogControlSetPosition(g_draft_btnAutoTerran, PlayerGroupAll(), c_anchorTop, 0, 374);
        DialogControlSetPropertyAsText(g_draft_btnAutoTerran, c_triggerControlPropertyText, PlayerGroupAll(), StringToText("[ DEBUG: Auto As Terran ]"));

        g_draft_btnAutoProtoss = DialogControlCreate(g_draft_dialog, c_triggerControlTypeButton);
        DialogControlSetSize(g_draft_btnAutoProtoss, PlayerGroupAll(), 200, 28);
        DialogControlSetPosition(g_draft_btnAutoProtoss, PlayerGroupAll(), c_anchorTop, 0, 406);
        DialogControlSetPropertyAsText(g_draft_btnAutoProtoss, c_triggerControlPropertyText, PlayerGroupAll(), StringToText("[ DEBUG: Auto As Protoss ]"));

        g_draft_btnAutoZerg = DialogControlCreate(g_draft_dialog, c_triggerControlTypeButton);
        DialogControlSetSize(g_draft_btnAutoZerg, PlayerGroupAll(), 200, 28);
        DialogControlSetPosition(g_draft_btnAutoZerg, PlayerGroupAll(), c_anchorTop, 0, 438);
        DialogControlSetPropertyAsText(g_draft_btnAutoZerg, c_triggerControlPropertyText, PlayerGroupAll(), StringToText("[ DEBUG: Auto As Zerg ]"));

        if (Tardigrade_HasAudience()) {
            DialogControlSetVisible(g_draft_btnAutoRun,     Tardigrade_Audience(), false);
            DialogControlSetVisible(g_draft_btnAutoTerran,  Tardigrade_Audience(), false);
            DialogControlSetVisible(g_draft_btnAutoProtoss, Tardigrade_Audience(), false);
            DialogControlSetVisible(g_draft_btnAutoZerg,    Tardigrade_Audience(), false);
        }
    }

    // Register Trigger
    g_draft_trigger = TriggerCreate("RaceDraft_OnClicked");
    TriggerAddEventDialogControl(g_draft_trigger, c_playerAny, g_draft_btnTerran, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(g_draft_trigger, c_playerAny, g_draft_btnProtoss, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(g_draft_trigger, c_playerAny, g_draft_btnZerg, c_triggerControlEventTypeClick);
    if (g_debugLevel > c_debug_None && g_draft_btnAutoRun != c_invalidDialogControlId) {
        TriggerAddEventDialogControl(g_draft_trigger, c_playerAny, g_draft_btnAutoRun, c_triggerControlEventTypeClick);
        if (g_draft_btnAutoTerran != c_invalidDialogControlId) {
            TriggerAddEventDialogControl(g_draft_trigger, c_playerAny, g_draft_btnAutoTerran, c_triggerControlEventTypeClick);
        }
        if (g_draft_btnAutoProtoss != c_invalidDialogControlId) {
            TriggerAddEventDialogControl(g_draft_trigger, c_playerAny, g_draft_btnAutoProtoss, c_triggerControlEventTypeClick);
        }
        if (g_draft_btnAutoZerg != c_invalidDialogControlId) {
            TriggerAddEventDialogControl(g_draft_trigger, c_playerAny, g_draft_btnAutoZerg, c_triggerControlEventTypeClick);
        }
    }

    // Start
    RaceDraft_UpdateUI();
}
