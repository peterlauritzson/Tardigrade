//--------------------------------------------------------------------------------------------------
// Roster Enforcement
//
// After the drafts resolve, each team may only build the 6 unit types it
// drafted - derived units (Hellbat, Archon, the Zerg morphs) included. Every
// other combat unit in the race's arsenal is disabled for that team via
// TechTreeUnitAllow(..., false), and transforms into them are blocked too.
//
// Workers, town halls, tech/production structures, and supply units are never
// touched, so the economy and tech tree still function normally.
//
// Requires: RaceDraft.galaxy (race constants, team globals),
//           RosterDraft.galaxy (g_roster_* roster globals)
//--------------------------------------------------------------------------------------------------

// Master combat-unit lists per race. Any unit here that is NOT in a team's
// roster is disabled for that team. Core units are always in the roster, so
// listing them here would be harmless, but they are omitted for clarity.
string[24] g_enfTerran; int g_enfTerranN;
string[24] g_enfProtoss; int g_enfProtossN;
string[24] g_enfZerg; int g_enfZergN;
bool g_enfInit = false;

void RosterEnforce_InitLists() {
    if (g_enfInit) { return; }
    g_enfInit = true;

    g_enfTerranN = 16;
    g_enfTerran[1]  = "Marine";        g_enfTerran[2]  = "Marauder";
    g_enfTerran[3]  = "Reaper";        g_enfTerran[4]  = "Ghost";
    g_enfTerran[5]  = "Hellion";       g_enfTerran[6]  = "HellionTank";
    g_enfTerran[7]  = "WidowMine";     g_enfTerran[8]  = "Cyclone";
    g_enfTerran[9]  = "SiegeTank";     g_enfTerran[10] = "Thor";
    g_enfTerran[11] = "VikingFighter"; g_enfTerran[12] = "Medivac";
    g_enfTerran[13] = "Liberator";     g_enfTerran[14] = "Raven";
    g_enfTerran[15] = "Banshee";       g_enfTerran[16] = "Battlecruiser";

    g_enfProtossN = 17;
    g_enfProtoss[1]  = "Zealot";       g_enfProtoss[2]  = "Stalker";
    g_enfProtoss[3]  = "Sentry";       g_enfProtoss[4]  = "Adept";
    g_enfProtoss[5]  = "HighTemplar";  g_enfProtoss[6]  = "DarkTemplar";
    g_enfProtoss[7]  = "Immortal";     g_enfProtoss[8]  = "Colossus";
    g_enfProtoss[9]  = "Disruptor";    g_enfProtoss[10] = "Archon";
    g_enfProtoss[11] = "WarpPrism";    g_enfProtoss[12] = "Phoenix";
    g_enfProtoss[13] = "VoidRay";      g_enfProtoss[14] = "Oracle";
    g_enfProtoss[15] = "Carrier";      g_enfProtoss[16] = "Tempest";
    g_enfProtoss[17] = "Mothership";

    g_enfZergN = 14;
    g_enfZerg[1]  = "Zergling";  g_enfZerg[2]  = "Baneling";
    g_enfZerg[3]  = "Roach";     g_enfZerg[4]  = "Ravager";
    g_enfZerg[5]  = "Hydralisk"; g_enfZerg[6]  = "LurkerMP";
    g_enfZerg[7]  = "Infestor";  g_enfZerg[8]  = "SwarmHostMP";
    g_enfZerg[9]  = "Ultralisk"; g_enfZerg[10] = "Mutalisk";
    g_enfZerg[11] = "Corruptor"; g_enfZerg[12] = "BroodLord";
    g_enfZerg[13] = "Viper";     g_enfZerg[14] = "Queen";
}

// Is unitType present in the given decider's roster (1 = P1, 2 = P2)?
bool RosterEnforce_InRoster(int whichRoster, string unitType) {
    int i;
    i = 1;
    while (i <= c_rosterRosterSize) {
        if (whichRoster == 1) {
            if (g_roster_p1Units[i] == unitType) { return true; }
        } else {
            if (g_roster_p2Units[i] == unitType) { return true; }
        }
        i = i + 1;
    }
    return false;
}

// A unit is allowed if and only if it is in the roster. Derived units used to
// ride along for free (Hellbat with Hellion, Archon with either templar); they
// are now picks of their own, and each has a way to be built when drafted
// alone - see RosterEnforce_GateTransforms / _GateArchonFallback / the larva
// fallbacks below.
bool RosterEnforce_IsAllowed(int whichRoster, string unitType) {
    return RosterEnforce_InRoster(whichRoster, unitType);
}

//--------------------------------------------------------------------------------------------------
// Transforms into an undrafted unit. TechTreeUnitAllow(false) on the result
// should already stop a morph or merge from producing it, but that is the
// engine's call to make on every path; disallowing the transform command too
// makes the rule explicit and takes the button off the card.
//   Hellion <-> Hellbat: each direction needs its target drafted.
//   Templar merge: needs Archon drafted. ArchonWarp has two commands,
//   SelectedUnits (0) and WithTarget (1); both go.
//--------------------------------------------------------------------------------------------------
void RosterEnforce_BlockUnlessDrafted(int player, int whichRoster, string result,
                                      string abil, int cmd) {
    if (!RosterEnforce_IsAllowed(whichRoster, result)) {
        TechTreeAbilityAllow(player, AbilityCommand(abil, cmd), false);
    }
}

void RosterEnforce_GateTransforms(int player, int race, int whichRoster) {
    if (race == c_tardigrade_raceTerran) {
        RosterEnforce_BlockUnlessDrafted(player, whichRoster, "HellionTank", "MorphToHellionTank", 0);
        RosterEnforce_BlockUnlessDrafted(player, whichRoster, "Hellion",     "MorphToHellion",     0);
    } else if (race == c_tardigrade_raceProtoss) {
        RosterEnforce_BlockUnlessDrafted(player, whichRoster, "Archon", "ArchonWarp", 0);
        RosterEnforce_BlockUnlessDrafted(player, whichRoster, "Archon", "ArchonWarp", 1);
    }
}

// Archon drafted without either templar builds straight from Gateway / Warp
// Gate (AbilData.xml GatewayTrain / WarpGateTrain Train8). With a templar in
// the roster that path is disallowed and Archons are merged as normal, the
// same "fallback only when the parent is missing" rule as the larva builds.
void RosterEnforce_GateArchonFallback(int player, int whichRoster) {
    if (RosterEnforce_IsAllowed(whichRoster, "HighTemplar")
        || RosterEnforce_IsAllowed(whichRoster, "DarkTemplar")) {
        TechTreeAbilityAllow(player, AbilityCommand("GatewayTrain", 7), false);    // Train8
        TechTreeAbilityAllow(player, AbilityCommand("WarpGateTrain", 7), false);   // Train8
    }
}

//--------------------------------------------------------------------------------------------------
// Zerg larva fallbacks (AbilData.xml LarvaTrain Train6/9/14/16) let a morph unit
// be built straight from larva when its parent wasn't drafted. Each button sits
// on its PARENT's cell of the Larva card (UnitData.xml), which only works if the
// two never show at once:
//   - parent undrafted: TechTreeUnitAllow(false) above removes the parent's
//     button, so the fallback has the cell to itself;
//   - parent drafted: the fallback is disallowed here, so the cell shows the
//     parent and the child is morphed from it the normal way.
// Before this gate, a drafted parent and a drafted child competed for one cell.
//
// Command indices are zero-based positions in LarvaTrain's InfoArray, so
// "TrainN" is command N-1.
//--------------------------------------------------------------------------------------------------
void RosterEnforce_GateLarvaFallback(int player, int whichRoster, string parent, int trainCmd) {
    if (RosterEnforce_IsAllowed(whichRoster, parent)) {
        TechTreeAbilityAllow(player, AbilityCommand("LarvaTrain", trainCmd), false);
    }
}

void RosterEnforce_GateLarvaFallbacks(int player, int whichRoster) {
    RosterEnforce_GateLarvaFallback(player, whichRoster, "Roach",     5);   // Train6  Ravager
    RosterEnforce_GateLarvaFallback(player, whichRoster, "Hydralisk", 8);   // Train9  Lurker
    RosterEnforce_GateLarvaFallback(player, whichRoster, "Corruptor", 13);  // Train14 Brood Lord
    RosterEnforce_GateLarvaFallback(player, whichRoster, "Zergling",  15);  // Train16 Baneling
}

// Disable every non-allowed master unit for a single player.
void RosterEnforce_ApplyToPlayer(int player, int race, int whichRoster) {
    int    n;
    int    i;
    string unitType;

    if (race == c_tardigrade_raceTerran)      { n = g_enfTerranN; }
    else if (race == c_tardigrade_raceProtoss) { n = g_enfProtossN; }
    else                                      { n = g_enfZergN; }

    i = 1;
    while (i <= n) {
        if (race == c_tardigrade_raceTerran)       { unitType = g_enfTerran[i]; }
        else if (race == c_tardigrade_raceProtoss) { unitType = g_enfProtoss[i]; }
        else                                      { unitType = g_enfZerg[i]; }

        if (!RosterEnforce_IsAllowed(whichRoster, unitType)) {
            TechTreeUnitAllow(player, unitType, false);
        }
        i = i + 1;
    }

    if (race == c_tardigrade_raceZerg) {
        RosterEnforce_GateLarvaFallbacks(player, whichRoster);
    } else if (race == c_tardigrade_raceProtoss) {
        RosterEnforce_GateArchonFallback(player, whichRoster);
    }
    RosterEnforce_GateTransforms(player, race, whichRoster);
}

// Apply enforcement to every player in a team.
void RosterEnforce_ApplyToTeam(playergroup team, int race, int whichRoster) {
    int count;
    int i;
    int p;

    count = PlayerGroupCount(team);
    i = 1;
    while (i <= count) {
        p = PlayerGroupPlayer(team, i);
        RosterEnforce_ApplyToPlayer(p, race, whichRoster);
        i = i + 1;
    }
}

// Public: enforce both teams' rosters. Called at game start.
void RosterEnforce_ApplyAll() {
    playergroup p1Team;
    playergroup p2Team;

    RosterEnforce_InitLists();

    // g_draft_p1 (the banner) is P1; map it to its team.
    if (g_draft_p1_is_team1) {
        p1Team = g_draft_team1;
        p2Team = g_draft_team2;
    } else {
        p1Team = g_draft_team2;
        p2Team = g_draft_team1;
    }

    RosterEnforce_ApplyToTeam(p1Team, g_roster_p1Race, 1);
    if (g_roster_p2 != g_roster_p1) {
        RosterEnforce_ApplyToTeam(p2Team, g_roster_p2Race, 2);
    }

    Debug_Log("Roster enforcement applied to both teams.");
}
