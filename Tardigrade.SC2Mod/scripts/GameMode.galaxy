//--------------------------------------------------------------------------------------------------
// Game Modes
//
// Chosen once, on the setup screen (see GameMode_Select), by the first human
// decider (see RaceDraft_Setup). Everything else in the mod reads g_game_mode,
// the roster and the modifier choice through the GameMode_Is* helpers below.
//
//   Casual     - the draft as it always was: no time limits, normal game.
//   Tournament - every draft step (race ban/pick, modifier ban/pick, unit
//                pick/ban) has a c_tournamentStepSeconds limit. A click only
//                SELECTS a card; Confirm takes it. When the clock runs out
//                the selection is taken, or a random legal option if there
//                is none (see DRAFT SELECTION below).
//   Testing    - no draft at all. Everyone keeps their lobby town hall, gets one
//                SCV, one Probe and one Drone, a huge bank, instant build times
//                and every unit unlocked, plus a panel to switch modifiers on
//                and off for their own side at will (TestingMode.galaxy).
//
// Included before RaceDraft, so it can only lean on natives and DraftStyle:
// every dialog here addresses PlayerGroupAll() directly, which is exactly what
// Tardigrade_Viewers() returns anyway (see Tardigrade_RefreshViewerGroups).
//--------------------------------------------------------------------------------------------------

const int c_gameModeCasual     = 0;
const int c_gameModeTournament = 1;
const int c_gameModeTesting    = 2;

// Real seconds per draft step in Tournament mode. The draft runs with mission
// time paused, so this is counted in real time (see DraftTimer_Run).
const int c_tournamentStepSeconds = 15;

int g_game_mode = c_gameModeCasual;

// The other two setup choices. Defaults: Alternating draft (not full roster) and
// Free draft (not buckets). They only mean something outside Testing, which has
// no draft - the helpers say so.
bool g_game_fullRoster = false;
bool g_game_buckets    = false;

bool GameMode_IsTournament() { return g_game_mode == c_gameModeTournament; }
bool GameMode_IsTesting()    { return g_game_mode == c_gameModeTesting; }
// Full roster: no unit draft, every unit allowed (see RosterEnforce_ApplyFullRoster).
bool GameMode_IsFullRoster() { return g_game_fullRoster && g_game_mode != c_gameModeTesting; }
// Buckets: the bucket draft - one ban in each bucket, then four picks a side, one
// per bucket (CycleMod_Bucket; see CycleMod_OpenBucketBoard).
bool GameMode_IsBuckets()    { return g_game_buckets && g_game_mode != c_gameModeTesting; }

// The three stages a side can go YOLO in, each separately (CycleMod_SideIsYolo).
const int c_stageRace   = 0;
const int c_stageMod    = 1;
const int c_stageRoster = 2;

string GameMode_Name(int mode) {
    if (mode == c_gameModeTournament) { return "Tournament"; }
    if (mode == c_gameModeTesting)    { return "Testing"; }
    return "Casual";
}

string GameMode_Desc(int mode) {
    if (mode == c_gameModeTournament) {
        return IntToString(c_tournamentStepSeconds) + "s per draft step: select, then Confirm";
    }
    if (mode == c_gameModeTesting) { return "no draft: huge bank, instant builds, all units"; }
    return "normal draft, no time limits";
}

//==================================================================================================
// SETUP SCREEN
//
// One dialog, shown to the decider (g_draft_modeChooser), with three rows and a
// Start button:
//   Mode       Casual / Tournament / Testing
//   Roster     Full roster (every unit allowed, no unit draft) / Alternating draft
//   Modifiers  Buckets (one modifier per bucket) / Free draft (ban 2, pick 3)
// Defaults: Casual, Alternating draft, Free draft. A click selects an option
// (the chosen card is drawn as SELECTED), Start commits. Everyone else sees the
// same dialog disabled and updating live. Testing has no draft, so the Roster
// and Modifiers rows are greyed out while it is selected.
//
// The choices live in g_game_mode / g_game_fullRoster / g_game_buckets and are
// read through the helpers above. They are written straight from the clicks (the
// dialog IS the pending state); only the callback waits for Start.
//==================================================================================================
int     g_gmode_dialog   = c_invalidDialogId;
int     g_gmode_label    = c_invalidDialogControlId;
int[3]  g_gmode_btn;                 // [0..2] mode cards, indexed by c_gameMode*
int[2]  g_gmode_rosterBtn;           // [0] Full roster, [1] Alternating draft
int[2]  g_gmode_modBtn;              // [0] Buckets, [1] Free draft
int     g_gmode_start    = c_invalidDialogControlId;
int     g_gmode_chooser  = 0;
trigger g_gmode_trigger  = null;
trigger g_gmode_callback = null;

string GameMode_RosterName(bool full) {
    if (full) { return "Full roster"; }
    return "Alternating draft";
}

string GameMode_RosterDesc(bool full) {
    if (full) { return "every unit allowed - no unit draft"; }
    return "pick and ban 6 units each";
}

string GameMode_ModsName(bool buckets) {
    if (buckets) { return "Buckets"; }
    return "Free draft";
}

string GameMode_ModsDesc(bool buckets) {
    if (buckets) { return "4 buckets: one ban in each, then one pick from each"; }
    return "ban 2, pick 3 from the whole pool";
}

// One option card for both audiences. chosen = the selected option of its row;
// greyed = the row is switched off (Testing). Only the decider can click, and
// only on a live row.
void GameMode_SetupDrawCard(int control, bool chosen, bool greyed, string name, string desc) {
    playergroup mine;
    playergroup others;
    int         state;
    string      tag;

    mine   = PlayerGroupSingle(g_gmode_chooser);
    others = PlayerGroupCopy(PlayerGroupAll());
    PlayerGroupRemove(others, g_gmode_chooser);

    tag = "CHOSEN";
    if (greyed) {
        state = c_draftStateTaken;
        tag = "N/A";
    } else if (chosen) {
        state = c_draftStateSelected;
    } else {
        state = c_draftStateOpen;
        tag = "";
    }
    DraftStyle_ApplyCard(control, mine, state, DraftStyle_Card(state, tag, name, desc), true);
    DraftStyle_ApplyCard(control, others, state, DraftStyle_Card(state, tag, name, desc), false);
}

void GameMode_SetupRefresh() {
    bool greyed;
    int  i;

    greyed = (g_game_mode == c_gameModeTesting);
    i = 0;
    while (i <= 2) {
        GameMode_SetupDrawCard(g_gmode_btn[i], g_game_mode == i, false,
            GameMode_Name(i), GameMode_Desc(i));
        i = i + 1;
    }
    GameMode_SetupDrawCard(g_gmode_rosterBtn[0], g_game_fullRoster, greyed,
        GameMode_RosterName(true), GameMode_RosterDesc(true));
    GameMode_SetupDrawCard(g_gmode_rosterBtn[1], !g_game_fullRoster, greyed,
        GameMode_RosterName(false), GameMode_RosterDesc(false));
    GameMode_SetupDrawCard(g_gmode_modBtn[0], g_game_buckets, greyed,
        GameMode_ModsName(true), GameMode_ModsDesc(true));
    GameMode_SetupDrawCard(g_gmode_modBtn[1], !g_game_buckets, greyed,
        GameMode_ModsName(false), GameMode_ModsDesc(false));
}

bool GameMode_OnClicked(bool testConds, bool runActions) {
    int control;
    int i;

    if (EventPlayer() != g_gmode_chooser) { return true; }
    control = EventDialogControl();

    if (control == g_gmode_start) {
        DraftStyle_ClickCue(PlayerGroupSingle(EventPlayer()));
        if (g_gmode_trigger != null) { TriggerDestroy(g_gmode_trigger); g_gmode_trigger = null; }
        DialogDestroy(g_gmode_dialog);
        g_gmode_dialog = c_invalidDialogId;
        if (g_gmode_callback != null) {
            TriggerExecute(g_gmode_callback, false, false);
        }
        return true;
    }

    i = 0;
    while (i <= 2) {
        if (control == g_gmode_btn[i]) {
            DraftStyle_ClickCue(PlayerGroupSingle(EventPlayer()));
            g_game_mode = i;
            GameMode_SetupRefresh();
            return true;
        }
        i = i + 1;
    }

    // The Roster and Modifiers rows do nothing while Testing is selected.
    if (g_game_mode == c_gameModeTesting) { return true; }
    if (control == g_gmode_rosterBtn[0] || control == g_gmode_rosterBtn[1]) {
        DraftStyle_ClickCue(PlayerGroupSingle(EventPlayer()));
        g_game_fullRoster = (control == g_gmode_rosterBtn[0]);
    } else if (control == g_gmode_modBtn[0] || control == g_gmode_modBtn[1]) {
        DraftStyle_ClickCue(PlayerGroupSingle(EventPlayer()));
        g_game_buckets = (control == g_gmode_modBtn[0]);
    } else {
        return true;
    }
    GameMode_SetupRefresh();
    return true;
}

// A row's heading label, same text for everyone.
void GameMode_SetupRowLabel(string heading, int y) {
    int lbl;
    lbl = DialogControlCreate(g_gmode_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(lbl, PlayerGroupAll(), 540, 18);
    DialogControlSetPosition(lbl, PlayerGroupAll(), c_anchorTop, 0, y);
    DialogControlSetPropertyAsText(lbl, c_triggerControlPropertyText, PlayerGroupAll(),
        StringToText(DraftStyle_Small("<c val=\"7FD0FF\">" + heading + "</c>")));
}

// One option button at (x, y) of the given width.
int GameMode_SetupButton(int x, int y, int width) {
    int btn;
    btn = DialogControlCreate(g_gmode_dialog, c_triggerControlTypeButton);
    DraftStyle_InitButton(btn, PlayerGroupAll());
    DialogControlSetSize(btn, PlayerGroupAll(), width, 60);
    DialogControlSetPosition(btn, PlayerGroupAll(), c_anchorTop, x, y);
    return btn;
}

// Show the setup screen. Only `chooser` can click; everyone else sees the same
// dialog disabled (a spectator only ever sees a dialog through the player they
// are watching - Tardigrade_ObservableDialog - so nobody gets a blank screen).
// `callback` runs once the chooser presses Start. No Tournament clock here.
void GameMode_Select(int chooser, trigger callback) {
    playergroup all;
    playergroup mine;
    playergroup others;
    int         i;

    g_gmode_chooser  = chooser;
    g_gmode_callback = callback;
    all    = PlayerGroupAll();
    mine   = PlayerGroupSingle(chooser);
    others = PlayerGroupCopy(PlayerGroupAll());
    PlayerGroupRemove(others, chooser);

    g_gmode_dialog = DialogCreate(600, 520, c_anchorCenter, 0, 0, true);
    DialogSetObservedType(g_gmode_dialog, c_triggerObservedTypeObservedOrSelectedPlayerId);
    DialogSetTitle(g_gmode_dialog, StringToText("Tardigrade  -  Setup"));
    DialogSetVisible(g_gmode_dialog, all, true);

    g_gmode_label = DialogControlCreate(g_gmode_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_gmode_label, all, 540, 24);
    DialogControlSetPosition(g_gmode_label, all, c_anchorTop, 0, 50);
    DialogControlSetPropertyAsText(g_gmode_label, c_triggerControlPropertyText, mine,
        StringToText("<c val=\"00FF88\">Choose the setup, then press Start</c>"));
    DialogControlSetPropertyAsText(g_gmode_label, c_triggerControlPropertyText, others,
        StringToText("<c val=\"888888\">Player " + IntToString(chooser)
            + " is setting up...</c>"));

    GameMode_SetupRowLabel("MODE", 86);
    i = 0;
    while (i <= 2) {
        g_gmode_btn[i] = GameMode_SetupButton(-190 + i * 190, 106, 180);
        i = i + 1;
    }

    GameMode_SetupRowLabel("ROSTER", 184);
    g_gmode_rosterBtn[0] = GameMode_SetupButton(-145, 204, 280);
    g_gmode_rosterBtn[1] = GameMode_SetupButton( 145, 204, 280);

    GameMode_SetupRowLabel("MODIFIERS", 282);
    g_gmode_modBtn[0] = GameMode_SetupButton(-145, 302, 280);
    g_gmode_modBtn[1] = GameMode_SetupButton( 145, 302, 280);

    g_gmode_start = DialogControlCreate(g_gmode_dialog, c_triggerControlTypeButton);
    DraftStyle_InitButton(g_gmode_start, all);
    DialogControlSetSize(g_gmode_start, all, 300, 56);
    DialogControlSetPosition(g_gmode_start, all, c_anchorTop, 0, 410);
    DraftStyle_ApplyCard(g_gmode_start, mine, c_draftStateOpen,
        DraftStyle_Card(c_draftStateOpen, "", "Start", "begin the draft"), true);
    DraftStyle_ApplyCard(g_gmode_start, others, c_draftStateOpen,
        DraftStyle_Card(c_draftStateOpen, "", "Start", "waiting for the host..."), false);

    GameMode_SetupRefresh();

    g_gmode_trigger = TriggerCreate("GameMode_OnClicked");
    i = 0;
    while (i <= 2) {
        TriggerAddEventDialogControl(g_gmode_trigger, c_playerAny, g_gmode_btn[i],
            c_triggerControlEventTypeClick);
        i = i + 1;
    }
    i = 0;
    while (i <= 1) {
        TriggerAddEventDialogControl(g_gmode_trigger, c_playerAny, g_gmode_rosterBtn[i],
            c_triggerControlEventTypeClick);
        TriggerAddEventDialogControl(g_gmode_trigger, c_playerAny, g_gmode_modBtn[i],
            c_triggerControlEventTypeClick);
        i = i + 1;
    }
    TriggerAddEventDialogControl(g_gmode_trigger, c_playerAny, g_gmode_start,
        c_triggerControlEventTypeClick);
    DraftStyle_TurnCuePlayer(chooser);
}


//==================================================================================================
// DRAFT TIMER (Tournament)
//
// One persistent thread for the whole draft, not one per step. Each draft
// screen calls DraftTimer_Arm(onExpire) as it starts a new step; that resets
// the clock to c_tournamentStepSeconds and remembers which auto-pick to run.
// When it reaches zero the thread disarms and runs onExpire, which takes the
// player's selection, or a random legal option, through the same path a
// click would - and that path arms the timer again for the next step. A
// per-step thread would need a token to tell a stale countdown from the live
// one; a single thread with a deadline has nothing to go stale.
//
// Counted in real time in 0.25s ticks: the draft runs with mission time
// paused, and c_timeGame waits do not advance while it is (see
// Tardigrade_Countdown).
//--------------------------------------------------------------------------------------------------
bool    g_dtimer_running = false;
bool    g_dtimer_armed   = false;
fixed   g_dtimer_left    = 0.0;
trigger g_dtimer_expire  = null;
string  g_dtimer_note    = "";       // what happens at zero, shown after the seconds
int     g_dtimer_dialog  = c_invalidDialogId;
int     g_dtimer_label   = c_invalidDialogControlId;
int     g_dtimer_btnConfirm = c_invalidDialogControlId;

//==================================================================================================
// DRAFT SELECTION (Tournament)
//
// On the clock, a click on a card only SELECTS it - marked [>] SELECTED, for
// the clicking player only - and the step is taken by the Confirm button on
// the timer bar. When the clock runs out, the selection is taken; with none,
// a random legal option, as before. So a player can mark a choice early and
// keep thinking without risking a random pick.
//
//   nothing selected, clock runs out   ->  random (the screen's own fallback)
//   something selected, clock runs out ->  the selection
//   something selected, Confirm        ->  the selection, now
//
// Kept per player, because the drafting-style screen is simultaneous: both
// players can hold a selection at once. Every DraftTimer_Arm* clears them all,
// so a new step starts blank. Steps armed with DraftTimer_ArmFor (the Protect
// stage, which has its own Done button) take clicks directly, as before.
//
// A draft screen's part: in its click handler, DraftSelect_Active() decides
// between DraftSelect_Pick (select) and acting at once; its onExpire reads
// DraftSelect_Of(the player who is up). Only open or ban-target cards can be
// selected, and a step's legal options cannot change until it is taken, so a
// selection is still legal when the clock or Confirm takes it.
//--------------------------------------------------------------------------------------------------
bool[16]   g_dsel_has;
int[16]    g_dsel_value;
int[16]    g_dsel_control;
int[16]    g_dsel_openState;     // the card's state before it was selected
string[16] g_dsel_name;
string[16] g_dsel_detail;
bool       g_dsel_mode      = false;  // this step takes select + Confirm
trigger    g_dsel_confirm   = null;   // run when a player clicks Confirm
int        g_dsel_confirmer = 0;      // ...and which player that was

// True when a click on a card should select it rather than take it.
bool DraftSelect_Active() {
    return GameMode_IsTournament() && g_dsel_mode && g_dtimer_armed;
}

// The player's selection, or -1 if they have none.
int DraftSelect_Of(int player) {
    if (!g_dsel_has[player]) { return -1; }
    return g_dsel_value[player];
}

// The player who clicked Confirm - for an onConfirm that is not simply the
// step's onExpire (the simultaneous drafting-style screen).
int DraftSelect_Confirmer() {
    return g_dsel_confirmer;
}

void DraftSelect_Draw(int player) {
    string tag;
    tag = "";
    if (g_dsel_openState[player] == c_draftStateBanTarget) { tag = "SELECTED TO BAN"; }
    DraftStyle_ApplyCard(g_dsel_control[player], PlayerGroupSingle(player), c_draftStateSelected,
        DraftStyle_Card(c_draftStateSelected, tag, g_dsel_name[player], g_dsel_detail[player]), true);
}

// Put a previously selected card back the way the screen drew it.
void DraftSelect_Undraw(int player) {
    DraftStyle_ApplyCard(g_dsel_control[player], PlayerGroupSingle(player),
        g_dsel_openState[player],
        DraftStyle_Card(g_dsel_openState[player], "", g_dsel_name[player], g_dsel_detail[player]),
        true);
}

// Select a card for player. value is what the screen's own choose function
// takes; openState / name / detail are how the screen draws the card, so it
// can be drawn back when the player selects another one.
void DraftSelect_Pick(int player, int value, int control, int openState, string name, string detail) {
    DraftStyle_ClickCue(PlayerGroupSingle(player));
    if (g_dsel_has[player]) {
        if (g_dsel_control[player] == control) { return; }
        DraftSelect_Undraw(player);
    }
    g_dsel_has[player]       = true;
    g_dsel_value[player]     = value;
    g_dsel_control[player]   = control;
    g_dsel_openState[player] = openState;
    g_dsel_name[player]      = name;
    g_dsel_detail[player]    = detail;
    DraftSelect_Draw(player);
    if (g_dtimer_btnConfirm != c_invalidDialogControlId) {
        DialogControlSetEnabled(g_dtimer_btnConfirm, PlayerGroupSingle(player), true);
    }
}

// Forget a player's selection without redrawing anything - for when their
// part of the step is over and the screen has been (or is about to be) redrawn.
void DraftSelect_Drop(int player) {
    g_dsel_has[player] = false;
    if (g_dtimer_btnConfirm != c_invalidDialogControlId) {
        DialogControlSetEnabled(g_dtimer_btnConfirm, PlayerGroupSingle(player), false);
    }
}

void DraftSelect_ClearAll() {
    int p;
    p = 0;
    while (p <= 15) {
        g_dsel_has[p] = false;
        p = p + 1;
    }
    if (g_dtimer_btnConfirm != c_invalidDialogControlId) {
        DialogControlSetEnabled(g_dtimer_btnConfirm, PlayerGroupAll(), false);
    }
}

// Redraw every live selection - after a screen redrew its board mid-step
// (one player locking in on the simultaneous drafting-style screen).
void DraftSelect_Reapply() {
    int p;
    p = 0;
    while (p <= 15) {
        if (g_dsel_has[p]) { DraftSelect_Draw(p); }
        p = p + 1;
    }
}

bool DraftSelect_OnConfirm(bool testConds, bool runActions) {
    int p;
    p = EventPlayer();
    if (!DraftSelect_Active() || !g_dsel_has[p] || g_dsel_confirm == null) { return true; }
    g_dsel_confirmer = p;
    TriggerExecute(g_dsel_confirm, false, true);
    return true;
}

//--------------------------------------------------------------------------------------------------

void DraftTimer_Show(bool visible) {
    if (g_dtimer_dialog == c_invalidDialogId) { return; }
    DialogSetVisible(g_dtimer_dialog, PlayerGroupAll(), visible);
}

bool DraftTimer_Run(bool testConds, bool runActions) {
    int     secs;
    int     p;
    string  head;
    trigger expire;

    while (g_dtimer_running) {
        if (g_dtimer_armed) {
            if (g_dtimer_left <= 0.0) {
                g_dtimer_armed = false;
                DraftTimer_Show(false);
                expire = g_dtimer_expire;
                if (expire != null) {
                    // Wait for it: the auto-pick re-arms the timer for the
                    // next step, and that has to land before the next tick.
                    TriggerExecute(expire, false, true);
                }
            } else {
                secs = FixedToInt(g_dtimer_left + 0.99);
                head = "<c val=\"FFD54A\">TOURNAMENT</c>   "
                    + "<c val=\"FFFFFF\">" + IntToString(secs) + "s</c>";
                DialogControlSetPropertyAsText(g_dtimer_label, c_triggerControlPropertyText,
                    PlayerGroupAll(), StringToText(head
                        + "  <c val=\"AAAAAA\">left - " + g_dtimer_note + "</c>"));
                // A player holding a selection reads what the clock will take.
                if (g_dsel_mode) {
                    p = 0;
                    while (p <= 15) {
                        if (g_dsel_has[p]) {
                            DialogControlSetPropertyAsText(g_dtimer_label,
                                c_triggerControlPropertyText, PlayerGroupSingle(p),
                                StringToText(head + "  <c val=\"AAAAAA\">left - then</c> "
                                    + "<c val=\"FFD54A\">" + g_dsel_name[p] + "</c>"));
                        }
                        p = p + 1;
                    }
                }
                g_dtimer_left = g_dtimer_left - 0.25;
            }
        }
        Wait(0.25, c_timeReal);
    }
    return true;
}

// Start (or restart) the countdown for the step that is now up. onConfirm is
// what the Confirm button runs; null means this step takes clicks directly
// and the button is hidden. No-op outside Tournament mode, so every draft
// screen can call it unconditionally.
void DraftTimer_Start(trigger onExpire, int seconds, string note, trigger onConfirm) {
    trigger t;

    if (!GameMode_IsTournament()) { return; }

    if (g_dtimer_dialog == c_invalidDialogId) {
        // Label on the left, Confirm on the right.
        g_dtimer_dialog = DialogCreate(580, 52, c_anchorTop, 0, 90, false);
        DialogSetObservedType(g_dtimer_dialog, c_triggerObservedTypeObservedOrSelectedPlayerId);
        DialogSetImageVisible(g_dtimer_dialog, true);
        g_dtimer_label = DialogControlCreate(g_dtimer_dialog, c_triggerControlTypeLabel);
        DialogControlSetSize(g_dtimer_label, PlayerGroupAll(), 420, 30);
        DialogControlSetPosition(g_dtimer_label, PlayerGroupAll(), c_anchorLeft, 18, 0);

        g_dtimer_btnConfirm = DialogControlCreate(g_dtimer_dialog, c_triggerControlTypeButton);
        DraftStyle_InitButton(g_dtimer_btnConfirm, PlayerGroupAll());
        DialogControlSetSize(g_dtimer_btnConfirm, PlayerGroupAll(), 124, 36);
        DialogControlSetPosition(g_dtimer_btnConfirm, PlayerGroupAll(), c_anchorRight, 12, 0);
        DialogControlSetPropertyAsText(g_dtimer_btnConfirm, c_triggerControlPropertyText,
            PlayerGroupAll(), StringToText("<c val=\"FFD54A\">CONFIRM</c>"));
        t = TriggerCreate("DraftSelect_OnConfirm");
        TriggerAddEventDialogControl(t, c_playerAny, g_dtimer_btnConfirm,
            c_triggerControlEventTypeClick);
    }

    DraftSelect_ClearAll();
    g_dsel_mode    = (onConfirm != null);
    g_dsel_confirm = onConfirm;
    DialogControlSetVisible(g_dtimer_btnConfirm, PlayerGroupAll(), g_dsel_mode);

    g_dtimer_expire = onExpire;
    g_dtimer_left   = IntToFixed(seconds);
    g_dtimer_note   = note;
    g_dtimer_armed  = true;
    DraftTimer_Show(true);

    if (!g_dtimer_running) {
        g_dtimer_running = true;
        TriggerExecute(TriggerCreate("DraftTimer_Run"), false, false);
    }
}

// A step that takes clicks directly, with its own length and a note on what
// happens at zero (the Protect stage, which has a Done button of its own).
void DraftTimer_ArmFor(trigger onExpire, int seconds, string note) {
    DraftTimer_Start(onExpire, seconds, note, null);
}

// A select-then-Confirm step of c_tournamentStepSeconds, with its own Confirm
// action and note.
void DraftTimer_ArmPick(trigger onExpire, trigger onConfirm, string note) {
    DraftTimer_Start(onExpire, c_tournamentStepSeconds, note, onConfirm);
}

// The usual draft step: select, then Confirm; at zero, the selection or a
// random pick. onExpire does both jobs - it reads the selection of whoever is
// up, and only they can have one.
void DraftTimer_Arm(trigger onExpire) {
    DraftTimer_ArmPick(onExpire, onExpire, "then a random pick");
}

// Stop counting (a step finished some other way, e.g. the debug auto-run).
void DraftTimer_Disarm() {
    g_dtimer_armed = false;
    DraftSelect_ClearAll();
    DraftTimer_Show(false);
}

// The draft is over: stop the thread and drop the dialog.
void DraftTimer_Shutdown() {
    g_dtimer_armed   = false;
    g_dtimer_running = false;
    DraftSelect_ClearAll();
    if (g_dtimer_dialog != c_invalidDialogId) {
        DialogDestroy(g_dtimer_dialog);
        g_dtimer_dialog = c_invalidDialogId;
        g_dtimer_btnConfirm = c_invalidDialogControlId;
    }
}
