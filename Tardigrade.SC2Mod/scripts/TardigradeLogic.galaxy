//--------------------------------------------------------------------------------------------------
// Tardigrade Logic  (main orchestration)
//
// Pre-game chain, run on map init:
//
//   0. Game Mode     - Casual / Tournament / Testing, picked by team 1's human
//                      (GameMode.galaxy). Testing skips everything below and
//                      starts a sandbox (TestingMode.galaxy).
//   1. Draft style   - each side secretly chooses to draft normally, go YOLO
//                      or Protect and Ban (CycleMod_YoloChoice). A YOLO side's
//                      race ban/pick, modifiers and units are all random. A
//                      Protect and Ban side drafts race and modifiers normally
//                      and gets its units from the points stage in step 4.
//   2. Race Draft    - P1 bans a race, P2 picks, P1 gets the remainder.
//                      Each team is set to a single race.
//   3. Modifier Draft - each player bans 2 of 16 global modifiers, then picks
//                      3. Each pick is ALWAYS active in-game, but only for the
//                      drafting player's own units (no rotation, no phases).
//                      No Bans acts on step 4.
//   4. Unit Draft    - Protect and Ban sides first (ProtectDraft.galaxy): the
//                      side places points on its units, the opponent bans up to
//                      a points budget, the side keeps the rest. Then, for the
//                      others: opening picks, bans, final picks; each side ends
//                      with 6 units (7 for YOLO). Enforced in-game.
//
// In Tournament mode every draft step above has a time limit, and a click only
// selects; Confirm takes the selection. At zero the selection is taken, or a
// random legal choice if there is none (GameMode.galaxy, DRAFT SELECTION).
//
// Then a summary screen (both rosters and modifier sets) counts down 30s -
// 3s once both players click Ready; a YOLO side may reroll its units there, one
// fewer each time, which restarts the 30s. Workers spawn and start mining, and
// the game begins with rosters enforced and the modifiers running.
//--------------------------------------------------------------------------------------------------

include "scripts/Debug"
include "scripts/DraftStyle"
include "scripts/GameMode"
include "scripts/RaceDraft"
include "scripts/CycleMod"
include "scripts/RosterDraft"
include "scripts/ProtectDraft"
include "scripts/RosterEnforce"
include "scripts/TestingMode"

//--------------------------------------------------------------------------------------------------
// Draft summary + countdown, shown between the draft and the game (real time,
// still paused): both sides' race, modifiers and units side by side, with the
// clock ticking down above them.
//
// Each side's decider has a READY button. It stays pressed once clicked; when
// both sides are ready the clock drops to c_tardigradeReadyCountdown. A YOLO
// side's decider also has a REROLL button under its column: a new random
// roster one unit smaller (RosterDraft_RerollYolo), which restarts the full
// countdown and un-readies both sides, since the opponent is now looking at a
// different roster.
//--------------------------------------------------------------------------------------------------
const int c_tardigradeCountdown      = 30;  // real seconds
const int c_tardigradeReadyCountdown = 3;   // real seconds, once both are ready

int     g_sum_dialog     = c_invalidDialogId;
int     g_sum_lblClock   = c_invalidDialogControlId;
int     g_sum_lblStatus  = c_invalidDialogControlId;
int     g_sum_lblP1      = c_invalidDialogControlId;
int     g_sum_lblP2      = c_invalidDialogControlId;
int     g_sum_btnReady   = c_invalidDialogControlId;
int     g_sum_btnRerollP1 = c_invalidDialogControlId;
int     g_sum_btnRerollP2 = c_invalidDialogControlId;
trigger g_sum_trigger    = null;
fixed   g_sum_left       = 0.0;
bool    g_sum_readyP1    = false;
bool    g_sum_readyP2    = false;
int     g_sum_rerollsP1  = 0;
int     g_sum_rerollsP2  = 0;

// One side's column: race, modifiers (name + what it does), units.
string Tardigrade_SummaryColumn(bool isP1) {
    string s;
    string col;
    string tag;
    int    race;
    int    count;
    int    idx;
    int    i;
    int    rerolls;

    if (isP1) { col = "7FD0FF"; tag = "P1"; race = g_roster_p1Race; count = g_cycle_p1Count; rerolls = g_sum_rerollsP1; }
    else      { col = "FF9F7F"; tag = "P2"; race = g_roster_p2Race; count = g_cycle_p2Count; rerolls = g_sum_rerollsP2; }

    s = "<c val=\"" + col + "\">" + tag + "  " + c_draftDot + "  " + RaceName(race) + "</c>";
    if (CycleMod_SideIsYolo(isP1)) {
        s = s + "   <c val=\"FFD54A\">YOLO</c>";
        if (rerolls > 0) {
            s = s + "  <c val=\"AAAAAA\">(rerolled x" + IntToString(rerolls) + ")</c>";
        }
    }
    if (CycleMod_SideIsProtect(isP1)) { s = s + "   <c val=\"FFD54A\">PROTECT AND BAN</c>"; }

    s = s + "\n\n<c val=\"FFD54A\">MODIFIERS</c>";
    i = 1;
    while (i <= count) {
        if (isP1) { idx = CycleMod_P1Mod(i); } else { idx = CycleMod_P2Mod(i); }
        s = s + "\n" + CycleMod_Name(idx)
            + "\n" + DraftStyle_Small("<c val=\"AAAAAA\">" + CycleMod_Desc(idx) + "</c>");
        i = i + 1;
    }
    if (count == 0) { s = s + "\n<c val=\"7A7A7A\">none</c>"; }

    s = s + "\n\n<c val=\"FFD54A\">UNITS</c>  <c val=\"7A7A7A\">(" + IntToString(RosterDraft_Count(isP1)) + ")</c>";
    i = 1;
    while (i <= c_rosterMaxSize) {
        if (isP1) {
            if (g_roster_p1Units[i] != "") { s = s + "\n" + RosterUnitDisplayName(g_roster_p1Units[i]); }
        } else {
            if (g_roster_p2Units[i] != "") { s = s + "\n" + RosterUnitDisplayName(g_roster_p2Units[i]); }
        }
        i = i + 1;
    }
    return s;
}

// Is this side's decider ready? With one human deciding both sides, one click
// readies both.
string Tardigrade_SummaryReadyText(bool ready) {
    if (ready) { return "<c val=\"4ADB92\">READY</c>"; }
    return "<c val=\"888888\">not ready</c>";
}

// A decider's READY button: live until clicked, then locked in.
void Tardigrade_SummaryReadyButton(int player, bool ready) {
    playergroup viewer;
    viewer = PlayerGroupSingle(player);
    if (ready) {
        DraftStyle_ApplyCard(g_sum_btnReady, viewer, c_draftStateMine,
            DraftStyle_Card(c_draftStateMine, "READY", "Ready", "waiting for your opponent..."), false);
    } else {
        DraftStyle_ApplyCard(g_sum_btnReady, viewer, c_draftStateOpen,
            DraftStyle_Card(c_draftStateOpen, "", "Ready",
                "starts in " + IntToString(c_tardigradeReadyCountdown) + "s once both players are ready"), true);
    }
}

// A YOLO side's REROLL button, for its decider only.
void Tardigrade_SummaryRerollButton(int btn, bool isP1) {
    playergroup viewer;
    int         count;

    DialogControlSetVisible(btn, Tardigrade_Viewers(), false);
    if (!CycleMod_SideIsYolo(isP1)) { return; }
    if (isP1) { viewer = PlayerGroupSingle(g_draft_p1); } else { viewer = PlayerGroupSingle(g_draft_p2); }

    count = RosterDraft_Count(isP1);
    if (count > 1) {
        DraftStyle_ApplyCard(btn, viewer, c_draftStateOpen,
            DraftStyle_Card(c_draftStateOpen, "", "Reroll units",
                "new random roster of " + IntToString(count - 1) + " (one fewer)"), true);
    } else {
        DraftStyle_ApplyCard(btn, viewer, c_draftStateTaken,
            DraftStyle_Card(c_draftStateTaken, "", "Reroll units", "can't go below 1 unit"), false);
    }
}

// A decider who has not readied up is told what the button does.
void Tardigrade_SummaryReadyHint(int player, bool ready) {
    if (ready) { return; }
    DialogControlSetPropertyAsText(g_sum_lblStatus, c_triggerControlPropertyText,
        PlayerGroupSingle(player), StringToText(DraftStyle_Small(
            "<c val=\"FFD54A\">Click READY to start now</c>      <c val=\"7FD0FF\">P1</c> "
            + Tardigrade_SummaryReadyText(g_sum_readyP1)
            + "      <c val=\"FF9F7F\">P2</c> " + Tardigrade_SummaryReadyText(g_sum_readyP2))));
}

void Tardigrade_SummaryRefresh() {
    DialogControlSetPropertyAsText(g_sum_lblP1, c_triggerControlPropertyText, Tardigrade_Viewers(),
        StringToText(Tardigrade_SummaryColumn(true)));
    DialogControlSetPropertyAsText(g_sum_lblP2, c_triggerControlPropertyText, Tardigrade_Viewers(),
        StringToText(Tardigrade_SummaryColumn(false)));
    DialogControlSetPropertyAsText(g_sum_lblStatus, c_triggerControlPropertyText, Tardigrade_Viewers(),
        StringToText(DraftStyle_Small("<c val=\"7FD0FF\">P1</c> " + Tardigrade_SummaryReadyText(g_sum_readyP1)
            + "      <c val=\"FF9F7F\">P2</c> " + Tardigrade_SummaryReadyText(g_sum_readyP2))));
    Tardigrade_SummaryReadyHint(g_draft_p1, g_sum_readyP1);
    if (g_draft_p2 != g_draft_p1) { Tardigrade_SummaryReadyHint(g_draft_p2, g_sum_readyP2); }

    DialogControlSetVisible(g_sum_btnReady, Tardigrade_Viewers(), false);
    Tardigrade_SummaryReadyButton(g_draft_p1, g_sum_readyP1);
    if (g_draft_p2 != g_draft_p1) {
        Tardigrade_SummaryReadyButton(g_draft_p2, g_sum_readyP2);
    }

    Tardigrade_SummaryRerollButton(g_sum_btnRerollP1, true);
    Tardigrade_SummaryRerollButton(g_sum_btnRerollP2, false);
}

bool Tardigrade_SummaryOnClicked(bool testConds, bool runActions) {
    int  player;
    int  control;
    bool rerolled;

    player  = EventPlayer();
    control = EventDialogControl();

    if (control == g_sum_btnReady) {
        if (player == g_draft_p1) { g_sum_readyP1 = true; }
        if (player == g_draft_p2) { g_sum_readyP2 = true; }
        if (g_sum_readyP1 && g_sum_readyP2 && g_sum_left > IntToFixed(c_tardigradeReadyCountdown)) {
            g_sum_left = IntToFixed(c_tardigradeReadyCountdown);
        }
    } else {
        // Nested, not &&-chained: the reroll itself must only run on a match.
        rerolled = false;
        if (control == g_sum_btnRerollP1 && player == g_draft_p1) {
            if (RosterDraft_RerollYolo(true)) {
                g_sum_rerollsP1 = g_sum_rerollsP1 + 1;
                rerolled = true;
            }
        }
        if (control == g_sum_btnRerollP2 && player == g_draft_p2) {
            if (RosterDraft_RerollYolo(false)) {
                g_sum_rerollsP2 = g_sum_rerollsP2 + 1;
                rerolled = true;
            }
        }
        if (!rerolled) { return true; }
        // A new roster: the full countdown again, and both look at it afresh.
        g_sum_readyP1 = false;
        g_sum_readyP2 = false;
        g_sum_left    = IntToFixed(c_tardigradeCountdown);
    }
    Tardigrade_SummaryRefresh();
    return true;
}

// Dialog layout (780 x 650): title, clock, ready status; the two columns
// (x -185 / +185, 350 wide); a REROLL under a YOLO side's column; READY at
// the bottom.
void Tardigrade_SummaryCountdown() {
    int lbl;
    int secs;
    int lastCue;

    g_sum_readyP1   = false;
    g_sum_readyP2   = false;
    g_sum_rerollsP1 = 0;
    g_sum_rerollsP2 = 0;

    g_sum_dialog = DialogCreate(780, 650, c_anchorCenter, 0, 0, true);
    Tardigrade_ObservableDialog(g_sum_dialog);
    DialogSetVisible(g_sum_dialog, Tardigrade_Viewers(), true);

    lbl = DialogControlCreate(g_sum_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(lbl, Tardigrade_Viewers(), 740, 26);
    DialogControlSetPosition(lbl, Tardigrade_Viewers(), c_anchorTop, 0, 18);
    DialogControlSetPropertyAsText(lbl, c_triggerControlPropertyText, Tardigrade_Viewers(),
        StringToText("<c val=\"FFD54A\">DRAFT COMPLETE</c>"));

    g_sum_lblClock = DialogControlCreate(g_sum_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sum_lblClock, Tardigrade_Viewers(), 740, 26);
    DialogControlSetPosition(g_sum_lblClock, Tardigrade_Viewers(), c_anchorTop, 0, 48);

    g_sum_lblStatus = DialogControlCreate(g_sum_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sum_lblStatus, Tardigrade_Viewers(), 740, 18);
    DialogControlSetPosition(g_sum_lblStatus, Tardigrade_Viewers(), c_anchorTop, 0, 76);

    g_sum_lblP1 = DialogControlCreate(g_sum_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sum_lblP1, Tardigrade_Viewers(), 350, 420);
    DialogControlSetPosition(g_sum_lblP1, Tardigrade_Viewers(), c_anchorTop, -185, 100);

    g_sum_lblP2 = DialogControlCreate(g_sum_dialog, c_triggerControlTypeLabel);
    DialogControlSetSize(g_sum_lblP2, Tardigrade_Viewers(), 350, 420);
    DialogControlSetPosition(g_sum_lblP2, Tardigrade_Viewers(), c_anchorTop, 185, 100);

    g_sum_btnRerollP1 = DialogControlCreate(g_sum_dialog, c_triggerControlTypeButton);
    DraftStyle_InitButton(g_sum_btnRerollP1, Tardigrade_Viewers());
    DialogControlSetSize(g_sum_btnRerollP1, Tardigrade_Viewers(), 300, 48);
    DialogControlSetPosition(g_sum_btnRerollP1, Tardigrade_Viewers(), c_anchorTop, -185, 530);

    g_sum_btnRerollP2 = DialogControlCreate(g_sum_dialog, c_triggerControlTypeButton);
    DraftStyle_InitButton(g_sum_btnRerollP2, Tardigrade_Viewers());
    DialogControlSetSize(g_sum_btnRerollP2, Tardigrade_Viewers(), 300, 48);
    DialogControlSetPosition(g_sum_btnRerollP2, Tardigrade_Viewers(), c_anchorTop, 185, 530);

    g_sum_btnReady = DialogControlCreate(g_sum_dialog, c_triggerControlTypeButton);
    DraftStyle_InitButton(g_sum_btnReady, Tardigrade_Viewers());
    DialogControlSetSize(g_sum_btnReady, Tardigrade_Viewers(), 320, 48);
    DialogControlSetPosition(g_sum_btnReady, Tardigrade_Viewers(), c_anchorTop, 0, 588);

    g_sum_trigger = TriggerCreate("Tardigrade_SummaryOnClicked");
    TriggerAddEventDialogControl(g_sum_trigger, c_playerAny, g_sum_btnReady, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(g_sum_trigger, c_playerAny, g_sum_btnRerollP1, c_triggerControlEventTypeClick);
    TriggerAddEventDialogControl(g_sum_trigger, c_playerAny, g_sum_btnRerollP2, c_triggerControlEventTypeClick);

    Tardigrade_SummaryRefresh();

    // Counted in 0.25s real-time ticks so READY and REROLL (which move
    // g_sum_left from the click trigger) take effect within a quarter second.
    lastCue = 99;
    g_sum_left = IntToFixed(c_tardigradeCountdown);
    while (g_sum_left > 0.0) {
        secs = FixedToInt(g_sum_left + 0.99);
        // Beep once as each of the last 3 whole seconds is reached; a reroll that
        // sends the clock back up re-arms it.
        if (secs > 3) { lastCue = 99; }
        else if (secs != lastCue) {
            DraftStyle_TurnCue(Tardigrade_Viewers());
            lastCue = secs;
        }
        if (g_sum_readyP1 && g_sum_readyP2) {
            DialogControlSetPropertyAsText(g_sum_lblClock, c_triggerControlPropertyText, Tardigrade_Viewers(),
                StringToText("<c val=\"00FF88\">Both ready  -  game starts in  " + IntToString(secs) + "</c>"));
        } else {
            DialogControlSetPropertyAsText(g_sum_lblClock, c_triggerControlPropertyText, Tardigrade_Viewers(),
                StringToText("<c val=\"FFD54A\">Game starts in  " + IntToString(secs) + "</c>"));
        }
        Wait(0.25, c_timeReal);
        g_sum_left = g_sum_left - 0.25;
    }

    // No more clicks from here: the rosters are final.
    TriggerDestroy(g_sum_trigger);
    g_sum_trigger = null;
    DialogControlSetPropertyAsText(g_sum_lblClock, c_triggerControlPropertyText,
        Tardigrade_Viewers(), StringToText("<c val=\"00FF88\">GO!</c>"));
    SoundPlayForPlayer(SoundLink("UI_Bnet_MatchCountdownGo", -1), c_maxPlayers,
        Tardigrade_Viewers(), 100.0, 0.0);
    Wait(0.7, c_timeReal);

    DialogDestroy(g_sum_dialog);
    g_sum_dialog = c_invalidDialogId;
}

//--------------------------------------------------------------------------------------------------
// Core game-start logic - shared by the normal draft chain and the debug auto-run.
//--------------------------------------------------------------------------------------------------
void Tardigrade_StartGame() {
    // The draft is over: no Tournament clock past this point.
    DraftTimer_Shutdown();

    // Catch any observer membership changes before constructing in-game HUDs.
    Tardigrade_RefreshViewerGroups();

    // Summary + countdown while still paused (so nothing can move yet). Only
    // the town hall has been on the map (unselectable) since the race draft
    // finished - see RaceDraft.galaxy SetPlayerRace / Tardigrade_DraftLock_Start.
    Tardigrade_SummaryCountdown();

    // Enforced after the summary, not before: a YOLO side can reroll its
    // roster there.
    RosterEnforce_ApplyAll();

    // Now that the countdown is done, spawn the workers + extra unit (e.g.
    // Overlord) for real and set them mining - nothing sits mining or
    // commandable while the draft UI was still up.
    Tardigrade_SpawnDeferredWorkers();

    // In-game roster reference HUD (toggle button + your 6 units).
    RosterHUD_Init();

    // Start the day/dusk/night cycle and unpause.
    CycleMod_StartCycle();
    GameSetMissionTimePaused(false);
    Tardigrade_DraftLock_Stop();
}

//--------------------------------------------------------------------------------------------------
// Debug: skip all draft UIs, randomly assign races / rosters / cycle, start game.
// Wired to the [DEBUG: Random All] button shown in RaceDraft in debug mode.
//--------------------------------------------------------------------------------------------------
bool Tardigrade_DebugAutoRun(bool testConds, bool runActions) {
    int banRace;
    int pickRace;
    int p1Race;
    int otherRace1;
    int otherRace2;
    int forcedRace;
    int t1Race;
    int t2Race;
    int usedMask;
    int poolCount;
    int pick;
    int pickCount;

    forcedRace = Debug_GetForcedRace();

    // If a forced race is set, lock P1 to that race and randomize the opponent.
    if (forcedRace >= c_tardigrade_raceTerran && forcedRace <= c_tardigrade_raceZerg) {
        p1Race = forcedRace;
        if (p1Race == c_tardigrade_raceTerran) {
            otherRace1 = c_tardigrade_raceProtoss; otherRace2 = c_tardigrade_raceZerg;
        } else if (p1Race == c_tardigrade_raceProtoss) {
            otherRace1 = c_tardigrade_raceTerran;  otherRace2 = c_tardigrade_raceZerg;
        } else {
            otherRace1 = c_tardigrade_raceTerran;  otherRace2 = c_tardigrade_raceProtoss;
        }
        if (RandomInt(0, 1) == 0) { pickRace = otherRace1; } else { pickRace = otherRace2; }
        if (pickRace == otherRace1) { banRace = otherRace2; } else { banRace = otherRace1; }
    } else {
        // Random race: ban one, P2 picks one of the remaining two, P1 gets the third.
        banRace = RandomInt(1, 3);
        if (banRace == c_tardigrade_raceTerran) {
            otherRace1 = c_tardigrade_raceProtoss; otherRace2 = c_tardigrade_raceZerg;
        } else if (banRace == c_tardigrade_raceProtoss) {
            otherRace1 = c_tardigrade_raceTerran;  otherRace2 = c_tardigrade_raceZerg;
        } else {
            otherRace1 = c_tardigrade_raceTerran;  otherRace2 = c_tardigrade_raceProtoss;
        }
        if (RandomInt(0, 1) == 0) { pickRace = otherRace1; p1Race = otherRace2; }
        else                       { pickRace = otherRace2; p1Race = otherRace1; }
    }
    Debug_SetForcedRace(0);

    if (g_draft_p1_is_team1) { t1Race = p1Race; t2Race = pickRace; }
    else                     { t1Race = pickRace; t2Race = p1Race; }
    SetTeamRace(g_draft_team1, t1Race);
    SetTeamRace(g_draft_team2, t2Race);
    g_draft_bannedRace = banRace;
    g_draft_p1Race     = p1Race;
    g_draft_p2Race     = pickRace;

    // Roster globals (normally set by RosterDraft_Start).
    g_roster_p1     = g_draft_p1;
    g_roster_p2     = g_draft_p2;
    g_roster_p1Race = g_draft_p1Race;
    g_roster_p2Race = g_draft_p2Race;

    // Random modifiers first - YOLO changes how the rosters below are dealt.
    // 6 distinct picks - 3 per player (picker-only in draft mode).
    g_cycle_p1      = g_draft_p1;
    g_cycle_p2      = g_draft_p2;
    g_cycle_p1Count = 0;
    g_cycle_p2Count = 0;
    // YOLO is a meta pick, not a modifier (CycleMod_TakeYolo) - never rolled
    // here. The flags the YOLO? screen set are kept: the rosters below honour them.
    usedMask  = 1 << (c_cycleModYolo - 1);
    pickCount = 1;
    while (pickCount <= c_cyclePickTotal) {
        pick = RandomInt(1, c_cycleModCount);
        if ((usedMask & (1 << (pick - 1))) == 0) {
            usedMask = usedMask | (1 << (pick - 1));
            if (pickCount <= c_cyclePicksEach) {
                CycleMod_SetSideMod(true, pick, true);
                g_cycle_chosen[pickCount] = pick;   // keep legacy phase array populated too
            } else {
                CycleMod_SetSideMod(false, pick, true);
            }
            pickCount = pickCount + 1;
        }
    }

    // Random rosters: 6 random pool picks each (no protected core units), or
    // a YOLO deal. RosterDraft_FillYolo works off the picked flags, so reset
    // them the way RosterDraft_Start would.
    pick = 1;
    while (pick <= c_rosterPoolMax) {
        g_roster_p1Picked[pick] = false;  g_roster_p2Picked[pick] = false;
        g_roster_p1Banned[pick] = false;  g_roster_p2Banned[pick] = false;
        pick = pick + 1;
    }
    pick = 1;
    while (pick <= c_rosterMaxSize) {
        g_roster_p1Units[pick] = "";
        g_roster_p2Units[pick] = "";
        pick = pick + 1;
    }
    g_roster_p1PickCount = 0;
    g_roster_p2PickCount = 0;

    if (RosterDraft_IsYolo(true)) {
        RosterDraft_FillYolo(true, g_roster_p1Race);
    } else {
        poolCount = GetRosterPoolCount(g_roster_p1Race);
        usedMask  = 0;
        pickCount = 1;
        while (pickCount <= c_rosterRosterSize) {
            pick = RandomInt(1, poolCount);
            if ((usedMask & (1 << (pick - 1))) == 0) {
                usedMask = usedMask | (1 << (pick - 1));
                g_roster_p1Units[pickCount] = GetRosterPoolUnit(g_roster_p1Race, pick);
                pickCount = pickCount + 1;
            }
        }
        g_roster_p1PickCount = c_rosterRosterSize;
    }

    if (RosterDraft_IsYolo(false)) {
        RosterDraft_FillYolo(false, g_roster_p2Race);
    } else {
        poolCount = GetRosterPoolCount(g_roster_p2Race);
        usedMask  = 0;
        pickCount = 1;
        while (pickCount <= c_rosterRosterSize) {
            pick = RandomInt(1, poolCount);
            if ((usedMask & (1 << (pick - 1))) == 0) {
                usedMask = usedMask | (1 << (pick - 1));
                g_roster_p2Units[pickCount] = GetRosterPoolUnit(g_roster_p2Race, pick);
                pickCount = pickCount + 1;
            }
        }
        g_roster_p2PickCount = c_rosterRosterSize;
    }

    // Tear down the race draft UI and trigger.
    DraftTimer_Disarm();
    if (g_draft_trigger != null) { TriggerDestroy(g_draft_trigger); g_draft_trigger = null; }
    if (g_draft_dialog != c_invalidDialogId) { DialogDestroy(g_draft_dialog); g_draft_dialog = c_invalidDialogId; }

    Debug_Log("AUTO DRAFT: Ban=" + RaceName(banRace) + " P1=" + RaceName(g_draft_p1Race)
        + " P2=" + RaceName(g_draft_p2Race));

    Tardigrade_StartGame();
    return true;
}

//--------------------------------------------------------------------------------------------------
// Callback: unit draft complete -> start the game.
//--------------------------------------------------------------------------------------------------
bool Tardigrade_OnRosterFinished(bool testConds, bool runActions) {
    Tardigrade_StartGame();
    return true;
}

//--------------------------------------------------------------------------------------------------
// Callback: cycle draft complete -> start the unit draft.
//--------------------------------------------------------------------------------------------------
bool Tardigrade_OnCycleFinished(bool testConds, bool runActions) {
    trigger rosterCallback;
    rosterCallback = TriggerCreate("Tardigrade_OnRosterFinished");
    RosterDraft_Start(rosterCallback,
        g_draft_p1, g_draft_p2,
        g_draft_p1Race, g_draft_p2Race);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Callback: race draft complete -> start the cycle-modifier draft.
//--------------------------------------------------------------------------------------------------
bool Tardigrade_OnDraftFinished(bool testConds, bool runActions) {
    trigger cycleCallback;
    cycleCallback = TriggerCreate("Tardigrade_OnCycleFinished");
    CycleMod_StartDraft(cycleCallback, g_draft_p1, g_draft_p2);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Callback: YOLO? decided -> the race draft.
//--------------------------------------------------------------------------------------------------
bool Tardigrade_OnYoloChosen(bool testConds, bool runActions) {
    RaceDraft_ShowDraft(TriggerCreate("Tardigrade_OnDraftFinished"));
    return true;
}

//--------------------------------------------------------------------------------------------------
// Callback: game mode chosen -> the YOLO? screen, or straight into Testing mode.
//--------------------------------------------------------------------------------------------------
bool Tardigrade_OnModeChosen(bool testConds, bool runActions) {
    if (GameMode_IsTesting()) {
        TestingMode_Start();
        return true;
    }
    CycleMod_YoloChoice(TriggerCreate("Tardigrade_OnYoloChosen"), g_draft_p1, g_draft_p2);
    return true;
}

//--------------------------------------------------------------------------------------------------
// Entry point - called from the map-init boot trigger.
//--------------------------------------------------------------------------------------------------
void Tardigrade_Init() {
    Debug_Init();
    if (g_debugLevel > c_debug_None) {
        Debug_SetAutoRunTrigger(TriggerCreate("Tardigrade_DebugAutoRun"));
    }

    // Setup (teams, pause, draft lock), then Mode -> YOLO? -> Race -> Cycle -> Unit -> Game.
    if (!RaceDraft_Setup()) {
        // No human to draft: skip to the next step, as the draft always has.
        TriggerExecute(TriggerCreate("Tardigrade_OnDraftFinished"), false, false);
        return;
    }
    GameMode_Select(g_draft_modeChooser, TriggerCreate("Tardigrade_OnModeChosen"));
}
