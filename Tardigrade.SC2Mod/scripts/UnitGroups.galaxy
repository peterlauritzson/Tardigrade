//--------------------------------------------------------------------------------------------------
// Unit Groups  (the roster option on the setup screen, between Full roster and Alternating draft)
//
// Every unit is allowed (Full roster: no unit draft), the modifier draft is the
// bucket draft, and each side's three non-Command modifiers (its Maneuver,
// Endurance and Firepower picks) each apply to ONE GROUP of that side's units
// only. The Command pick stays global.
//
// This stage runs after the bucket draft and before the summary:
//   1. the side picks one of four SPLITS (presets) of its race's pool units into
//      three groups (Tech / Role / Speed / Cost);
//   2. it gives its three non-Command modifiers to the three groups, one each;
//   3. it locks in.
// Both sides choose at the same time (two human deciders) and cannot see each
// other's choice; it is revealed on the summary screen. One human deciding both
// sides (g_draft_p1 == g_draft_p2, e.g. against the computer) does P1's side, then
// P2's, in sequence - the same rule ProtectDraft uses.
//
// The rule a player can hold in their head: a group modifier only ever touches
// units in its group. Workers, structures and units outside every group (Observer,
// Overseer, Overlord, Changeling, cocoons/eggs, MULE) get no group modifier.
//
// Storage once committed (UnitGroups_Commit):
//   g_ug_modGroup[side][modIdx]  the group (1..3) a side's modifier applies to
//   data table "TG_ug<side>_<unitType>" -> group (1..3), registered for every pool
//   unit of the chosen split AND its alternate forms / spawned units
//   (UnitGroups_Alts); a missing key reads 0 = in no group.
// CycleMod.galaxy forward-declares and calls UnitGroups_Active / _Covers /
// _ModLabel; they are the only things in here the in-game code touches.
//
// Tournament: one clock per step (DraftTimer_ArmFor, c_unitGroupsSeconds); at zero
// every unlocked side of that step is locked in as it stands. YOLO reuses stage
// c_stageRoster (a Full-roster game has no roster stage of its own): pressing it
// rolls a random split and a random assignment and locks in at once.
//
// Requires: DraftStyle, GameMode (DraftTimer), RaceDraft globals, CycleMod,
// RosterDraft (RosterUnitDisplayName, g_roster_p1Race / p2Race).
//--------------------------------------------------------------------------------------------------

const int   c_unitGroupsSeconds = 30;   // Tournament: the clock for the step
const fixed c_unitGroupsGrace   = 2.0;  // real seconds Lock in stays grey at a step's start

const int c_ugPresets = 4;
const int c_ugGroups  = 3;
const int c_ugSlots   = 3;              // non-Command modifiers a side can assign

// State. "side" is 1 for P1, 2 for P2 throughout (arrays are sized 3, [0] unused).
trigger  g_ug_callback = null;
bool     g_ug_done     = false;         // committed: UnitGroups_Active()
int[3]   g_ug_preset;                   // 1..4
bool[3]  g_ug_locked;
int[3]   g_ug_modCount;                 // non-Command mods this side holds (normally 3)
int[3][4] g_ug_slotMod;                 // [side][slot 1..3] modifier index, in bucket order
int[3][4] g_ug_slotGroup;               // [side][slot] the group it is assigned to
int[3][24] g_ug_modGroup;               // [side][modIdx] committed group; 0 = not group-scoped
int[4]   g_ug_perm;                     // scratch for the random assignment

// Steps: two human deciders choose at once (one step); one human deciding both
// sides does P1 then P2 (two steps).
bool     g_ug_simul     = false;
int      g_ug_stepCount = 0;
int      g_ug_step      = 0;            // 1-based; past stepCount = done
trigger  g_ug_autoTrig  = null;
bool     g_ug_graceLocked = false;      // Lock in greyed out: the step just started
int      g_ug_graceToken  = 0;          // which step's grace timer is live

// UI
int      g_ug_dialog    = c_invalidDialogId;
int      g_ug_lblTitle  = c_invalidDialogControlId;
int      g_ug_lblSub    = c_invalidDialogControlId;
int      g_ug_lblInfo   = c_invalidDialogControlId;
int      g_ug_lblCmd    = c_invalidDialogControlId;
int[5]   g_ug_btnPreset;                // [1..4]
int[4]   g_ug_lblCol;                   // [1..3] group columns
int[4][4] g_ug_btnMod;                  // [group column 1..3][slot 1..3]
int      g_ug_btnLock   = c_invalidDialogControlId;
int      g_ug_btnYolo   = c_invalidDialogControlId;
trigger  g_ug_trigger   = null;

//--------------------------------------------------------------------------------------------------
// Preset data
//--------------------------------------------------------------------------------------------------
string UnitGroups_PresetName(int preset) {
    if (preset == 1) { return "Tech"; }
    if (preset == 2) { return "Role"; }
    if (preset == 3) { return "Speed"; }
    return "Cost";
}

string UnitGroups_PresetDesc(int preset) {
    if (preset == 1) { return "Split by where the unit is built."; }
    if (preset == 2) { return "Split by how the unit fights."; }
    if (preset == 3) { return "Split by base move speed, no upgrades."; }
    return "Split by price (minerals + gas).";
}

string UnitGroups_GroupName(int preset, int race, int grp) {
    if (preset == 1) {
        if (race == c_tardigrade_raceTerran) {
            if (grp == 1) { return "Barracks"; }
            if (grp == 2) { return "Factory"; }
            return "Starport";
        }
        if (race == c_tardigrade_raceProtoss) {
            if (grp == 1) { return "Gateway"; }
            if (grp == 2) { return "Robotics"; }
            return "Stargate";
        }
        if (grp == 1) { return "Hatchery"; }
        if (grp == 2) { return "Lair"; }
        return "Hive";
    }
    if (preset == 2) {
        if (race == c_tardigrade_raceTerran) {
            if (grp == 1) { return "Bio"; }
            if (grp == 2) { return "Mech"; }
            return "Energy";
        }
        if (grp == 1) { return "Frontline"; }
        if (grp == 2) { return "Ranged"; }
        return "Energy";
    }
    if (preset == 3) {
        if (grp == 1) { return "Fast"; }
        if (grp == 2) { return "Steady"; }
        return "Slow";
    }
    if (grp == 1) { return "Cheap"; }
    if (grp == 2) { return "Mid"; }
    return "Expensive";
}

string UnitGroups_PresetGroupsText(int preset, int race) {
    return UnitGroups_GroupName(preset, race, 1) + " / " + UnitGroups_GroupName(preset, race, 2)
        + " / " + UnitGroups_GroupName(preset, race, 3);
}

string UnitGroups_GroupColor(int grp) {
    if (grp == 1) { return "7FD0FF"; }
    if (grp == 2) { return "FFD54A"; }
    return "FF9F7F";
}

// The pool units of one group, space-separated (TardigradeRosterConfig ids).
